# The X client first-boot setup starts with xinit when someone chooses to
# upgrade from an old portlin: the Migrate window and nothing else, as root,
# on a bare X server. There is no session and no window manager; the window
# covers the screen itself. Setup reads what it left in /run/portlin/migrate
# once the window closes and xinit returns.

# The desktop's GTK settings, for a window that would otherwise draw in
# GTK's stock theme with no session to tell it otherwise.
export XDG_CONFIG_DIRS=/etc/xdg/xdg-portlin:/etc/xdg

# The layout setup just switched to, which the old drive's passphrase is
# typed with. X took its layout from udev at boot, before setup asked.
if [ -r /etc/default/keyboard ] && command -v setxkbmap >/dev/null 2>&1; then
    . /etc/default/keyboard
    set --
    [ -n "$XKBMODEL" ] && set -- "$@" -model "$XKBMODEL"
    [ -n "$XKBLAYOUT" ] && set -- "$@" -layout "$XKBLAYOUT"
    [ -n "$XKBVARIANT" ] && set -- "$@" -variant "$XKBVARIANT"
    [ -n "$XKBOPTIONS" ] && set -- "$@" -option "$XKBOPTIONS"
    setxkbmap "$@" >/dev/null 2>&1
fi

command -v xsetroot >/dev/null 2>&1 && xsetroot -solid '#12161C' >/dev/null 2>&1

# GApplication registers on a session bus, and nothing has started one.
if command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- /usr/bin/portlin-migration --live
fi
exec /usr/bin/portlin-migration --live
