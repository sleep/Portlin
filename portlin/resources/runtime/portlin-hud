# -- formatting ----------------------------------------------------------------


def format_tokens(count: int | None) -> str:
    if count is None:
        return "--"
    if count < 1000:
        return str(count)
    if count < 1_000_000:
        return f"{count / 1000:.1f}k"
    return f"{count / 1_000_000:.1f}M"


def format_percent(value: float | None) -> str:
    return "--%" if value is None else f"{value:.0f}%"


def format_bytes(count: int | None) -> str:
    return "--" if count is None else hostinfo.format_bytes(count)


def format_speed(mbps: float | None) -> str:
    if mbps is None:
        return ""
    if mbps >= 1000 and mbps % 1000 == 0:
        return f"{int(mbps // 1000)} Gb/s"
    return f"{mbps:g} Mb/s"


def format_since(epoch: float | None, now: float | None = None) -> str:
    if not epoch:
        return "--"
    now = time.time() if now is None else now
    return hud.format_duration(max(0.0, now - epoch))


def fraction(part: int | float | None, whole: int | float | None) -> float | None:
    if part is None or not whole:
        return None
    return max(0.0, min(1.0, part / whole))


def memory_rows(memory: dict | None) -> list[tuple[str, str, int | None]]:
    """The breakdown lines: (label, value, bytes), bytes for the mini bar."""
    if not memory:
        return []
    return [
        ("applications", format_bytes(memory.get("anon")), memory.get("anon")),
        ("file cache", format_bytes(memory.get("page_cache")), memory.get("page_cache")),
        ("buffers", format_bytes(memory.get("buffers")), memory.get("buffers")),
        ("shared", format_bytes(memory.get("shmem")), memory.get("shmem")),
        ("kernel, reclaimable", format_bytes(memory.get("reclaimable")), memory.get("reclaimable")),
        ("free", format_bytes(memory.get("free")), memory.get("free")),
    ]


def interface_summary(interface: dict) -> str:
    """"ethernet, usb, up, 1 Gb/s": the kind, the bus and the link."""
    parts = [interface["kind"]]
    if interface.get("bus"):
        parts.append(interface["bus"])
    parts.append(interface["state"])
    if interface.get("speed_mbps"):
        parts.append(format_speed(interface["speed_mbps"]))
    elif interface.get("bitrate_mbps"):
        parts.append(format_speed(interface["bitrate_mbps"]))
    if interface.get("default"):
        parts.append("default route")
    return ", ".join(parts)


def wifi_summary(interface: dict) -> str:
    if interface.get("kind") != "wifi":
        return ""
    parts = []
    if interface.get("ssid"):
        parts.append(interface["ssid"])
    if interface.get("signal_dbm") is not None:
        parts.append(f"{interface['signal_dbm']} dBm")
    return ", ".join(parts) if parts else "not associated"


def traffic_summary(interface: dict) -> str:
    return (
        f"down {hud.format_rate(interface.get('rx_rate'))}  up {hud.format_rate(interface.get('tx_rate'))}"
        f"  since boot {format_bytes(interface.get('rx_bytes'))} / {format_bytes(interface.get('tx_bytes'))}"
    )


def disk_summary(disk: dict) -> str:
    return (
        f"read {hud.format_rate(disk.get('read_rate'))}  write {hud.format_rate(disk.get('write_rate'))}"
        f"  since boot {format_bytes(disk.get('read_bytes'))} / {format_bytes(disk.get('write_bytes'))}"
    )


def session_tokens(session: dict) -> str:
    return (
        f"in {format_tokens(session.get('input_tokens'))}  out {format_tokens(session.get('output_tokens'))}"
        f"  cached {format_tokens(session.get('cache_read'))}"
    )


def session_context(session: dict) -> str:
    percent = session.get("context_percent")
    window = session.get("context_window")
    if percent is None:
        return "context --"
    return f"context {percent:.0f}% of {format_tokens(window)}"


def session_meta(session: dict, now: float | None = None) -> str:
    parts = []
    if session.get("model"):
        parts.append(session["model"])
    if session.get("turns"):
        parts.append(f"{session['turns']} turns")
    if session.get("started_at"):
        parts.append(f"{format_since(session['started_at'], now)} running")
    if session.get("git_branch"):
        parts.append(f"on {session['git_branch']}")
    if session.get("subagents"):
        active = session.get("subagents_active") or 0
        parts.append(f"{session['subagents']} subagents" + (f", {active} working" if active else ""))
    return ", ".join(parts)


# Where the Claude Code rate limits come from, named when they are missing.
LIMITS_ADVICE = "rate limits need abtop --setup (abtop is on the Software app's AI tools page)"


def session_limits(session: dict, now: float | None = None) -> str:
    """The two rate-limit windows as "5h 29% used, 7d 11% used".

    Codex writes its limits into its own transcript. Claude Code only tells
    its status line, so its figures come from the file abtop's hook keeps,
    with that file's age, and a Claude Code session without the file says
    what would provide it.
    """
    limits = session.get("limits") or {}
    parts = []
    for key in ("primary", "secondary"):
        window = limits.get(key) or {}
        used = window.get("used_percent")
        minutes = window.get("window_minutes")
        if used is None:
            continue
        label = f"{minutes // 60}h" if minutes and minutes < 1440 else (f"{minutes // 1440}d" if minutes else key)
        parts.append(f"{label} {used:.0f}% used")
    if not parts:
        return LIMITS_ADVICE if session.get("agent") == "claude" else ""
    text = ", ".join(parts)
    if limits.get("updated_at"):
        text += f", as of {format_since(limits['updated_at'], now)} ago"
    return text


def status_tone(status: str) -> str:
    if status.startswith(("running", "thinking", "working")):
        return "green"
    if status == "finished":
        return ""
    return "blue"


def agents_headline(snapshot: dict) -> str:
    processes = snapshot.get("processes") or []
    if not processes:
        return "none running"
    names = {process["agent"] for process in processes}
    count = len(processes)
    return f"{count} running" if len(names) != 1 else f"{count} {snapshot['names'].get(next(iter(names)), 'running')}"


def process_summary(process: dict, names: dict) -> str:
    children = ", ".join(process.get("children") or ())
    text = f"{names.get(process['agent'], process['agent'])}, pid {process['pid']}, {format_bytes(process.get('rss_bytes'))}"
    if process.get("cwd"):
        text += f", in {Path(process['cwd']).name or process['cwd']}"
    if children:
        text += f", running {children}"
    return text


# -- sampling ------------------------------------------------------------------


def dpkg_installed() -> set[str]:
    try:
        proc = subprocess.run(
            ["dpkg-query", "-W", "-f=${Package} ${db:Status-Status}\n"],
            capture_output=True, text=True, timeout=30,
        )
    except (OSError, subprocess.SubprocessError):
        return set()
    return {
        fields[0] for fields in (line.split() for line in proc.stdout.splitlines())
        if len(fields) == 2 and fields[1] == "installed"
    }


class Collector:
    """Everything the window shows, gathered off the main thread.

    hud.Sampler keeps the counters between calls; the agents cache keeps the
    transcript offsets. A full sample forks lsblk once, then ip and the
    occasional nvidia-smi and iw, which is why it runs in a thread: a
    window that stops redrawing while a sleeping GPU wakes is a window
    that looks broken.
    """

    def __init__(self, *, lookup_public: bool = True) -> None:
        self.sampler = hud.Sampler()
        self.sampler.lookup_public = lookup_public
        self.cache: dict = {}
        self.installed: set[str] | None = None

    def snapshot(self) -> dict:
        if self.installed is None:
            self.installed = dpkg_installed()
        snapshot = self.sampler.sample()
        snapshot["agents"] = agents.collect(cache=self.cache, dpkg_installed=self.installed)
        return snapshot


def print_json(collector: Collector, *, settle: float = 1.0) -> int:
    """Two samples a second apart, so the rates and CPU figure are real."""
    collector.snapshot()
    time.sleep(settle)
    print(json.dumps(collector.snapshot(), indent=2, sort_keys=True))
    return 0


# -- the window ----------------------------------------------------------------


def run_window(*, interval: int, fullscreen: bool, lookup_public: bool) -> int:
    import gi

    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, GLib, Gtk, Pango

    def label(text: str = "", *classes: str, xalign: float = 0.0, wrap: bool = False, ellipsize: bool = False) -> Gtk.Label:
        widget = Gtk.Label(label=text, xalign=xalign)
        if wrap:
            widget.set_line_wrap(True)
            widget.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        if ellipsize:
            widget.set_ellipsize(Pango.EllipsizeMode.END)
        if wrap or ellipsize:
            # A label's natural width is its whole text on one line, and the
            # flow box lays cards out by natural width: one device path too
            # long and every card is a row to itself.
            widget.set_max_width_chars(LABEL_WIDTH_CHARS)
        for name in classes:
            widget.get_style_context().add_class(name)
        return widget

    def set_bar(bar: Gtk.ProgressBar, value: float | None) -> None:
        bar.set_fraction(value or 0.0)
        context = bar.get_style_context()
        if value is not None and value >= WARN_FRACTION:
            context.add_class("warn")
        else:
            context.remove_class("warn")

    class Card(Gtk.Box):
        """One panel: a section name, a headline figure, and rows under it.

        Rows are kept by key and updated in place, so a refresh changes
        text and bar lengths and never rebuilds a widget tree; the lists
        whose membership changes (filesystems, links, sessions) are rebuilt
        only when their keys do.
        """

        def __init__(self, title: str) -> None:
            super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            self.get_style_context().add_class("card")
            header = Gtk.Box(spacing=8)
            header.pack_start(label(title.upper(), "section"), True, True, 0)
            self.headline = label("", "headline", "mono", xalign=1.0)
            header.pack_end(self.headline, False, False, 0)
            self.pack_start(header, False, False, 0)
            self.body = Gtk.Grid(column_spacing=12, row_spacing=4)
            self.pack_start(self.body, True, True, 0)
            self.widgets: dict[str, Gtk.Widget] = {}
            self.keys: tuple | None = None
            self._rows = 0

        def clear(self) -> None:
            for child in self.body.get_children():
                self.body.remove(child)
            self.widgets = {}
            self._rows = 0

        def add_row(self, key: str, name: str, *, mono: bool = True) -> Gtk.Label:
            title = label(name, "muted", "small", xalign=1.0)
            self.body.attach(title, 0, self._rows, 1, 1)
            value = label("", *(["mono"] if mono else []), ellipsize=True)
            value.set_hexpand(True)
            self.body.attach(value, 1, self._rows, 1, 1)
            self.widgets[key] = value
            self.widgets[f"{key}:name"] = title
            self._rows += 1
            return value

        def add_text(self, key: str, *classes: str, wrap: bool = False) -> Gtk.Label:
            value = label("", *classes, wrap=wrap, ellipsize=not wrap)
            value.set_hexpand(True)
            self.body.attach(value, 0, self._rows, 2, 1)
            self.widgets[key] = value
            self._rows += 1
            return value

        def add_bar(self, key: str, *, thin: bool = False) -> Gtk.ProgressBar:
            bar = Gtk.ProgressBar()
            bar.set_hexpand(True)
            if thin:
                bar.get_style_context().add_class("thin")
            self.body.attach(bar, 0, self._rows, 2, 1)
            self.widgets[key] = bar
            self._rows += 1
            return bar

        def add_widget(self, key: str, widget: Gtk.Widget) -> None:
            widget.set_hexpand(True)
            self.body.attach(widget, 0, self._rows, 2, 1)
            self.widgets[key] = widget
            self._rows += 1

        def add_gap(self) -> None:
            self.body.attach(Gtk.Separator(), 0, self._rows, 2, 1)
            self._rows += 1

        def text(self, key: str, value: str) -> None:
            """Set a value, and take the whole row away when there is none:
            a battery row on a desktop is a label with nothing after it."""
            widget = self.widgets.get(key)
            if widget is None:
                return
            widget.set_text(value)
            widget.set_visible(bool(value))
            title = self.widgets.get(f"{key}:name")
            if title is not None:
                title.set_visible(bool(value))

        def bar(self, key: str, value: float | None) -> None:
            widget = self.widgets.get(key)
            if widget is not None:
                set_bar(widget, value)

        def rebuild_if(self, keys: tuple, build) -> None:
            if keys != self.keys:
                self.clear()
                self.keys = keys
                build()
                self.body.show_all()

    def badge(text: str, tone: str = "") -> Gtk.Label:
        widget = label(text, "badge", *([tone] if tone else []))
        widget.set_valign(Gtk.Align.CENTER)
        return widget

    class HudWindow(Gtk.ApplicationWindow):
        def __init__(self, application, collector: Collector, *, interval: int) -> None:
            super().__init__(application=application, title="HUD")
            self.collector = collector
            self.interval = interval
            self.set_default_size(1280, 800)
            self.get_style_context().add_class("hud")
            self._stop = threading.Event()
            self._cards: dict[str, Card] = {}

            self.header = Gtk.HeaderBar(show_close_button=True)
            self.header.set_title("HUD")
            self.header.set_subtitle("")
            self.clock = label("", "mono", "muted")
            self.header.pack_end(self.clock)
            self.fullscreen_button = Gtk.Button.new_from_icon_name("view-fullscreen-symbolic", Gtk.IconSize.BUTTON)
            self.fullscreen_button.set_tooltip_text("Full screen (F11). Esc leaves it.")
            self.fullscreen_button.connect("clicked", lambda *_: self.toggle_fullscreen())
            self.header.pack_end(self.fullscreen_button)
            self.set_titlebar(self.header)

            scroller = Gtk.ScrolledWindow()
            scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            self.grid = Gtk.Grid(column_spacing=12, row_spacing=12, column_homogeneous=True)
            for side in ("top", "bottom", "start", "end"):
                getattr(self.grid, f"set_margin_{side}")(12)
            self.grid.set_valign(Gtk.Align.START)
            scroller.add(self.grid)
            self.add(scroller)

            for key, title in CARD_ORDER:
                card = Card(title)
                card.set_valign(Gtk.Align.START)
                card.set_hexpand(True)
                self._cards[key] = card
            self.columns = 0
            self._place_cards(1)
            scroller.connect("size-allocate", self._on_resize)

            self._build_static()
            self.connect("key-press-event", self._on_key)
            self.connect("window-state-event", self._on_state)
            self.connect("destroy", lambda *_: self._stop.set())
            self.is_fullscreen = False
            if fullscreen:
                self.fullscreen()
            threading.Thread(target=self._collect, name="portlin-hud-collector", daemon=True).start()
            GLib.timeout_add_seconds(1, self._tick_clock)

        def _on_resize(self, _widget, allocation) -> None:
            columns = max(1, min(len(CARD_ORDER), (allocation.width - 24) // CARD_MIN_WIDTH))
            if columns != self.columns:
                # Not from inside size-allocate: moving children there
                # queues another allocation of the thing being allocated.
                GLib.idle_add(self._place_cards, columns)

        def _place_cards(self, columns: int) -> bool:
            if columns == self.columns:
                return False
            self.columns = columns
            for child in self.grid.get_children():
                self.grid.remove(child)
            for index, (key, _) in enumerate(CARD_ORDER):
                self.grid.attach(self._cards[key], index % columns, index // columns, 1, 1)
            self.grid.show_all()
            return False

        # -- static cards, built once --

        def _build_static(self) -> None:
            system = self._cards["system"]
            for key, name in (("model", "machine"), ("cpu", "processor"), ("memory", "memory"),
                              ("graphics", "graphics"), ("firmware", "firmware"), ("kernel", "kernel"),
                              ("hostname", "hostname"), ("session", "session"), ("up", "up"),
                              ("load", "load"), ("battery", "battery")):
                system.add_row(key, name)
            release = self._cards["release"]
            for key, name in (("portlin", "portlin"), ("debian", "debian"), ("root", "root"),
                              ("drive", "drive"), ("packages", "packages")):
                release.add_row(key, name)
            release.add_text("advice", "amber", "small", wrap=True)
            cpu = self._cards["cpu"]
            cpu.add_bar("total")
            cpu.add_widget("cores", Gtk.Grid(column_spacing=6, row_spacing=3))
            for key, name in (("clock", "clock"), ("temperature", "temperature"), ("load", "load")):
                cpu.add_row(key, name)
            memory = self._cards["memory"]
            memory.add_bar("used")
            for name, _, _ in memory_rows({"anon": 0}):
                memory.add_row(name, name)
                memory.add_bar(f"{name}-bar", thin=True)
            memory.add_gap()
            memory.add_row("swap", "swap")
            memory.add_text("zram", "muted", "small", wrap=True)
            gpu = self._cards["gpu"]
            for key, name in (("name", "card"), ("usage", "usage"), ("vram", "memory"),
                              ("temperature", "temperature"), ("power", "power")):
                gpu.add_row(key, name)
            gpu.add_bar("vram-bar", thin=True)
            gpu.add_text("none", "muted", wrap=True)
            addresses = self._cards["addresses"]
            for key, name in (("private", "private"), ("public", "public"), ("route", "route")):
                addresses.add_row(key, name)
            addresses.add_text("note", "muted", "small", wrap=True)
            self.show_all()

        # -- refresh --

        def _collect(self) -> None:
            while not self._stop.is_set():
                started = time.monotonic()
                try:
                    snapshot = self.collector.snapshot()
                except Exception as error:  # a reader that raises must not end the loop
                    snapshot = {"error": f"{type(error).__name__}: {error}"}
                if not self._stop.is_set():
                    GLib.idle_add(self._apply, snapshot)
                self._stop.wait(max(0.5, self.interval - (time.monotonic() - started)))

        def _tick_clock(self) -> bool:
            self.clock.set_text(time.strftime("%a %d %b  %H:%M:%S"))
            return True

        def _apply(self, snapshot: dict) -> bool:
            # A snapshot posted just before the window closed lands on
            # widgets that no longer exist.
            if self._stop.is_set():
                return False
            if "error" in snapshot:
                self.header.set_subtitle(snapshot["error"])
                return False
            now = snapshot.get("sampled_at") or time.time()
            self._apply_system(snapshot)
            self._apply_release(snapshot.get("release") or {})
            self._apply_cpu(snapshot)
            self._apply_memory(snapshot.get("memory"))
            self._apply_gpu(snapshot.get("gpu"))
            self._apply_addresses(snapshot.get("addresses") or {})
            self._apply_storage(snapshot)
            self._apply_network(snapshot.get("interfaces") or [])
            self._apply_agents(snapshot.get("agents") or {}, now)
            return False

        def _apply_system(self, snapshot: dict) -> None:
            host = snapshot.get("host") or {}
            card = self._cards["system"]
            card.headline.set_text(host.get("hostname") or "")
            self.header.set_subtitle(", ".join(part for part in (host.get("hostname"), host.get("model")) if part))
            card.text("model", host.get("model") or "not named by the firmware")
            threads = host.get("threads")
            card.text("cpu", f"{host.get('cpu') or '--'}" + (f", {threads} threads" if threads else ""))
            card.text("memory", format_bytes(host.get("memory_bytes") or None))
            gpu = snapshot.get("gpu") or {}
            card.text("graphics", gpu.get("name") or gpu.get("detail") or "none reported")
            card.text("firmware", host.get("firmware") or "--")
            card.text("kernel", host.get("kernel") or "--")
            card.text("hostname", host.get("hostname") or "--")
            session = ", ".join(part for part in (host.get("user"), host.get("session"), host.get("session_type")) if part)
            card.text("session", session or "--")
            card.text("up", hud.format_duration(host.get("uptime_seconds")))
            load = host.get("load")
            card.text("load", "  ".join(f"{value:.2f}" for value in load) if load else "--")
            battery = host.get("battery")
            card.text("battery", f"{battery['percent']}%{', charging' if battery.get('charging') else ''}" if battery else "")

        def _apply_release(self, release: dict) -> None:
            card = self._cards["release"]
            version = release.get("version") or "unknown"
            card.headline.set_text(version)
            commit = release.get("commit")
            card.text("portlin", f"{version} ({commit})" if commit else version)
            card.text("debian", release.get("debian") or "--")
            root = release.get("root") or "--"
            card.text("root", f"{root}, luks" if release.get("encrypted") else root)
            widget = card.widgets["root"]
            if release.get("encrypted"):
                widget.set_markup(f'{GLib.markup_escape_text(root)}, <span foreground="{ACCENT}">luks</span>')
            drive = release.get("drive") or "--"
            if release.get("drive_bytes"):
                drive += f", {format_bytes(release['drive_bytes'])}"
            card.text("drive", drive)
            packages = ", ".join(
                f"{name} {version}" for name, version in (
                    ("portlin-runtime", release.get("runtime_version")),
                    ("portlin-desktop", release.get("desktop_version")),
                ) if version
            )
            card.text("packages", packages or "not installed from packages")
            card.text("advice", release.get("advice") or "")

        def _apply_cpu(self, snapshot: dict) -> None:
            cpu = snapshot.get("cpu") or {}
            card = self._cards["cpu"]
            card.headline.set_text(format_percent(cpu.get("percent")))
            card.bar("total", fraction(cpu.get("percent"), 100))
            cores = cpu.get("cores") or []
            grid = card.widgets["cores"]
            if len(grid.get_children()) != len(cores):
                for child in grid.get_children():
                    grid.remove(child)
                columns = 4 if len(cores) <= 16 else 8
                for index in range(len(cores)):
                    bar = Gtk.ProgressBar()
                    bar.set_hexpand(True)
                    bar.get_style_context().add_class("thin")
                    bar.set_tooltip_text(f"core {index}")
                    grid.attach(bar, index % columns, index // columns, 1, 1)
                grid.show_all()
            for bar, busy in zip(grid.get_children()[::-1], cores):
                set_bar(bar, fraction(busy, 100))
            card.text("clock", f"{cpu['mhz']} MHz" if cpu.get("mhz") else "--")
            card.text("temperature", f"{cpu['temperature_c']} C" if cpu.get("temperature_c") is not None else "no sensor")
            load = (snapshot.get("host") or {}).get("load")
            card.text("load", "  ".join(f"{value:.2f}" for value in load) if load else "--")

        def _apply_memory(self, memory: dict | None) -> None:
            card = self._cards["memory"]
            if not memory:
                card.headline.set_text("--")
                return
            total = memory.get("total") or 0
            card.headline.set_text(f"{format_bytes(memory.get('used'))} / {format_bytes(total)}")
            card.bar("used", fraction(memory.get("used"), total))
            for name, value, count in memory_rows(memory):
                card.text(name, value)
                widget = card.widgets.get(f"{name}-bar")
                if widget is not None:
                    widget.set_fraction(fraction(count, total) or 0.0)
            if memory.get("swap_total"):
                card.text("swap", f"{format_bytes(memory.get('swap_used'))} / {format_bytes(memory['swap_total'])}")
            else:
                card.text("swap", "none")
            zram = memory.get("zram") or []
            card.text("zram", "  ".join(
                f"{device['name']}: {format_bytes(device['original'])} of {format_bytes(device['disksize'])} stored in "
                f"{format_bytes(device['memory_used'])} of memory"
                for device in zram
            ))

        def _apply_gpu(self, gpu: dict | None) -> None:
            card = self._cards["gpu"]
            if not gpu:
                card.headline.set_text("")
                for key in ("name", "usage", "vram", "temperature", "power"):
                    card.text(key, "")
                card.bar("vram-bar", None)
                card.widgets["vram-bar"].set_visible(False)
                card.text("none", "No graphics card reported by the kernel.")
                return
            card.text("none", "")
            card.headline.set_text(gpu.get("label") or "")
            card.text("name", gpu.get("name") or gpu.get("detail") or "--")
            kind = gpu.get("kind")
            if kind == "percent":
                card.text("usage", f"{gpu.get('value')}% busy")
            elif kind == "frequency":
                card.text("usage", f"{gpu.get('value')} MHz clock, no utilisation counter")
            else:
                card.text("usage", "no utilisation counter")
            used, total = gpu.get("memory_used"), gpu.get("memory_total")
            card.text("vram", f"{format_bytes(used)} / {format_bytes(total)}" if total else "")
            card.widgets["vram-bar"].set_visible(bool(total))
            card.bar("vram-bar", fraction(used, total))
            card.text("temperature", f"{gpu['temperature_c']} C" if gpu.get("temperature_c") is not None else "")
            card.text("power", f"{gpu['power_w']} W" if gpu.get("power_w") is not None else "")

        def _apply_addresses(self, addresses: dict) -> None:
            card = self._cards["addresses"]
            private = addresses.get("private") or "none"
            card.headline.set_text(private if private != "none" else "offline")
            card.text("private", private)
            public = addresses.get("public")
            state = addresses.get("public_state") or ""
            card.text("public", public or {
                "asking": "asking...", "no route": "no route to the internet",
                "no answer": "no answer", "off": "not asked", "not asked": "--",
            }.get(state, "--"))
            card.text("route", addresses.get("default_interface") or "no default route")
            source = addresses.get("public_source") or ""
            card.text("note", f"The public address is what {source.split('//')[-1]} sees this machine as." if source and state != "off" else "")

        def _apply_storage(self, snapshot: dict) -> None:
            card = self._cards["storage"]
            filesystems = snapshot.get("filesystems") or []
            disks = snapshot.get("disks") or []
            keys = tuple(fs["mountpoint"] for fs in filesystems) + tuple(disk["name"] for disk in disks)

            def build() -> None:
                for fs in filesystems:
                    card.add_text(f"fs-{fs['mountpoint']}-title", "row-title")
                    card.add_text(f"fs-{fs['mountpoint']}-detail", "muted", "small", "mono")
                    card.add_bar(f"fs-{fs['mountpoint']}-bar", thin=True)
                if filesystems and disks:
                    card.add_gap()
                for disk in disks:
                    card.add_text(f"disk-{disk['name']}-title", "row-title")
                    card.add_text(f"disk-{disk['name']}-detail", "muted", "small", "mono")
                if not filesystems and not disks:
                    card.add_text("none", "muted")

            card.rebuild_if(keys, build)
            root_fs = next((fs for fs in filesystems if fs["mountpoint"] == "/"), None)
            card.headline.set_text(
                f"{format_bytes(root_fs['used_bytes'])} / {format_bytes(root_fs['total_bytes'])}" if root_fs else ""
            )
            for fs in filesystems:
                card.text(f"fs-{fs['mountpoint']}-title",
                          f"{fs['mountpoint']}  {format_bytes(fs['used_bytes'])} / {format_bytes(fs['total_bytes'])}")
                card.text(f"fs-{fs['mountpoint']}-detail", f"{fs['source']}, {fs['fstype']}")
                card.bar(f"fs-{fs['mountpoint']}-bar", fraction(fs["used_bytes"], fs["total_bytes"]))
            for disk in disks:
                card.text(f"disk-{disk['name']}-title", disk["name"])
                card.text(f"disk-{disk['name']}-detail", disk_summary(disk))
            card.text("none", "No block devices reported.")

        def _apply_network(self, interfaces: list[dict]) -> None:
            card = self._cards["network"]
            keys = tuple(interface["name"] for interface in interfaces)

            def build() -> None:
                for interface in interfaces:
                    row = Gtk.Box(spacing=8)
                    row.pack_start(label(interface["name"], "row-title", "mono"), False, False, 0)
                    row.pack_start(badge(interface["kind"], "blue" if interface.get("default") else ""), False, False, 0)
                    card.add_widget(f"if-{interface['name']}-row", row)
                    card.add_text(f"if-{interface['name']}-summary", "small", "muted")
                    card.add_text(f"if-{interface['name']}-addresses", "mono", "small")
                    card.add_text(f"if-{interface['name']}-wifi", "small", "muted")
                    card.add_text(f"if-{interface['name']}-traffic", "mono", "small")
                if not interfaces:
                    card.add_text("none", "muted")

            card.rebuild_if(keys, build)
            up = [interface for interface in interfaces if interface["state"] == "up"]
            default = next((interface for interface in interfaces if interface.get("default")), None)
            card.headline.set_text(
                f"{hud.format_rate(default.get('rx_rate'))} down" if default else (f"{len(up)} up" if up else "")
            )
            for interface in interfaces:
                name = interface["name"]
                card.text(f"if-{name}-summary", interface_summary(interface))
                card.text(f"if-{name}-addresses", "  ".join(interface.get("addresses") or ()))
                card.text(f"if-{name}-wifi", wifi_summary(interface))
                card.text(f"if-{name}-traffic", traffic_summary(interface))
            card.text("none", "No network links.")

        def _apply_agents(self, snapshot: dict, now: float) -> None:
            card = self._cards["agents"]
            sessions = snapshot.get("sessions") or []
            unmatched = snapshot.get("unmatched") or []
            installed = snapshot.get("installed") or []
            names = snapshot.get("names") or {}
            keys = (
                tuple((session["agent"], session["pid"], session["cwd"]) for session in sessions),
                tuple(process["pid"] for process in unmatched),
                bool(installed),
            )

            def build() -> None:
                for index, session in enumerate(sessions):
                    key = f"s{index}"
                    row = Gtk.Box(spacing=8)
                    row.pack_start(badge(names.get(session["agent"], session["agent"]), "blue"), False, False, 0)
                    row.pack_start(label(session["project"], "row-title", ellipsize=True), False, False, 0)
                    status = label("", "small")
                    row.pack_end(status, False, False, 0)
                    card.widgets[f"{key}-status"] = status
                    card.add_widget(f"{key}-row", row)
                    card.add_text(f"{key}-title", "muted", "small")
                    card.add_text(f"{key}-task", "mono", "small")
                    card.add_text(f"{key}-context", "small")
                    card.add_bar(f"{key}-bar", thin=True)
                    card.add_text(f"{key}-tokens", "mono", "small", "muted")
                    card.add_text(f"{key}-meta", "small", "muted", wrap=True)
                    card.add_text(f"{key}-limits", "small", "muted")
                if sessions and unmatched:
                    card.add_gap()
                for index, process in enumerate(unmatched):
                    card.add_text(f"p{index}", "small", wrap=True)
                if not sessions and not unmatched:
                    card.add_text("none", "muted")
                if installed:
                    card.add_gap()
                    card.add_text("installed", "small", "muted", wrap=True)

            card.rebuild_if(keys, build)
            card.headline.set_text(agents_headline(snapshot))
            for index, session in enumerate(sessions):
                key = f"s{index}"
                status = card.widgets[f"{key}-status"]
                status.set_text(session.get("status") or "")
                context = status.get_style_context()
                for tone in ("green", "blue"):
                    context.remove_class(tone)
                if status_tone(session.get("status") or ""):
                    context.add_class(status_tone(session["status"]))
                card.text(f"{key}-title", session.get("title") or "")
                card.text(f"{key}-task", session.get("task") or "")
                card.text(f"{key}-context", session_context(session))
                percent = session.get("context_percent")
                card.widgets[f"{key}-bar"].set_visible(percent is not None)
                card.bar(f"{key}-bar", fraction(percent, 100))
                card.text(f"{key}-tokens", session_tokens(session))
                card.text(f"{key}-meta", session_meta(session, now))
                card.text(f"{key}-limits", session_limits(session, now))
            for index, process in enumerate(unmatched):
                card.text(f"p{index}", process_summary(process, names))
            card.text("none", "No AI agents running.")
            card.text("installed", f"Installed: {', '.join(installed)}" if installed else "")

        # -- full screen --

        def toggle_fullscreen(self) -> None:
            if self.is_fullscreen:
                self.unfullscreen()
            else:
                self.fullscreen()

        def _on_state(self, _widget, event) -> bool:
            self.is_fullscreen = bool(event.new_window_state & Gdk.WindowState.FULLSCREEN)
            # A kiosk has no title bar and no pointer: the screen is the page.
            self.header.set_visible(not self.is_fullscreen)
            window = self.get_window()
            if window is not None:
                cursor = Gdk.Cursor.new_from_name(window.get_display(), "none") if self.is_fullscreen else None
                window.set_cursor(cursor)
            return False

        def _on_key(self, _widget, event) -> bool:
            key = Gdk.keyval_name(event.keyval) or ""
            control = bool(event.state & Gdk.ModifierType.CONTROL_MASK)
            if key == "F11" or (key in ("f", "F") and not control):
                self.toggle_fullscreen()
                return True
            if key == "Escape" and self.is_fullscreen:
                self.unfullscreen()
                return True
            if key in ("q", "Q") or (key == "w" and control):
                self.destroy()
                return True
            return False

    def install_css() -> None:
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    application = Gtk.Application(application_id=APP_ID)
    windows: dict[str, HudWindow] = {}

    def on_activate(app) -> None:
        if "window" in windows:
            windows["window"].present()
            return
        Gtk.Window.set_default_icon_name(ICON_NAME)
        install_css()
        collector = Collector(lookup_public=lookup_public)
        window = windows["window"] = HudWindow(app, collector, interval=interval)
        window.show_all()

    application.connect("activate", on_activate)
    return application.run([sys.argv[0]])


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="portlin-hud", description="What this machine is, and what it is doing.")
    parser.add_argument("--json", action="store_true", help="print one snapshot as JSON and exit")
    parser.add_argument("--fullscreen", "-f", action="store_true", help="open full screen, as a kiosk")
    parser.add_argument("--interval", type=int, default=DEFAULT_INTERVAL, metavar="SECONDS",
                        help=f"refresh every this many seconds (default {DEFAULT_INTERVAL})")
    parser.add_argument("--no-public", action="store_true",
                        help=f"never ask {hud.PUBLIC_ADDRESS_URL} for the public address")
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    if args.json:
        return print_json(Collector(lookup_public=not args.no_public))
    return run_window(interval=max(1, args.interval), fullscreen=args.fullscreen,
                      lookup_public=not args.no_public)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
