DEFAULT_INTERVAL = 2

# The cards, in reading order. The screen lays them out in as many columns
# of at least CARD_MIN_WIDTH as fit, so an 80 column terminal gets two and
# a wide one three or more.
CARD_ORDER = (
    ("system", "System"), ("release", "Release"), ("cpu", "CPU"),
    ("memory", "Memory"), ("gpu", "Graphics"), ("addresses", "Addresses"),
    ("storage", "Storage"), ("network", "Network"), ("agents", "AI agents"),
)
CARD_MIN_WIDTH = 38
GUTTER = 2

# Wide enough for the longest row name, "temperature".
NAME_WIDTH = 11

# A bar past this fraction is drawn amber: the point at which a full disk,
# a full memory or a full context is about to be somebody's problem.
WARN_FRACTION = 0.85

# The terminal palette's green, blue and amber, and the brand crimson, as
# the nearest xterm-256 entries. The crimson is reserved for encryption: the
# one place it appears here is the word "luks" beside an encrypted root, as
# in the panel readout. Eight-colour terminals, the Linux console among
# them, get the plain ANSI colours.
PALETTE_256 = {"muted": 103, "green": 72, "blue": 74, "amber": 179, "accent": 197}
PALETTE_8 = {"muted": curses.COLOR_WHITE, "green": curses.COLOR_GREEN, "blue": curses.COLOR_CYAN,
             "amber": curses.COLOR_YELLOW, "accent": curses.COLOR_RED}

GLYPHS_UTF8 = {"full": "█", "empty": "░", "more": "…", "up": "↑", "down": "↓"}
GLYPHS_ASCII = {"full": "#", "empty": "-", "more": "~", "up": "^", "down": "v"}


# -- formatting ----------------------------------------------------------------


def format_tokens(count: int | None) -> str:
    if count is None:
        return "--"
    if count < 1000:
        return str(count)
    if count < 1_000_000:
        return f"{count / 1000:.1f}k"
    return f"{count / 1_000_000:.1f}M"


def format_percent(value: float | None) -> str:
    return "--%" if value is None else f"{value:.0f}%"


def format_bytes(count: int | None) -> str:
    return "--" if count is None else hostinfo.format_bytes(count)


def format_speed(mbps: float | None) -> str:
    if mbps is None:
        return ""
    if mbps >= 1000 and mbps % 1000 == 0:
        return f"{int(mbps // 1000)} Gb/s"
    return f"{mbps:g} Mb/s"


def format_since(epoch: float | None, now: float | None = None) -> str:
    if not epoch:
        return "--"
    now = time.time() if now is None else now
    return hud.format_duration(max(0.0, now - epoch))


def fraction(part: int | float | None, whole: int | float | None) -> float | None:
    if part is None or not whole:
        return None
    return max(0.0, min(1.0, part / whole))


def memory_rows(memory: dict | None) -> list[tuple[str, str, int | None]]:
    """The breakdown lines: (label, value, bytes), bytes for the mini bar."""
    if not memory:
        return []
    return [
        ("applications", format_bytes(memory.get("anon")), memory.get("anon")),
        ("file cache", format_bytes(memory.get("page_cache")), memory.get("page_cache")),
        ("buffers", format_bytes(memory.get("buffers")), memory.get("buffers")),
        ("shared", format_bytes(memory.get("shmem")), memory.get("shmem")),
        ("kernel, reclaimable", format_bytes(memory.get("reclaimable")), memory.get("reclaimable")),
        ("free", format_bytes(memory.get("free")), memory.get("free")),
    ]


def interface_summary(interface: dict) -> str:
    """"ethernet, usb, up, 1 Gb/s": the kind, the bus and the link."""
    parts = [interface["kind"]]
    if interface.get("bus"):
        parts.append(interface["bus"])
    parts.append(interface["state"])
    if interface.get("speed_mbps"):
        parts.append(format_speed(interface["speed_mbps"]))
    elif interface.get("bitrate_mbps"):
        parts.append(format_speed(interface["bitrate_mbps"]))
    if interface.get("default"):
        parts.append("default route")
    return ", ".join(parts)


def wifi_summary(interface: dict) -> str:
    if interface.get("kind") != "wifi":
        return ""
    parts = []
    if interface.get("ssid"):
        parts.append(interface["ssid"])
    if interface.get("signal_dbm") is not None:
        parts.append(f"{interface['signal_dbm']} dBm")
    return ", ".join(parts) if parts else "not associated"


def traffic_summary(interface: dict) -> str:
    return (
        f"down {hud.format_rate(interface.get('rx_rate'))}  up {hud.format_rate(interface.get('tx_rate'))}"
        f"  since boot {format_bytes(interface.get('rx_bytes'))} / {format_bytes(interface.get('tx_bytes'))}"
    )


def disk_summary(disk: dict) -> str:
    return (
        f"read {hud.format_rate(disk.get('read_rate'))}  write {hud.format_rate(disk.get('write_rate'))}"
        f"  since boot {format_bytes(disk.get('read_bytes'))} / {format_bytes(disk.get('write_bytes'))}"
    )


def session_tokens(session: dict) -> str:
    return (
        f"in {format_tokens(session.get('input_tokens'))}  out {format_tokens(session.get('output_tokens'))}"
        f"  cached {format_tokens(session.get('cache_read'))}"
    )


def session_context(session: dict) -> str:
    percent = session.get("context_percent")
    window = session.get("context_window")
    if percent is None:
        return "context --"
    return f"context {percent:.0f}% of {format_tokens(window)}"


def session_meta(session: dict, now: float | None = None) -> str:
    parts = []
    if session.get("model"):
        parts.append(session["model"])
    if session.get("turns"):
        parts.append(f"{session['turns']} turns")
    if session.get("started_at"):
        parts.append(f"{format_since(session['started_at'], now)} running")
    if session.get("git_branch"):
        parts.append(f"on {session['git_branch']}")
    if session.get("subagents"):
        active = session.get("subagents_active") or 0
        parts.append(f"{session['subagents']} subagents" + (f", {active} working" if active else ""))
    return ", ".join(parts)


# Where the Claude Code rate limits come from, named when they are missing.
LIMITS_ADVICE = "rate limits need abtop --setup (abtop is on the Software app's AI tools page)"


def session_limits(session: dict, now: float | None = None) -> str:
    """The two rate-limit windows as "5h 29% used, 7d 11% used".

    Codex writes its limits into its own transcript. Claude Code only tells
    its status line, so its figures come from the file abtop's hook keeps,
    with that file's age, and a Claude Code session without the file says
    what would provide it.
    """
    limits = session.get("limits") or {}
    parts = []
    for key in ("primary", "secondary"):
        window = limits.get(key) or {}
        used = window.get("used_percent")
        minutes = window.get("window_minutes")
        if used is None:
            continue
        label = f"{minutes // 60}h" if minutes and minutes < 1440 else (f"{minutes // 1440}d" if minutes else key)
        parts.append(f"{label} {used:.0f}% used")
    if not parts:
        return LIMITS_ADVICE if session.get("agent") == "claude" else ""
    text = ", ".join(parts)
    if limits.get("updated_at"):
        text += f", as of {format_since(limits['updated_at'], now)} ago"
    return text


def status_tone(status: str) -> str:
    if status.startswith(("running", "thinking", "working")):
        return "green"
    if status == "finished":
        return ""
    return "blue"


def agents_headline(snapshot: dict) -> str:
    processes = snapshot.get("processes") or []
    if not processes:
        return "none running"
    names = {process["agent"] for process in processes}
    count = len(processes)
    return f"{count} running" if len(names) != 1 else f"{count} {snapshot['names'].get(next(iter(names)), 'running')}"


def process_summary(process: dict, names: dict) -> str:
    children = ", ".join(process.get("children") or ())
    text = f"{names.get(process['agent'], process['agent'])}, pid {process['pid']}, {format_bytes(process.get('rss_bytes'))}"
    if process.get("cwd"):
        text += f", in {Path(process['cwd']).name or process['cwd']}"
    if children:
        text += f", running {children}"
    return text


# -- sampling ------------------------------------------------------------------


def dpkg_installed() -> set[str]:
    try:
        proc = subprocess.run(
            ["dpkg-query", "-W", "-f=${Package} ${db:Status-Status}\n"],
            capture_output=True, text=True, timeout=30,
        )
    except (OSError, subprocess.SubprocessError):
        return set()
    return {
        fields[0] for fields in (line.split() for line in proc.stdout.splitlines())
        if len(fields) == 2 and fields[1] == "installed"
    }


class Collector:
    """Everything the screen shows.

    hud.Sampler keeps the counters between calls; the agents cache keeps the
    transcript offsets. A full sample forks lsblk once, then ip and the
    occasional nvidia-smi and iw, which is why the screen calls it from a
    thread of its own.
    """

    def __init__(self, *, lookup_public: bool = True) -> None:
        self.sampler = hud.Sampler()
        self.sampler.lookup_public = lookup_public
        self.cache: dict = {}
        self.installed: set[str] | None = None

    def snapshot(self) -> dict:
        if self.installed is None:
            self.installed = dpkg_installed()
        snapshot = self.sampler.sample()
        snapshot["agents"] = agents.collect(cache=self.cache, dpkg_installed=self.installed)
        return snapshot


def print_json(collector: Collector, *, settle: float = 1.0) -> int:
    """Two samples a second apart, so the rates and CPU figure are real."""
    collector.snapshot()
    time.sleep(settle)
    print(json.dumps(collector.snapshot(), indent=2, sort_keys=True))
    return 0


# -- the cards -----------------------------------------------------------------

# A line is a run of (text, role) segments; the roles are what the terminal
# loop turns into colours, so everything up to that point is plain text and
# can be checked without a terminal.
Segment = tuple[str, str]
Line = list[Segment]


def line_width(line: Line) -> int:
    return sum(len(text) for text, _ in line)


def clip(line: Line, width: int, more: str) -> Line:
    """Cut a line to width, ending in the ellipsis glyph if anything was lost."""
    if line_width(line) <= width:
        return line
    room = max(0, width - len(more))
    out: Line = []
    for text, role in line:
        if room <= 0:
            break
        out.append((text[:room], role))
        room -= len(text[:room])
    out.append((more[:width], out[-1][1] if out else "muted"))
    return out


def pad(line: Line, width: int) -> Line:
    gap = width - line_width(line)
    return line + [(" " * gap, "text")] if gap > 0 else line


class Card:
    """One panel: a section name, a headline figure, and lines under it.

    A row whose value is empty is left out entirely, so a battery row on a
    desktop is not a name with nothing after it.
    """

    def __init__(self, title: str, width: int, glyphs: dict[str, str]) -> None:
        self.title = title
        self.width = width
        self.glyphs = glyphs
        self.headline: Line = []
        self.lines: list[Line] = []

    def head(self, value: str, role: str = "strong") -> None:
        self.headline = [(value, role)] if value else []

    def add(self, line: Line) -> None:
        self.lines.append(clip(line, self.width, self.glyphs["more"]))

    def row(self, name: str, value: str | Line, role: str = "text") -> None:
        if not value:
            return
        indent = NAME_WIDTH + 2
        if not isinstance(value, str):
            self.add([(f"{name:>{NAME_WIDTH}}  ", "muted"), *value])
            return
        parts = textwrap.wrap(value, max(10, self.width - indent)) or [value]
        self.add([(f"{name:>{NAME_WIDTH}}  ", "muted"), (parts[0], role)])
        for part in parts[1:]:
            self.add([(" " * indent, "text"), (part, role)])

    def text(self, value: str, role: str = "text", *, wrap: bool = False) -> None:
        if not value:
            return
        if not wrap:
            self.add([(value, role)])
            return
        for part in textwrap.wrap(value, max(self.width, 10)):
            self.add([(part, role)])

    def bar_segments(self, value: float | None, width: int) -> Line:
        filled = round((value or 0.0) * width)
        tone = "amber" if value is not None and value >= WARN_FRACTION else "blue"
        return [(self.glyphs["full"] * filled, tone), (self.glyphs["empty"] * (width - filled), "muted")]

    def bar(self, value: float | None) -> None:
        self.add(self.bar_segments(value, self.width))

    def gap(self) -> None:
        self.lines.append([])

    def render(self) -> list[Line]:
        title: Line = [(self.title.upper(), "section")]
        room = self.width - line_width(title) - 1
        headline = clip(self.headline, max(0, room), self.glyphs["more"]) if self.headline and room > 0 else []
        top = pad(title, self.width - line_width(headline)) + headline
        return [top, *self.lines]


def card_system(card: Card, snapshot: dict, now: float) -> None:
    host = snapshot.get("host") or {}
    card.head(host.get("hostname") or "")
    card.row("machine", host.get("model") or "not named by the firmware")
    threads = host.get("threads")
    card.row("processor", f"{host.get('cpu') or '--'}" + (f", {threads} threads" if threads else ""))
    card.row("memory", format_bytes(host.get("memory_bytes") or None))
    gpu = snapshot.get("gpu") or {}
    card.row("graphics", gpu.get("name") or gpu.get("detail") or "none reported")
    card.row("firmware", host.get("firmware") or "--")
    card.row("kernel", host.get("kernel") or "--")
    card.row("hostname", host.get("hostname") or "--")
    session = ", ".join(part for part in (host.get("user"), host.get("session"), host.get("session_type")) if part)
    card.row("session", session or "--")
    card.row("up", hud.format_duration(host.get("uptime_seconds")))
    load = host.get("load")
    card.row("load", "  ".join(f"{value:.2f}" for value in load) if load else "--")
    battery = host.get("battery")
    card.row("battery", f"{battery['percent']}%{', charging' if battery.get('charging') else ''}" if battery else "")


def card_release(card: Card, snapshot: dict, now: float) -> None:
    release = snapshot.get("release") or {}
    version = release.get("version") or "unknown"
    card.head(version)
    commit = release.get("commit")
    card.row("portlin", f"{version} ({commit})" if commit else version)
    card.row("debian", release.get("debian") or "--")
    root = release.get("root") or "--"
    card.row("root", [(root, "text"), (", ", "text"), ("luks", "accent")] if release.get("encrypted") else root)
    drive = release.get("drive") or "--"
    if release.get("drive_bytes"):
        drive += f", {format_bytes(release['drive_bytes'])}"
    card.row("drive", drive)
    packages = ", ".join(
        f"{name} {version}" for name, version in (
            ("portlin-runtime", release.get("runtime_version")),
            ("portlin-desktop", release.get("desktop_version")),
        ) if version
    )
    card.row("packages", packages or "not installed from packages")
    card.text(release.get("advice") or "", "amber", wrap=True)


def card_cpu(card: Card, snapshot: dict, now: float) -> None:
    cpu = snapshot.get("cpu") or {}
    card.head(format_percent(cpu.get("percent")))
    card.bar(fraction(cpu.get("percent"), 100))
    cores = cpu.get("cores") or []
    if cores:
        columns = 4 if len(cores) <= 16 else 8
        cell = max(1, (card.width - (columns - 1)) // columns)
        for start in range(0, len(cores), columns):
            line: Line = []
            for index, busy in enumerate(cores[start:start + columns]):
                if index:
                    line.append((" ", "text"))
                line += card.bar_segments(fraction(busy, 100), cell)
            card.add(line)
    card.row("clock", f"{cpu['mhz']} MHz" if cpu.get("mhz") else "--")
    card.row("temperature", f"{cpu['temperature_c']} C" if cpu.get("temperature_c") is not None else "no sensor")
    load = (snapshot.get("host") or {}).get("load")
    card.row("load", "  ".join(f"{value:.2f}" for value in load) if load else "--")


def card_memory(card: Card, snapshot: dict, now: float) -> None:
    memory = snapshot.get("memory")
    if not memory:
        card.head("--")
        return
    total = memory.get("total") or 0
    card.head(f"{format_bytes(memory.get('used'))} / {format_bytes(total)}")
    card.bar(fraction(memory.get("used"), total))
    rows = memory_rows(memory)
    name_width = max(len(name) for name, _, _ in rows)
    value_width = max(len(value) for _, value, _ in rows)
    bar_width = card.width - name_width - value_width - 4
    for name, value, count in rows:
        line: Line = [(f"{name:<{name_width}}  {value:>{value_width}}", "muted")]
        if bar_width >= 4:
            line += [("  ", "text"), *card.bar_segments(fraction(count, total), bar_width)]
        card.add(line)
    card.gap()
    if memory.get("swap_total"):
        card.row("swap", f"{format_bytes(memory.get('swap_used'))} / {format_bytes(memory['swap_total'])}")
    else:
        card.row("swap", "none")
    for device in memory.get("zram") or []:
        card.text(
            f"{device['name']}: {format_bytes(device['original'])} of {format_bytes(device['disksize'])} stored in "
            f"{format_bytes(device['memory_used'])} of memory",
            "muted", wrap=True,
        )


def card_gpu(card: Card, snapshot: dict, now: float) -> None:
    gpu = snapshot.get("gpu")
    if not gpu:
        card.text("No graphics card reported by the kernel.", "muted", wrap=True)
        return
    card.head(gpu.get("label") or "")
    card.row("card", gpu.get("name") or gpu.get("detail") or "--")
    kind = gpu.get("kind")
    if kind == "percent":
        card.row("usage", f"{gpu.get('value')}% busy")
    elif kind == "frequency":
        card.row("usage", f"{gpu.get('value')} MHz clock, no utilisation counter")
    else:
        card.row("usage", "no utilisation counter")
    used, total = gpu.get("memory_used"), gpu.get("memory_total")
    if total:
        card.row("memory", f"{format_bytes(used)} / {format_bytes(total)}")
        card.bar(fraction(used, total))
    card.row("temperature", f"{gpu['temperature_c']} C" if gpu.get("temperature_c") is not None else "")
    card.row("power", f"{gpu['power_w']} W" if gpu.get("power_w") is not None else "")


def card_addresses(card: Card, snapshot: dict, now: float) -> None:
    addresses = snapshot.get("addresses") or {}
    private = addresses.get("private") or "none"
    card.head(private if private != "none" else "offline")
    card.row("private", private)
    public = addresses.get("public")
    state = addresses.get("public_state") or ""
    card.row("public", public or {
        "asking": "asking...", "no route": "no route to the internet",
        "no answer": "no answer", "off": "not asked", "not asked": "--",
    }.get(state, "--"))
    card.row("route", addresses.get("default_interface") or "no default route")
    source = addresses.get("public_source") or ""
    if source and state != "off":
        card.text(f"The public address is what {source.split('//')[-1]} sees this machine as.", "muted", wrap=True)


def card_storage(card: Card, snapshot: dict, now: float) -> None:
    filesystems = snapshot.get("filesystems") or []
    disks = snapshot.get("disks") or []
    root_fs = next((fs for fs in filesystems if fs["mountpoint"] == "/"), None)
    card.head(f"{format_bytes(root_fs['used_bytes'])} / {format_bytes(root_fs['total_bytes'])}" if root_fs else "")
    for fs in filesystems:
        card.add([(fs["mountpoint"], "strong"),
                  (f"  {format_bytes(fs['used_bytes'])} / {format_bytes(fs['total_bytes'])}", "text")])
        card.text(f"{fs['source']}, {fs['fstype']}", "muted")
        card.bar(fraction(fs["used_bytes"], fs["total_bytes"]))
    if filesystems and disks:
        card.gap()
    for disk in disks:
        card.text(disk["name"], "strong")
        card.text(disk_summary(disk), "muted", wrap=True)
    if not filesystems and not disks:
        card.text("No block devices reported.", "muted")


def card_network(card: Card, snapshot: dict, now: float) -> None:
    interfaces = snapshot.get("interfaces") or []
    up = [interface for interface in interfaces if interface["state"] == "up"]
    default = next((interface for interface in interfaces if interface.get("default")), None)
    card.head(f"{hud.format_rate(default.get('rx_rate'))} down" if default else (f"{len(up)} up" if up else ""))
    for index, interface in enumerate(interfaces):
        if index:
            card.gap()
        card.add([(interface["name"], "strong"), ("  ", "text"),
                  (interface["kind"], "blue" if interface.get("default") else "muted")])
        card.text(interface_summary(interface), "muted")
        card.text("  ".join(interface.get("addresses") or ()), wrap=True)
        card.text(wifi_summary(interface), "muted")
        card.text(traffic_summary(interface), wrap=True)
    if not interfaces:
        card.text("No network links.", "muted")


def card_agents(card: Card, snapshot: dict, now: float) -> None:
    agent_snapshot = snapshot.get("agents") or {}
    sessions = agent_snapshot.get("sessions") or []
    unmatched = agent_snapshot.get("unmatched") or []
    installed = agent_snapshot.get("installed") or []
    names = agent_snapshot.get("names") or {}
    card.head(agents_headline({"processes": [], "names": {}, **agent_snapshot}))
    for index, session in enumerate(sessions):
        if index:
            card.gap()
        status = session.get("status") or ""
        heading: Line = [(names.get(session["agent"], session["agent"]), "blue"), ("  ", "text"),
                         (session.get("project") or "", "strong")]
        room = card.width - line_width(heading) - len(status) - 1
        if status and room >= 0:
            heading = pad(heading, card.width - len(status)) + [(status, status_tone(status) or "muted")]
        card.add(heading)
        card.text(session.get("title") or "", "muted")
        card.text(session.get("task") or "")
        card.text(session_context(session))
        if session.get("context_percent") is not None:
            card.bar(fraction(session["context_percent"], 100))
        card.text(session_tokens(session), "muted")
        card.text(session_meta(session, now), "muted", wrap=True)
        card.text(session_limits(session, now), "muted", wrap=True)
    if sessions and unmatched:
        card.gap()
    for process in unmatched:
        card.text(process_summary(process, names), wrap=True)
    if not sessions and not unmatched:
        card.text("No AI agents running.", "muted")
    if installed:
        card.gap()
        card.text(f"Installed: {', '.join(installed)}", "muted", wrap=True)


