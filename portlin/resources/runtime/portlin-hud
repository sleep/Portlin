def column_count(width: int) -> int:
    return max(1, min(len(CARD_ORDER), (width + GUTTER) // (CARD_MIN_WIDTH + GUTTER)))


def render(snapshot: dict, width: int, *, glyphs: dict[str, str] = GLYPHS_UTF8, now: float | None = None) -> list[Line]:
    """Every card, laid out in rows of as many columns as the width allows.

    Each row is as tall as its tallest card, with a blank line under it.
    Every line is padded to the full width, so a redraw overwrites the last.
    """
    if now is None:
        now = snapshot.get("sampled_at") or time.time()
    columns = column_count(width)
    card_width = max(10, (width - GUTTER * (columns - 1)) // columns)
    rendered = []
    for key, title in CARD_ORDER:
        card = Card(title, card_width, glyphs)
        CARDS[key](card, snapshot, now)
        rendered.append(card.render())
    lines: list[Line] = []
    for start in range(0, len(rendered), columns):
        row = rendered[start:start + columns]
        for index in range(max(len(card) for card in row)):
            line: Line = []
            for position, card in enumerate(row):
                if position:
                    line.append((" " * GUTTER, "text"))
                line += pad(card[index] if index < len(card) else [], card_width)
            lines.append(pad(line, width))
        lines.append(pad([], width))
    return lines


def render_text(snapshot: dict, width: int, **options) -> str:
    return "\n".join("".join(text for text, _ in line).rstrip() for line in render(snapshot, width, **options))


# -- the terminal --------------------------------------------------------------


def unicode_terminal() -> bool:
    return "utf" in locale.getpreferredencoding(False).lower().replace("-", "")


class Screen:
    """The curses loop: a header, the cards scrolled under it, a key line.

    The loop only ever draws the latest snapshot the collector thread has
    handed it, so keys still answer while a sleeping GPU wakes.
    """

    def __init__(self, screen, collector: Collector, *, interval: int) -> None:
        self.screen = screen
        self.collector = collector
        self.interval = interval
        self.glyphs = GLYPHS_UTF8 if unicode_terminal() else GLYPHS_ASCII
        self.snapshot: dict | None = None
        self.error = ""
        self.scroll = 0
        self.lock = threading.Lock()
        self.stop = threading.Event()
        self.wake = threading.Event()
        self.colors: dict[str, int] = {}

    def _colours(self) -> None:
        self.colors = {"text": curses.A_NORMAL, "strong": curses.A_BOLD, "section": curses.A_BOLD,
                       "muted": curses.A_DIM, "green": curses.A_BOLD, "blue": curses.A_NORMAL,
                       "amber": curses.A_BOLD, "accent": curses.A_BOLD, "key": curses.A_REVERSE}
        if not curses.has_colors():
            return
        curses.start_color()
        try:
            curses.use_default_colors()
            background = -1
        except curses.error:
            background = curses.COLOR_BLACK
        palette = PALETTE_256 if curses.COLORS >= 256 else PALETTE_8
        for number, (role, colour) in enumerate(palette.items(), start=1):
            curses.init_pair(number, colour, background)
            self.colors[role] = curses.color_pair(number)
        self.colors["section"] = self.colors["muted"] | curses.A_BOLD

    def _collect(self) -> None:
        while not self.stop.is_set():
            started = time.monotonic()
            try:
                snapshot, error = self.collector.snapshot(), ""
            except Exception as failure:  # a reader that raises must not end the loop
                snapshot, error = None, f"{type(failure).__name__}: {failure}"
            with self.lock:
                if snapshot is not None:
                    self.snapshot = snapshot
                self.error = error
            self.wake.wait(max(0.5, self.interval - (time.monotonic() - started)))
            self.wake.clear()

    def put(self, y: int, x: int, text: str, attr: int = 0) -> None:
        height, columns = self.screen.getmaxyx()
        if not (0 <= y < height and 0 <= x < columns):
            return
        try:
            self.screen.addstr(y, x, text[:columns - x], attr)
        except curses.error:
            # Writing the bottom-right cell draws it and then raises, because
            # the cursor has nowhere to go.
            pass

    def put_line(self, y: int, x: int, line: Line) -> None:
        for text, role in line:
            self.put(y, x, text, self.colors.get(role, 0))
            x += len(text)

    def draw(self) -> None:
        height, columns = self.screen.getmaxyx()
        self.screen.erase()
        with self.lock:
            snapshot, error = self.snapshot, self.error
        host = (snapshot or {}).get("host") or {}
        title: Line = [(" HUD ", "key"), ("  ", "text"),
                       (", ".join(part for part in (host.get("hostname"), host.get("model")) if part), "strong")]
        if error:
            title += [("  ", "text"), (error, "amber")]
        clock = time.strftime("%a %d %b  %H:%M:%S")
        self.put_line(0, 0, clip(title, max(0, columns - len(clock) - 2), self.glyphs["more"]))
        self.put(0, columns - len(clock) - 1, clock, self.colors["muted"])

        body = max(0, height - 3)
        if snapshot is None:
            self.put(2, 1, "Reading the machine...", self.colors["muted"])
            lines: list[Line] = []
        else:
            lines = render(snapshot, max(10, columns - 2), glyphs=self.glyphs)
        self.scroll = max(0, min(self.scroll, len(lines) - body))
        for row, line in enumerate(lines[self.scroll:self.scroll + body]):
            self.put_line(row + 2, 1, line)

        keys: Line = []
        for key, action in (("q", "quit"), ("r", "refresh"),
                            (f"{self.glyphs['up']}{self.glyphs['down']}", "scroll")):
            keys += [(f" {key} ", "key"), (f" {action}  ", "muted")]
        if len(lines) > body:
            keys.append((f"{self.scroll + 1}-{min(len(lines), self.scroll + body)} of {len(lines)}", "muted"))
        self.put_line(height - 1, 0, clip(keys, columns - 1, self.glyphs["more"]))
        self.screen.refresh()

    def run(self) -> int:
        self._colours()
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        # Esc quits, and curses otherwise waits a second to be sure it is
        # not the start of an arrow key's sequence.
        curses.set_escdelay(25)
        self.screen.timeout(500)
        threading.Thread(target=self._collect, name="portlin-hud-collector", daemon=True).start()
        try:
            while True:
                self.draw()
                key = self.screen.getch()
                page = max(1, self.screen.getmaxyx()[0] - 4)
                if key in (ord("q"), ord("Q"), 27):
                    return 0
                if key in (ord("r"), ord("R")):
                    self.wake.set()
                elif key in (curses.KEY_DOWN, ord("j")):
                    self.scroll += 1
                elif key in (curses.KEY_UP, ord("k")):
                    self.scroll -= 1
                elif key in (curses.KEY_NPAGE, ord(" ")):
                    self.scroll += page
                elif key == curses.KEY_PPAGE:
                    self.scroll -= page
                elif key == curses.KEY_HOME:
                    self.scroll = 0
                elif key == curses.KEY_END:
                    self.scroll = 1 << 30
                self.scroll = max(0, self.scroll)
        finally:
            self.stop.set()
            self.wake.set()


def run_terminal(*, interval: int, lookup_public: bool) -> int:
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("portlin-hud: needs a terminal; --json prints one snapshot without one", file=sys.stderr)
        return 2
    locale.setlocale(locale.LC_ALL, "")
    collector = Collector(lookup_public=lookup_public)
    try:
        return curses.wrapper(lambda screen: Screen(screen, collector, interval=interval).run())
    except KeyboardInterrupt:
        return 0


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="portlin-hud", description="What this machine is, and what it is doing.")
    parser.add_argument("--json", action="store_true", help="print one snapshot as JSON and exit")
    parser.add_argument("--interval", type=int, default=DEFAULT_INTERVAL, metavar="SECONDS",
                        help=f"refresh every this many seconds (default {DEFAULT_INTERVAL})")
    parser.add_argument("--no-public", action="store_true",
                        help=f"never ask {hud.PUBLIC_ADDRESS_URL} for the public address")
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    if args.json:
        return print_json(Collector(lookup_public=not args.no_public))
    return run_terminal(interval=max(1, args.interval), lookup_public=not args.no_public)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
