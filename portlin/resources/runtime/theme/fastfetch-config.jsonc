// Portlin's fastfetch face: the mark as an ASCII logo (portlin.txt beside
// this file) and the same data the portlin-welcome banner shows. Colors are
// palette names on purpose -- the shipped terminalrc maps white to muted
// #7C8B9E and bright-white to paper #E8EDF3, so no hex colors are needed and
// this file matches every other portlin surface automatically. The accent is
// {2} in the logo: the last partition bar, the encrypted root.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/portlin.txt",
    "color": { "1": "white", "2": "red" },
    "padding": { "top": 1, "left": 2, "right": 5 }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "title",
    { "type": "separator" },
    { "type": "os", "key": "os" },
    { "type": "host", "key": "host" },
    { "type": "kernel", "key": "kernel" },
    { "type": "uptime", "key": "uptime" },
    { "type": "packages", "key": "packages" },
    { "type": "shell", "key": "shell" },
    { "type": "wm", "key": "wm" },
    { "type": "cpu", "key": "cpu" },
    { "type": "memory", "key": "memory" },
    { "type": "disk", "key": "disk (/)", "folders": "/" },
    { "type": "command", "key": "portlin", "shell": "/bin/sh",
      "text": "sed -n 's/^PORTLIN_VERSION=//p' /etc/portlin-release" }
  ]
}
