# Generated by portlin. Run by labwc as the lite session starts.
#
# Everything here is named with its config path rather than left to search
# for one: of these programs only labwc and fuzzel look along
# XDG_CONFIG_DIRS, and a copy of this file in ~/.config/labwc replaces it
# outright, which is the way to change any of it.

overlay=/etc/xdg/xdg-portlin

# GTK on Wayland takes its theme from GSettings, not from settings.ini, so
# without this every window is Adwaita whatever the wizard chose. The ini
# stays the one place the choice lives: the account's own copy if it has one,
# else the system default the wizard rewrites.
ini="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/settings.ini"
[ -r "$ini" ] || ini="$overlay/gtk-3.0/settings.ini"
theme=$(sed -n 's/^gtk-theme-name=//p' "$ini" | tail -n 1)
icons=$(sed -n 's/^gtk-icon-theme-name=//p' "$ini" | tail -n 1)
[ -n "$theme" ] && gsettings set org.gnome.desktop.interface gtk-theme "$theme"
[ -n "$icons" ] && gsettings set org.gnome.desktop.interface icon-theme "$icons"
gsettings set org.gnome.desktop.interface color-scheme prefer-dark

# Before the panel, so it is laid out at the scale it will be drawn at.
/usr/lib/portlin/portlin-lite-display

# The path the Xfce desktop and the greeter draw, which portlin-backdrop
# points at the render that is true of this stick on every boot.
swaybg -m fill -i /usr/share/backgrounds/xfce/xfce-x.svg >/dev/null 2>&1 &
waybar -c "$overlay/waybar/config.jsonc" -s "$overlay/waybar/style.css" >/dev/null 2>&1 &
mako -c "$overlay/mako/config" >/dev/null 2>&1 &
/usr/libexec/polkit-mate-authentication-agent-1 >/dev/null 2>&1 &
nm-applet --indicator >/dev/null 2>&1 &

# Caffeine, which also starts the screen lock: it is what stops and restarts
# swayidle, so one process owns both and they cannot race at login.
portlin-caffeine-lite run >/dev/null 2>&1 &

portlin-intro --once >/dev/null 2>&1 &
