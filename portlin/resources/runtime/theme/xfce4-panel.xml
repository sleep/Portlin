<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by portlin. -->
<!--
  The panel, in full, rather than a property or two layered onto Debian's.

  Portlin used to override only the menu button's label here, on the plugin id
  Debian's own default.xml happens to give applicationsmenu. That worked, and it
  could not be extended: plugin-ids is a single array property and xfconf has no
  append, so adding one plugin means restating the whole list, and restating the
  whole list is owning the layout. There is no third option.

  Owning it pays for itself twice over. The version label no longer rides on a
  number Debian chose, so the check that policed Debian's numbering is gone
  rather than updated. And whiskermenu takes its button icon from the property
  below, which is what the one-icon "Portlin" icon theme existed to work around:
  the applications menu took its icon from a name compiled into the plugin, so
  answering to that name was the only way to reach it.

  configver is load-bearing and its absence is silent. xfce4-panel/migrate reads
  it, and on anything below the current version it loads Debian's default.xml
  and writes that into the user's own file -- which beats every system default,
  including this one. A layout shipped without configver is therefore not a
  layout that partly applies; it is a layout that vanishes within a second of
  the first login, with nothing anywhere to say so.

  What portlin now owns forever: the panel's count, position, size, the plugin
  list and its order, and one property per plugin it has an opinion about.
  Nothing else is set, because every property set here is one that follows the
  package forward on upgrade for anyone who has not overridden it.
-->
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>

  <property name="panels" type="array">
    <value type="int" value="1"/>
    <property name="dark-mode" type="bool" value="true"/>

    <!--
      One panel, at the top. Debian ships a second one: a 48px auto-hiding dock
      along the bottom holding show-desktop, four launchers and a directory
      menu. On the 1366x768 laptops a travelling stick gets plugged into, that
      is a strip of nothing that appears when the pointer nears it, and
      whiskermenu's search field reaches those four programs faster than the
      dock does. Dropping it is also eight plugin definitions portlin does not
      have to own. It leaves the wallpaper's bottom-right wordmark clear, which
      is where that composition wanted it.
    -->
    <property name="panel-1" type="empty">
      <property name="position" type="string" value="p=6;x=0;y=0"/>
      <property name="length" type="uint" value="100"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="size" type="uint" value="28"/>
      <property name="icon-size" type="uint" value="16"/>
      <property name="nrows" type="uint" value="1"/>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>
        <value type="int" value="2"/>
        <value type="int" value="3"/>
        <value type="int" value="4"/>
        <value type="int" value="5"/>
        <value type="int" value="6"/>
        <value type="int" value="7"/>
        <value type="int" value="8"/>
        <value type="int" value="9"/>
        <value type="int" value="10"/>
        <value type="int" value="11"/>
      </property>
    </property>
  </property>

  <property name="plugins" type="empty">
    <!--
      button-icon is an icon name rather than a path, so it resolves under
      whatever icon theme is in force -- including one the user picks later in
      Settings. hicolor is where portlin installs its mark and is the icon
      spec's terminal fallback, so the name resolves under every theme there is.
      The same name is what portlin-about.desktop and portlin-software.desktop
      already ask for.
    -->
    <property name="plugin-1" type="string" value="whiskermenu">
      <property name="button-icon" type="string" value="portlin"/>
      <property name="button-title" type="string" value="Portlin @PORTLIN_VERSION@"/>
      <property name="show-button-icon" type="bool" value="true"/>
      <property name="show-button-title" type="bool" value="true"/>
    </property>

    <!--
      Every separator here is style 0, which is the transparent one: no line, no
      dots, just space. Five of them, all identical, is the whole spacing rule.
    -->
    <property name="plugin-2" type="string" value="separator">
      <property name="style" type="uint" value="0"/>
    </property>

    <property name="plugin-3" type="string" value="tasklist">
      <property name="grouping" type="uint" value="1"/>
    </property>

    <!-- The spring. Everything after this is pushed to the right-hand end. -->
    <property name="plugin-4" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>

    <!--
      The readout. genmon is the one panel plugin with no xfconf backend: its
      command, refresh period and font come from a file named for its type and
      this id, genmon-5.rc, which portlin ships in the same overlay. package.py
      builds the id here and that filename from one constant, because a layout
      naming one id and a file named for another is a panel item that runs
      nothing at all.
    -->
    <property name="plugin-5" type="string" value="genmon"/>

    <property name="plugin-6" type="string" value="separator">
      <property name="style" type="uint" value="0"/>
    </property>

    <property name="plugin-7" type="string" value="systray">
      <property name="square-icons" type="bool" value="true"/>
    </property>

    <property name="plugin-8" type="string" value="separator">
      <property name="style" type="uint" value="0"/>
    </property>

    <!--
      %R is 24-hour HH:MM. A stick boots in a locale nobody chose, and 24-hour
      is the one reading that is never ambiguous; it is also the format string
      the plugin itself defaults to. The date is spelled out rather than
      numbered for the same reason: 03/09 is two different days depending on
      which side of an ocean the machine is on.
    -->
    <property name="plugin-9" type="string" value="clock">
      <property name="mode" type="uint" value="2"/>
      <property name="digital-layout" type="uint" value="3"/>
      <property name="digital-time-format" type="string" value="%R"/>
      <property name="digital-date-format" type="string" value="%a %e %b"/>
      <property name="tooltip-format" type="string" value="%A %e %B %Y"/>
    </property>

    <property name="plugin-10" type="string" value="separator">
      <property name="style" type="uint" value="0"/>
    </property>

    <property name="plugin-11" type="string" value="actions"/>
  </property>
</channel>
