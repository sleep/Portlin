# Generated by portlin.
#
# genmon is the one panel plugin with no xfconf backend: it reads its
# configuration from a file named after its plugin type and its numeric id,
# looked up along XDG_CONFIG_DIRS. So this filename is not a name someone
# chose -- it is genmon-<id>.rc for the id the shipped panel layout gives the
# plugin, and package.py builds both from the same constant so they cannot
# drift apart into a plugin with no command and a file nothing reads.
#
# UseLabel=0 suppresses genmon's own label. The readout prints one line of
# markup and having the plugin draw a second string beside it in a different
# font is precisely what choosing one script over five stock plugins was meant
# to avoid.
#
# Monospace, deliberately not the brand's Menlo: Menlo does not exist on
# Debian, and naming a font the system cannot resolve is a silent fallback to
# whatever fontconfig picks. Monospace resolves to DejaVu Sans Mono, which the
# fonts group installs. A fixed-width face is what stops the line reflowing
# every time a number gains a digit.
[Configuration]
Command=/usr/bin/portlin-stats
UpdatePeriod=2000
UseLabel=0
Font=Monospace 9
