# Generated by portlin.
#
# An icon theme that provides exactly one icon and inherits everything else.
#
# It exists because xfce4-panel's applications menu takes its button icon from
# a name compiled into the plugin -- Debian's panel layout sets no button-icon
# at all -- so the only way to change that button without freezing the whole
# panel layout or diverting eight files out of xfce4-panel is to answer to the
# name it asks for.
#
# Inherits is load-bearing, not decoration: naming this theme in xsettings
# makes it the theme for every icon on the desktop, and a theme that inherited
# nothing would leave one menu button drawn and everything else blank.
[Icon Theme]
Name=Portlin
Comment=The Portlin mark over the stock icon set
Inherits=Adwaita,hicolor
Directories=scalable/apps

[scalable/apps]
Size=48
MinSize=8
MaxSize=512
Context=Applications
Type=Scalable
