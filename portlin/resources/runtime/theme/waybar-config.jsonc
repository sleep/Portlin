// Generated by portlin. The lite session's panel: the same single bar along
// the top as the Xfce session, with the same readout at its right end.
{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 8,
  "modules-left": ["image#mark", "custom/apps", "wlr/taskbar"],
  "modules-right": ["custom/stats", "image#caffeine", "tray", "clock"],

  // The mark from hicolor, where every icon lookup ends, and the menu it
  // opens: fuzzel searches the same .desktop entries whiskermenu does.
  "image#mark": {
    "path": "/usr/share/icons/hicolor/scalable/apps/portlin.svg",
    "size": 18,
    "on-click": "fuzzel",
    "tooltip": false
  },
  "custom/apps": {
    "format": "Applications",
    "on-click": "fuzzel",
    "tooltip": false
  },
  "wlr/taskbar": {
    "format": "{icon} {title:.24}",
    "icon-size": 16,
    "on-click": "activate",
    "on-click-middle": "close",
    "tooltip-format": "{title}"
  },

  // genmon re-runs the readout every two seconds in Xfce; this does the same.
  // portlin-stats --waybar prints the same markup as one JSON object.
  "custom/stats": {
    "exec": "portlin-stats --waybar",
    "return-type": "json",
    "interval": 2,
    "on-click": "portlin-about"
  },
  // Caffeine. The holder, started by the session's autostart, signals
  // SIGRTMIN+8 on every change so a click shows at once; the interval only
  // keeps the tooltip's countdown fresh.
  "image#caffeine": {
    "exec": "portlin-caffeine-lite icon",
    "size": 18,
    "signal": 8,
    "interval": 60,
    "on-click": "portlin-caffeine-lite toggle",
    "on-click-right": "portlin-caffeine-lite menu"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "{:%A %d %B %Y}"
  }
}
