<?xml version="1.0"?>
<!-- Generated by portlin. The lite session's labwc configuration. -->
<!--
  Read from /etc/xdg/xdg-portlin/labwc because portlin-lite-session puts that
  directory on XDG_CONFIG_DIRS. An rc.xml in ~/.config/labwc replaces this one
  entirely, as labwc reads the first it finds.
-->
<labwc_config>

  <!--
    No theme name: labwc's built-in theme, recoloured to portlin's palette by
    themerc-override beside this file. The widget themes the first-boot wizard
    offers are GTK and xfwm4 themes, and only one of them has an openbox face,
    so naming one here would give two of three choices unstyled borders.
  -->
  <theme>
    <name></name>
    <cornerRadius>6</cornerRadius>
    <font place="ActiveWindow" name="DejaVu Sans" size="10" weight="bold" />
    <font place="InactiveWindow" name="DejaVu Sans" size="10" weight="bold" />
    <font place="MenuItem" name="DejaVu Sans" size="10" />
    <font place="OnScreenDisplay" name="DejaVu Sans" size="10" />
  </theme>

  <keyboard>
    <default />
    <keybind key="W-Return">
      <action name="Execute" command="x-terminal-emulator" />
    </keybind>
    <keybind key="A-F2">
      <action name="Execute" command="fuzzel" />
    </keybind>
    <keybind key="W-space">
      <action name="Execute" command="fuzzel" />
    </keybind>
    <keybind key="W-e">
      <action name="Execute" command="thunar" />
    </keybind>
    <keybind key="W-l">
      <action name="Execute" command="swaylock -f -c 12161C" />
    </keybind>
    <keybind key="C-A-l">
      <action name="Execute" command="swaylock -f -c 12161C" />
    </keybind>
    <keybind key="C-A-Delete">
      <action name="ShowMenu" menu="root-menu" />
    </keybind>
    <!--
      Xfce's power manager answers these keys in the full session. Here nothing
      would, so they are bound directly.
    -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" />
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="brightnessctl set 5%+" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="brightnessctl set 5%-" />
    </keybind>
  </keyboard>

  <mouse>
    <default />
  </mouse>

  <!-- Tap to click, as Xfce's touchpad default is on Debian. -->
  <libinput>
    <device category="touchpad">
      <tap>yes</tap>
    </device>
  </libinput>

</labwc_config>
