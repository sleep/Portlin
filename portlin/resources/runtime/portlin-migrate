def passphrase_from_stdin() -> str:
    return sys.stdin.readline().rstrip("\n")


def passphrase_once() -> Callable[[], str]:
    """stdin's first line as the passphrase, then nothing. apply keeps stdin
    open to hear a pause, so a second readline after a wrong passphrase
    would wait forever instead of meeting the end of input."""
    asked = {"done": False}

    def read() -> str:
        if asked["done"]:
            return ""
        asked["done"] = True
        return passphrase_from_stdin()

    return read


def resolve_source_path(given: str | None) -> str:
    if given and given != "auto":
        return given
    found = list_candidates()
    if len(found) == 1:
        return found[0].path
    if not found:
        raise SourceError("no portlin drive or archive was found")
    raise SourceError("more than one candidate; name one: " + ", ".join(c.path for c in found))


def cmd_candidates(args) -> int:
    found = list_candidates()
    if args.json:
        print(json.dumps([c.__dict__ for c in found]))
    else:
        for candidate in found:
            print(f"{candidate.path:<20} {describe(candidate)}")
    return EXIT_OK


def cmd_inventory(args) -> int:
    source = open_source(resolve_source_path(args.source), passphrase=passphrase_from_stdin)
    try:
        inventory = source_inventory(source, firstboot=args.firstboot)
    finally:
        if source.kind == "stick":
            close_source()
    if not args.firstboot:
        inventory = mark_existing_account(inventory, local_target().user)
    if args.json:
        print(to_json(inventory), end="")
    else:
        for item in inventory.items:
            mark = "x" if item.default else " "
            size = human(item.bytes) if item.bytes else ""
            print(f"[{mark}] {item.id:<40} {size:>9}  {item.label}")
    return EXIT_OK


def narrow(inventory: Inventory, ids: list[str], only, skip) -> list[str]:
    """--only keeps ids or whole categories; --skip drops them."""
    kept = []
    for item in selected(inventory, ids):
        names = (item.id, item.category)
        if only and not any(n in only for n in names):
            continue
        if skip and any(n in skip for n in names):
            continue
        kept.append(item.id)
    return kept


def plan_source(plan: dict, by_uuid: Path = BY_UUID) -> str:
    """Where the plan's source is now. A drive unplugged at a pause can come
    back as sdc where it was sdb, so its UUID is asked first; the plan file
    is the user's, so the UUID has to look like one before it becomes a path."""
    uuid = str(plan.get("uuid") or "")
    if plan.get("kind") != "archive" and UUID_RE.fullmatch(uuid):
        link = by_uuid / uuid
        if link.exists():
            return os.path.realpath(link)
    return plan["source"]


def apply_plan(path: Path, *, out, only=None, skip=None, passphrase=passphrase_from_stdin,
               listen: bool = False) -> tuple[int, str]:
    """Run a plan. Returns the exit code and the text for ::result or a dialog.

    ``listen`` reads stdin for a pause once the passphrase, if any, is read.
    """
    plan = read_plan(path)
    inventory = from_json(json.dumps(plan["inventory"]))
    ids = narrow(inventory, list(plan["ids"]), only, skip)
    firstboot = bool(plan.get("firstboot"))
    stamp = stamp_now()
    source = open_source(plan_source(plan), passphrase=passphrase)
    if listen:
        listen_for_pause()
    try:
        if source.kind == "archive":
            source_inventory(source, firstboot=firstboot)  # fills the listing
        short = shortfall(selected_bytes(inventory, ids), shutil.disk_usage("/").free)
        if short:
            return EXIT_NO_SPACE, no_space_message(short, unclaimed_now())
        target = local_target()
        warnings: list[str] = []
        account = next((a for a in inventory.accounts if f"account.{a.name}" in ids), None)
        if account and not target.user:
            steps = account_steps(account, existing_groups={g.gr_name for g in grp.getgrall()},
                                  uid_free=not uid_in_use(account.uid), shells=local_shells())
            result = run_steps(steps, total=0, out=out)
            warnings += result.warnings
            if not result.ok:
                return EXIT_FAILED, result.failure
            if not any(step.argv for step in steps):
                # The account was refused by name, so there is nothing to
                # give the files to and nothing useful to do with them.
                return EXIT_FAILED, "; ".join(result.warnings) or "the account could not be created"
            target = target_for(account.name)
        elif account and target.user and target.user != account.name:
            emit("warn", f"the account {target.user} already exists here, so {account.name}'s files go into it", out=out)
        steps = apply_steps(
            inventory, ids, source, target, stamp, firstboot=firstboot,
            hosts_text=Path("/etc/hosts").read_text() if Path("/etc/hosts").exists() else "",
            icon_theme_installed=lambda name: Path(f"/usr/share/icons/{name}/index.theme").exists(),
        )
        result = run_steps(steps, total=sum(s.weight for s in steps), out=out, move_roots=move_roots(target))
        warnings += result.warnings
        if not result.ok:
            return EXIT_FAILED, result.failure
        return EXIT_OK, summary(len(selected(inventory, ids)), target, stamp, warnings)
    finally:
        if source.kind == "stick":
            close_source()


def _ask_unlock() -> str:
    return ask_password("Unlock the old drive", "\nEnter the passphrase for the old drive:")


def cmd_apply(args) -> int:
    if args.gauge:
        gauge = Gauge()
        try:
            # A gauge dialog is on screen instead of a terminal reading
            # ordinary input, so the passphrase (if one is still needed) has
            # to come from its own dialog too, never from raw stdin.
            code, text = apply_plan(Path(args.plan), out=gauge, only=args.only, skip=args.skip,
                                     passphrase=_ask_unlock)
        finally:
            gauge.close()
        message("Done" if code == EXIT_OK else "Not finished", "\n" + text)
        return code
    try:
        code, text = apply_plan(Path(args.plan), out=sys.stdout, only=args.only, skip=args.skip,
                                passphrase=passphrase_once(), listen=True)
    except Paused:
        emit("result", "paused", PAUSED_TEXT)
        return EXIT_PAUSED
    emit("result", "ok" if code == EXIT_OK else "failed", text)
    return code


PAUSED_TEXT = "The old drive is unmounted and safe to unplug. Resuming carries on from where this stopped."


def cmd_plan(args) -> int:
    try:
        return interactive_plan(args.source, firstboot=args.firstboot, keep_open=args.keep_open,
                                out_path=Path(args.out))
    except Cancelled:
        close_source()
        return EXIT_FAILED
    except SourceError as exc:
        close_source()
        message("Could not open the source", "\n" + str(exc))
        return EXIT_FAILED


def cmd_restore(args) -> int:
    plan_path = PLAN_DIR / "plan.json"
    try:
        code = interactive_plan(args.source, firstboot=False, keep_open=True, out_path=plan_path)
    except Cancelled:
        close_source()
        return EXIT_FAILED
    except SourceError as exc:
        close_source()
        message("Could not open the source", "\n" + str(exc))
        return EXIT_FAILED
    if code != EXIT_OK:
        return code
    gauge = Gauge()
    try:
        code, text = apply_plan(plan_path, out=gauge, passphrase=_ask_unlock)
    finally:
        gauge.close()
        plan_path.unlink(missing_ok=True)
    message("Done" if code == EXIT_OK else "Not finished", "\n" + text)
    return code


def cmd_close(args) -> int:
    close_source()
    return EXIT_OK


# portlin-install's apt flags: never a prompt or a conffile question, and a
# wait rather than a failure while something else holds the lock.
APT = (
    "apt-get", "-y", "-q",
    "-o", "Dpkg::Options::=--force-confdef",
    "-o", "Dpkg::Options::=--force-confold",
    "-o", "DPkg::Lock::Timeout=300",
)


def parse_policy_candidates(text: str) -> set[str]:
    """The names apt-cache policy gives an installable candidate. A name apt
    has never heard of prints nothing at all; a virtual one says (none)."""
    available, name = set(), ""
    for line in text.splitlines():
        if line and not line[0].isspace() and line.endswith(":"):
            name = line[:-1]
        elif line.strip().startswith("Candidate:") and name:
            if line.split(":", 1)[1].strip() != "(none)":
                available.add(name)
    return available


def cmd_install_packages(args, run=subprocess.run) -> int:
    """Install packages by name from this stick's own sources.

    The old stick may have run another release or had third-party sources,
    and apt-get refuses a whole install over one name it cannot find, so
    the names are first checked against the refreshed lists and the ones
    missing are named in a warning rather than failing the rest.
    """
    names = [name for name in dict.fromkeys(args.names) if offerable_package(name)]
    for name in args.names:
        if not offerable_package(name):
            emit("warn", f"not a package name it can install: {name!r}")
    env = {**os.environ, "DEBIAN_FRONTEND": "noninteractive"}
    emit("step", "Refreshing the package lists")
    if run([*APT, "update"], stdin=subprocess.DEVNULL, env=env, check=False).returncode != 0:
        emit("result", "failed", "the package lists could not be refreshed; is there a network?")
        return EXIT_FAILED
    policy = run(["apt-cache", "policy", *names], stdin=subprocess.DEVNULL, capture_output=True,
                 text=True, env=env, check=False)
    available = [name for name in names if name in parse_policy_candidates(policy.stdout)]
    missing = [name for name in names if name not in available]
    if missing:
        emit("warn", "not in this stick's package sources, so not installed: " + ", ".join(missing))
    if not available:
        emit("result", "ok", "nothing to install")
        return EXIT_OK
    emit("step", f"Installing {', '.join(available)}")
    if run([*APT, "install", *available], stdin=subprocess.DEVNULL, env=env, check=False).returncode != 0:
        emit("result", "failed", "apt-get could not install them; the details say why")
        return EXIT_FAILED
    emit("result", "ok", f"installed {len(available)} package{'s' if len(available) != 1 else ''}")
    return EXIT_OK


def summary(count: int, target: Target, stamp: str, warnings: list[str]) -> str:
    text = f"Brought over {count} item{'s' if count != 1 else ''}."
    backup = Path("/") / target.home / BACKUP_DIRNAME / stamp if target.home else None
    if backup and backup.exists():
        text += f" Files that were replaced are under {backup}."
    if warnings:
        text += f" {len(warnings)} warning{'s' if len(warnings) != 1 else ''}; see {LOG}."
    return text


def cmd_export(args) -> int:
    target = local_target()
    inventory = build_inventory(Path("/"), dpkg_status=command_output(
        ["dpkg-query", "-W", "-f=${Package} ${db:Status-Status}\n"]
    ))
    stamp = stamp_now()
    destination = Path(args.file)
    if destination.is_dir():
        destination = destination / archive_name(inventory.hostname, stamp)
    # The manifest holds the password hash. Its directory is made private
    # before it is written, and it is removed again whatever tar did, so
    # nothing readable is left behind under /run.
    manifest_dir = PLAN_DIR / "export"
    manifest_dir.mkdir(parents=True, exist_ok=True)
    manifest_dir.chmod(0o700)
    steps = plan_export(inventory, Path("/"), destination, manifest_dir, stamp)
    try:
        result = run_steps(steps, total=sum(s.weight for s in steps))
    finally:
        (manifest_dir / MANIFEST).unlink(missing_ok=True)
    if not result.ok:
        emit("result", "failed", result.failure)
        return EXIT_FAILED
    try:
        destination.chmod(0o600)
        if target.user:
            os.chown(destination, target.uid, target.gid)
    except OSError:
        pass
    emit("result", "ok", f"Wrote {destination}. It holds the password hash and every saved "
                         "network password, so keep it somewhere only you can read.")
    return EXIT_OK


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="portlin-migrate")
    verbs = parser.add_subparsers(dest="verb", required=True)
    candidates = verbs.add_parser("candidates")
    candidates.add_argument("--json", action="store_true")
    inventory = verbs.add_parser("inventory")
    inventory.add_argument("source", nargs="?")
    inventory.add_argument("--json", action="store_true")
    inventory.add_argument("--firstboot", action="store_true")
    apply = verbs.add_parser("apply")
    apply.add_argument("--plan", required=True)
    apply.add_argument("--gauge", action="store_true", help="draw a whiptail gauge instead of printing")
    apply.add_argument("--only", nargs="+", metavar="ID", help="ids or categories to keep from the plan")
    apply.add_argument("--skip", nargs="+", metavar="ID", help="ids or categories to drop from the plan")
    export = verbs.add_parser("export")
    export.add_argument("file")
    plan = verbs.add_parser("plan")
    plan.add_argument("source", nargs="?")
    plan.add_argument("--out", required=True)
    plan.add_argument("--firstboot", action="store_true")
    plan.add_argument("--keep-open", action="store_true")
    restore = verbs.add_parser("restore")
    restore.add_argument("source", nargs="?")
    verbs.add_parser("close")
    install_packages = verbs.add_parser("install-packages")
    install_packages.add_argument("names", nargs="+")
    return parser


