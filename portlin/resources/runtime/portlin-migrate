    "plan": cmd_plan,
    "restore": cmd_restore,
    "close": cmd_close,
    "install-packages": cmd_install_packages,
}


def _interrupt(signum, frame) -> None:
    """Turn a termination signal into an exception, so the verb's own
    try/finally (closing the source, killing a running child) still runs
    instead of the process simply stopping mid-copy."""
    raise KeyboardInterrupt()


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    if os.geteuid() != 0:
        print("portlin-migrate must run as root", file=sys.stderr)
        return EXIT_PRIVILEGE
    signal.signal(signal.SIGTERM, _interrupt)
    signal.signal(signal.SIGINT, _interrupt)
    try:
        return VERBS[args.verb](args)
    except SourceError as exc:
        emit("result", "failed", str(exc))
        return EXIT_FAILED
    except KeyboardInterrupt:
        emit("result", "failed", "cancelled")
        return EXIT_FAILED
    except Paused:
        emit("result", "paused", PAUSED_TEXT)
        return EXIT_PAUSED
    except Cancelled:
        close_source()
        return EXIT_FAILED
    except (OSError, KeyError, ValueError) as exc:
        # A malformed or missing plan file, or a manifest that names an
        # unsafe path, ends the run cleanly rather than as a traceback with
        # no ::result line for the window to show.
        emit("result", "failed", str(exc))
        return EXIT_FAILED


if __name__ == "__main__":
    sys.exit(main())
