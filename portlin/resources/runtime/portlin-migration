        self.log.set_left_margin(10)
        self.log.set_top_margin(8)
        buffer = self.log.get_buffer()
        self.log_end = buffer.create_mark("end", buffer.get_end_iter(), False)
        log_scroller = Gtk.ScrolledWindow()
        log_scroller.set_size_request(-1, 150)
        log_scroller.add(self.log)
        self.details.add(log_scroller)
        page.pack_start(self.details, False, False, 0)

        buttons = Gtk.Box(spacing=8)
        self.again = Gtk.Button(label="Migrate something else")
        self.again.connect("clicked", lambda *_: self._refresh())
        buttons.pack_start(self.again, False, False, 0)
        self.close_button = Gtk.Button(label="Close")
        self.close_button.connect("clicked", lambda *_: self.close())
        buttons.pack_end(self.close_button, False, False, 0)
        self.resume_button = _classed(Gtk.Button(label="Resume"), "suggested-action")
        self.resume_button.connect("clicked", lambda *_: self._resume())
        self.resume_button.get_child().show()
        self.resume_button.set_no_show_all(True)
        buttons.pack_end(self.resume_button, False, False, 0)
        self.pause_button = Gtk.Button(label="Pause + Unmount")
        self.pause_button.set_tooltip_text("Stop after the file being copied, and unmount the old drive "
                                           "so it can be unplugged. Resume carries on from there.")
        self.pause_button.connect("clicked", lambda *_: self._pause())
        self.pause_button.get_child().show()
        self.pause_button.set_no_show_all(True)
        buttons.pack_end(self.pause_button, False, False, 0)
        page.pack_start(buttons, False, False, 0)
        return page

    # -- page one: where from ----------------------------------------------

    def _show_source(self) -> None:
        self._set_step(1, "Source")
        self.stack.set_visible_child_name("source")

    def _set_source_state(self, name: str) -> None:
        self.source_state.set_visible_child_name(name)
        if name == "loading":
            self.source_spinner.start()
        else:
            self.source_spinner.stop()

    def _refresh(self) -> None:
        if self.job is not None:
            return
        self._check_unfinished()
        self._show_source()
        self.loading_text.set_text("Looking for portlin drives and backups...")
        self._set_source_state("loading")
        self.collected = []
        self._run(candidates_argv(passwordless_sudo=self.passwordless_sudo), on_done=self._on_candidates)

    def _on_candidates(self, code: int) -> None:
        for child in self.sources.get_children():
            self.sources.remove(child)
        self.candidates = []
        if code != EXIT_OK:
            self.sources_note.set_text(self.last_failure or explain_exit(code))
            self._set_source_state("empty")
            return
        try:
            self.candidates = json.loads("\n".join(self.collected))
        except ValueError:
            self.sources_note.set_text("The tool did not answer with a list.")
            self._set_source_state("empty")
            return
        for candidate in self.candidates:
            self.sources.add(self._source_card(candidate))
        self.sources.show_all()
        if self.candidates:
            self.sources.select_row(self.sources.get_row_at_index(0))
            self._set_source_state("list")
        else:
            self.sources_note.set_text(
                "No other portlin drive and no backup was found.\nPlug one in, then refresh."
            )
            self._set_source_state("empty")

    def _choose_archive(self) -> None:
        if self.job is not None:
            return
        dialog = Gtk.FileChooserDialog(title="Choose a backup archive", parent=self,
                                       action=Gtk.FileChooserAction.OPEN)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Open", Gtk.ResponseType.OK)
        pattern = Gtk.FileFilter()
        pattern.set_name("portlin backups")
        pattern.add_pattern("*.portlin-backup.tar.zst")
        dialog.add_filter(pattern)
        if dialog.run() == Gtk.ResponseType.OK:
            path = dialog.get_filename()
            self.candidate = {"kind": "archive", "path": path, "model": Path(path).parent.name,
                              "size": "", "encrypted": False, "version": ""}
            dialog.destroy()
            self._open(self.candidate)
            return
        dialog.destroy()

    def _open_selected(self) -> None:
        if self.job is not None:
            return
        row = self.sources.get_selected_row()
        if row is None:
            return
        self._open(row.candidate)

    def _open(self, candidate: dict) -> None:
        self.candidate = candidate
        self.passphrase = None
        if candidate.get("encrypted"):
            self.passphrase = self._ask_passphrase()
            if self.passphrase is None:
                return
        self.loading_text.set_text(f"Reading what {card_text(candidate)[0]} holds...")
        self._set_source_state("loading")
        self.collected = []
        self._run(
            inventory_argv(candidate["path"], passwordless_sudo=self.passwordless_sudo),
            on_done=self._on_inventory,
            stdin_text=self.passphrase,
        )

    def _ask_passphrase(self) -> str | None:
        dialog = Gtk.Dialog(title="Unlock the old drive", transient_for=self, modal=True)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Unlock", Gtk.ResponseType.OK)
        box = dialog.get_content_area()
        box.set_spacing(8)
        for side in ("start", "end", "top", "bottom"):
            getattr(box, f"set_margin_{side}")(12)
        box.add(Gtk.Label(label="Enter the passphrase for the old drive:", xalign=0.0))
        entry = Gtk.Entry(visibility=False, activates_default=True)
        box.add(entry)
        dialog.set_default_response(Gtk.ResponseType.OK)
        dialog.show_all()
        answer = entry.get_text() if dialog.run() == Gtk.ResponseType.OK else None
        dialog.destroy()
        return answer

    def _on_inventory(self, code: int) -> None:
        if code != EXIT_OK:
            self.passphrase = None
            self.sources_note.set_text(self.last_failure or explain_exit(code))
            self._set_source_state("empty")
            return
        try:
            text = "\n".join(self.collected)
            inventory = from_json(text)
            self.inventory_data = json.loads(text)
        except (ValueError, KeyError, TypeError):
            self.sources_note.set_text("The tool did not answer with an inventory.")
            self._set_source_state("empty")
            return
        self._set_source_state("list")
        self.store.clear()
        self.item_bytes = {item.id: item.bytes for item in inventory.items}
        for category, heading, rows in tree_rows(inventory):
            all_on = all(on for _, _, _, on in rows)
            any_on = any(on for _, _, _, on in rows)
            parent = self.store.append(None, [category, heading, "", all_on, any_on and not all_on, True])
            for item_id, label, size, on in rows:
                self.store.append(parent, [item_id, label, size, on, False, False])
        self.tree.expand_all()
        self.tree.get_selection().set_mode(Gtk.SelectionMode.NONE)
        title, subtitle = card_text(self.candidate)
        self.choose_sub.set_text(f"From {title}  ·  {subtitle}")
        self._update_space()
        self._set_step(2, "Choose")
        self.stack.set_visible_child_name("choose")

    # -- page two: what to bring -------------------------------------------

    def _on_toggled(self, renderer, path) -> None:
        row = self.store.get_iter(path)
        on = not self.store[row][3]
        self.store[row][3] = on
        self.store[row][4] = False
        if self.store[row][5]:
            child = self.store.iter_children(row)
            while child is not None:
                self.store[child][3] = on
                child = self.store.iter_next(child)
        else:
            parent = self.store.iter_parent(row)
            states = []
            child = self.store.iter_children(parent)
            while child is not None:
                states.append(self.store[child][3])
                child = self.store.iter_next(child)
            self.store[parent][3] = all(states)
            self.store[parent][4] = any(states) and not all(states)
        self._update_space()

    def _chosen_ids(self) -> list[str]:
        ids = []
        parent = self.store.get_iter_first()
        while parent is not None:
            child = self.store.iter_children(parent)
            while child is not None:
                if self.store[child][3]:
                    ids.append(self.store[child][0])
                child = self.store.iter_next(child)
            parent = self.store.iter_next(parent)
        return ids

    def _update_space(self) -> None:
        ids = self._chosen_ids()
        selected = sum(self.item_bytes.get(item_id, 0) for item_id in ids)
        count = f"{len(ids)} item" + ("s" if len(ids) != 1 else "")
        self.selection_text.set_text(f"{count} · {human(selected)} selected")
        try:
            disk = shutil.disk_usage("/")
        except OSError:
            self.space_text.set_text("")
            return
        text, fits = space_summary(selected, disk.free)
        self.space_text.set_text(text)
        context = self.space_text.get_style_context()
        (context.remove_class if fits else context.add_class)("amber")
        self.space_meter.update(disk.used, selected, disk.total)
        self.start_button.set_sensitive(bool(ids))

    def _start_apply(self) -> None:
        if self.job is not None:
            return
        ids = self._chosen_ids()
        if not ids:
            self.choose_note.set_text("Nothing is ticked.")
            return
        self.run_plan = plan_document(self.candidate, ids, self.inventory_data)
        write_plan_file(PLAN_PATH, self.run_plan)
        title, _ = card_text(self.candidate)
        self._launch_apply(f"from {title}")

    def _resume(self) -> None:
        """Run a plan left by a paused or stopped copy again. rsync skips
        what already came over, so this carries on rather than starts over."""
        if self.job is not None:
            return
        plan = read_plan_file(PLAN_PATH)
        if plan is None:
            self._check_unfinished()
            return
        self.passphrase = None
        if plan.get("encrypted"):
            self.passphrase = self._ask_passphrase()
            if self.passphrase is None:
                return
        self.run_plan = plan
        self._launch_apply(f"from {plan.get('label') or plan['source']}, resumed")

    def _launch_apply(self, subtitle: str) -> None:
        self._begin_run("apply", "Bringing things over", subtitle)
        argv = apply_argv(str(PLAN_PATH), passwordless_sudo=self.passwordless_sudo)
        self._append(f"$ {shlex.join(argv)}")
        # A drive only: the tool never mounted an archive's drive to unmount
        # it, and a tar restore cannot carry on where it stopped.
        if (self.run_plan or {}).get("kind") == "stick":
            self.pause_button.set_label("Pause + Unmount")
            self.pause_button.set_sensitive(True)
            self.pause_button.show()
        self._run(argv, on_done=self._on_applied, stdin_text=self.passphrase, show=True, keep_open=True)

    def _pause(self) -> None:
        if self.job is None or not self.job.send("pause\n"):
            return
        self.pause_button.set_label("Pausing...")
        self.pause_button.set_sensitive(False)
        self._append("== Pausing: stopping the copy and unmounting the old drive")

    def _on_applied(self, code: int) -> None:
        self.passphrase = None
        self.again.set_sensitive(True)
        self.pause_button.hide()
        ok = code == EXIT_OK
        paused = code == EXIT_PAUSED
        if self.run_kind == "apply":
            if ok:
                PLAN_PATH.unlink(missing_ok=True)
            else:
                # The plan stays either way: a failing drive or a pulled cable
                # is exactly when carrying on is worth more than starting over.
                self.resume_button.set_label("Resume" if paused else "Try again")
                self.resume_button.show()
        if paused:
            message = self.result_text or explain_exit(code)
        else:
            message = "" if ok else (self.last_failure or explain_exit(code))
        if self.tracker is not None:
            self.tracker.finish(ok, message, paused=paused)
        if not ok and not paused and message != self.last_failure:
            self._append(message)
        self._render_run()
        self._stop_clock()

    # -- backing up --------------------------------------------------------

    def _export(self) -> None:
        if self.job is not None:
            return
        dialog = Gtk.FileChooserDialog(title="Back up this stick to", parent=self,
                                       action=Gtk.FileChooserAction.SELECT_FOLDER)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Back up here", Gtk.ResponseType.OK)
        if dialog.run() != Gtk.ResponseType.OK:
            dialog.destroy()
            return
        folder = dialog.get_filename()
        dialog.destroy()
        self._begin_run("export", "Backing up this stick", f"to {folder}")
        argv = export_argv(folder, passwordless_sudo=self.passwordless_sudo)
        self._append(f"$ {shlex.join(argv)}")
        self._run(argv, on_done=self._on_applied, show=True)

    # -- page three: the copy ----------------------------------------------

    def _begin_run(self, kind: str, title: str, subtitle: str) -> None:
        self.run_kind = kind
        self.tracker = RunTracker()
        self.result_text = ""
        for child in self.stage_list.get_children():
            self.stage_list.remove(child)
        self.stage_rows = []
        self.log.get_buffer().set_text("")
        self.details.set_label("Details")
        self.strip.reset()
        self.status_title.set_text(title)
        self.status.set_text(subtitle)
        self.run_subtitle = subtitle
        self.again.set_sensitive(False)
        self.resume_button.hide()
        self.pause_button.hide()
        self.close_button.get_style_context().remove_class("suggested-action")
        self._set_step(3, "Copy")
        self.stack.set_visible_child_name("progress")
        self._render_run()
        self._start_clock()

    def _start_clock(self) -> None:
        """A frame tick for the strip's easing and sweep and the active
        mark's pulse, and a once-a-second tick for the elapsed time."""
        self._stop_clock()
        if self._tick_id:
            if HAVE_CAIRO:
                self.remove_tick_callback(self._tick_id)
            else:
                GLib.source_remove(self._tick_id)
        self._last_frame = None
        if HAVE_CAIRO:
            self._tick_id = self.add_tick_callback(self._on_frame)
        else:
            self._tick_id = GLib.timeout_add(50, self._on_timer)
        self._second_id = GLib.timeout_add_seconds(1, self._on_second)

    def _stop_clock(self) -> None:
        # The strip keeps easing to its last reading after the run ends;
        # _on_frame removes itself once it has arrived.
        if self._second_id:
            GLib.source_remove(self._second_id)
            self._second_id = 0

    def _on_frame(self, widget, clock) -> bool:
        now = clock.get_frame_time() / 1_000_000
        seconds = 0.0 if self._last_frame is None else min(0.1, now - self._last_frame)
        self._last_frame = now
        return self._animate(seconds)

    def _on_timer(self) -> bool:
        return self._animate(0.05)

    def _animate(self, seconds: float) -> bool:
        self.strip.advance(seconds)
        for row in self.stage_rows:
            row.mark.advance(seconds)
        self.percent_label.set_text(str(int(round(self.strip.shown * 100))))
        settled = abs(self.strip.target - self.strip.shown) < 0.0005
        if self.tracker is not None and self.tracker.outcome and settled:
            self._tick_id = 0
            return False
        return True

    def _on_second(self) -> bool:
        self._render_stats()
        return True

    def _render_run(self) -> None:
        tracker = self.tracker
        if tracker is None:
            return
        if len(self.stage_rows) != len(tracker.stages):
            for child in self.stage_list.get_children():
                self.stage_list.remove(child)
            self.stage_rows = [StageRow(stage) for stage in tracker.stages]
            for row in self.stage_rows:
                self.stage_list.add(row.row)
            self.stage_list.show_all()
        for index, (row, stage) in enumerate(zip(self.stage_rows, tracker.stages)):
            row.update(stage, self._stage_value(index), self._stage_detail(stage))
        self.strip.target = tracker.fraction()
        self.strip.edges = tracker.boundaries()
        if tracker.outcome:
            self.strip.state = tracker.outcome
            self.strip.refresh()
            self._render_outcome()
        else:
            active = tracker.stages[tracker.active].text if 0 <= tracker.active < len(tracker.stages) else "Starting..."
            self.phase_text.set_text(active)
        self._render_stats()

    def _stage_value(self, index: int) -> str:
        tracker = self.tracker
        stage = tracker.stages[index]
        if stage.state == "active":
            fraction = tracker.stage_fraction(index)
            return f"{int(fraction * 100)}%" if fraction is not None else ""
        if stage.state in ("done", "failed") and stage.started is not None and stage.finished is not None:
            return format_span(stage.finished - stage.started)
        return ""

    def _stage_detail(self, stage: Stage) -> str:
        if stage.detail and stage.state == "active":
            return stage.detail
        return human(stage.bytes) if stage.bytes else ""

    def _render_stats(self) -> None:
        tracker = self.tracker
        if tracker is None:
            return
        values = self.stat_values
        running = tracker.outcome is None
        rate = tracker.rate if running else tracker.average_rate()
        values["speed"].set_text(format_rate(rate) if rate else ("measuring" if running else "-"))
        remaining = tracker.remaining()
        if not running:
            values["left"].set_text("none" if tracker.outcome == "ok" else "-")
        elif remaining is not None:
            values["left"].set_text(format_remaining(remaining))
        elif tracker.total and tracker.copied >= tracker.total:
            values["left"].set_text("finishing")
        else:
            values["left"].set_text("estimating")
        values["elapsed"].set_text(format_clock(tracker.elapsed()))
        number, count = tracker.position()
        values["phase"].set_text(f"{number} of {count}" if count else "-")
        amount = f"{human(tracker.copied)} of {human(tracker.total)}" if tracker.total else ""
        if tracker.files:
            amount += f"{'  ·  ' if amount else ''}{tracker.files:,} files"
        self.amount_text.set_text(amount)
        if tracker.warnings:
            count = len(tracker.warnings)
            self.details.set_label(f"Details  ·  {count} warning{'s' if count != 1 else ''}")

    def _render_outcome(self) -> None:
        tracker = self.tracker
        if tracker.outcome == "ok":
            self.status_title.set_text("Backup written" if self.run_kind == "export" else "All brought over")
            parts = []
            if tracker.total:
                parts.append(f"{human(tracker.total)} in {format_clock(tracker.elapsed())}")
            if tracker.warnings:
                parts.append(f"{len(tracker.warnings)} warning{'s' if len(tracker.warnings) != 1 else ''}, see Details")
            self.status.set_text("  ·  ".join(parts) or self.run_subtitle)
            self.phase_text.set_text(self.result_text)
            self.percent_label.set_text("100")
            self.close_button.get_style_context().add_class("suggested-action")
        elif tracker.outcome == "paused":
            self.status_title.set_text("Paused")
            self.status.set_text(tracker.message)
            self.phase_text.set_text("")
        else:
            self.status_title.set_text("It stopped")
            self.status.set_text(tracker.message)
            self.phase_text.set_text("")
            self.details.set_expanded(True)

    # -- running the tool --------------------------------------------------

    def _run(self, argv, *, on_done, stdin_text: str | None = None, show: bool = False,
             keep_open: bool = False) -> None:
        self.collected = []
        self.last_failure = ""
        self.next_button.set_sensitive(False)
        self.refresh_button.set_sensitive(False)

        def on_output(line: str) -> None:
            if show:
                self._append(line)
            else:
                self.collected.append(line)

        def done(code: int) -> None:
            self.job = None
            self.next_button.set_sensitive(True)
            self.refresh_button.set_sensitive(True)
            on_done(code)

        try:
            self.job = Job(argv, on_event=self._on_event, on_output=on_output,
                           on_done=done, stdin_text=stdin_text, keep_open=keep_open)
        except OSError as exc:
            self.job = None
            self.next_button.set_sensitive(True)
            self.refresh_button.set_sensitive(True)
            message = f"Could not start {argv[0]}: {exc}"
            self.sources_note.set_text(message)
            if show and self.tracker is not None:
                self.tracker.finish(False, message)
                self._render_run()
                self._stop_clock()
            else:
                self._set_source_state("empty")

    def _append(self, line: str) -> None:
        buffer = self.log.get_buffer()
        buffer.insert(buffer.get_end_iter(), line + "\n")
        buffer.move_mark(self.log_end, buffer.get_end_iter())
        self.log.scroll_mark_onscreen(self.log_end)

    def _on_event(self, kind: str, rest: str) -> None:
        tracker = getattr(self, "tracker", None)
        if kind == "result":
            self._append(rest)
            if rest.startswith("ok "):
                self.result_text = rest[3:]
            elif rest.startswith("paused"):
                self.result_text = rest[len("paused"):].strip()
            elif rest.startswith("failed"):
                self.last_failure = rest[len("failed"):].strip()
            return
        if kind == "warn":
            self._append(f"warning: {rest}")
        if tracker is None:
            return
        handler = {
            "stages": tracker.on_stages,
            "step": tracker.on_step,
            "progress": tracker.on_progress,
            "bytes": tracker.on_bytes,
            "files": tracker.on_files,
            "warn": tracker.on_warn,
        }.get(kind)
        if handler is None:
            return
        handler(rest)
        if kind == "step":
            self._append(f"== {rest}")
        if kind in ("stages", "step", "warn"):
            self._render_run()
            self._scroll_to_active()
        else:
            self.strip.target = tracker.fraction()
            self._render_progress_rows()

    def _render_progress_rows(self) -> None:
        """The cheap update for the many byte events: the active row's
        figure and the amounts, not a pass over every row."""
        tracker = self.tracker
        index = tracker.active
        if 0 <= index < len(self.stage_rows):
            self.stage_rows[index].update(tracker.stages[index], self._stage_value(index),
                                          self._stage_detail(tracker.stages[index]))
        self._render_stats()

    def _scroll_to_active(self) -> None:
        tracker = self.tracker
        if not (0 <= tracker.active < len(self.stage_rows)):
            return
        row = self.stage_rows[tracker.active].row
        adjustment = self.stage_scroller.get_vadjustment()

        def scroll() -> bool:
            allocation = row.get_allocation()
            page = adjustment.get_page_size()
            if allocation.y < adjustment.get_value() or allocation.y + allocation.height > adjustment.get_value() + page:
                adjustment.set_value(max(0, allocation.y - page / 3))
            return False

        GLib.idle_add(scroll)


def install_css() -> None:
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS.encode())
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )


def main() -> int:
    application = Gtk.Application(application_id=APP_ID)
    windows: dict[str, MigrationWindow] = {}

    def on_activate(app) -> None:
        if "window" in windows:
            windows["window"].present()
            return
        Gtk.Window.set_default_icon_name(ICON_NAME)
        install_css()
        window = windows["window"] = MigrationWindow(application=app)
        window.show_all()
        # After show_all, which shows the banner whether or not there is
        # anything to resume.
        window._check_unfinished()

    application.connect("activate", on_activate)
    return application.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
