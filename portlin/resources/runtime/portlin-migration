class Job:
    """One portlin-migrate run, read line by line without blocking the window.

    ``stdin_text`` is the passphrase for an encrypted source, written and
    closed before the first line is read. It is also held, until the job it
    unlocks finishes, in ``MigrationWindow.passphrase``, by design: an apply
    started right after an inventory needs it again, and that field is
    cleared as soon as the job that was its last user is done.

    ``keep_open`` leaves stdin open after the passphrase, for ``send``: it is
    how an apply hears a pause.
    """

    def __init__(self, argv, *, on_event, on_output, on_done, stdin_text: str | None = None,
                 keep_open: bool = False) -> None:
        self.argv = argv
        self.on_event = on_event
        self.on_output = on_output
        self.on_done = on_done
        self.proc = subprocess.Popen(
            argv,
            stdin=subprocess.PIPE if stdin_text is not None or keep_open else subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
        )
        if stdin_text is not None:
            self.send(stdin_text + "\n")
        if not keep_open:
            self.close_input()
        GLib.io_add_watch(self.proc.stdout, GLib.PRIORITY_DEFAULT, GLib.IO_IN | GLib.IO_HUP, self._on_readable)

    def send(self, text: str) -> bool:
        """Write to the child's stdin. False when it is gone or closed: a
        child that exits before reading (a bad argument, an already-open
        source) still has to be reaped and reported, not raised past here."""
        if self.proc.stdin is None or self.proc.stdin.closed:
            return False
        try:
            self.proc.stdin.write(text)
            self.proc.stdin.flush()
            return True
        except (BrokenPipeError, OSError, ValueError):
            return False

    def close_input(self) -> None:
        if self.proc.stdin is not None and not self.proc.stdin.closed:
            try:
                self.proc.stdin.close()
            except (BrokenPipeError, OSError):
                pass

    def _on_readable(self, source, condition) -> bool:
        line = source.readline()
        if line:
            line = line.rstrip("\n")
            event = parse_event(line)
            if event:
                self.on_event(*event)
            else:
                self.on_output(line)
            return True
        self.proc.wait()
        self.close_input()
        self.on_done(self.proc.returncode)
        return False


