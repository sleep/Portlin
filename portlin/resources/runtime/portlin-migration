def elevation_argv(passwordless_sudo: bool) -> list[str]:
    """As in Software: pkexec draws a password dialog; someone who waived the
    sudo password at first boot has said they do not want one."""
    return ["sudo", "-n"] if passwordless_sudo else ["pkexec"]


def candidates_argv(*, passwordless_sudo: bool) -> list[str]:
    return [*elevation_argv(passwordless_sudo), TOOL, "candidates", "--json"]


def inventory_argv(source: str, *, passwordless_sudo: bool) -> list[str]:
    return [*elevation_argv(passwordless_sudo), TOOL, "inventory", source, "--json"]


def apply_argv(plan: str, *, passwordless_sudo: bool) -> list[str]:
    return [*elevation_argv(passwordless_sudo), TOOL, "apply", "--plan", plan]


def export_argv(destination: str, *, passwordless_sudo: bool) -> list[str]:
    return [*elevation_argv(passwordless_sudo), TOOL, "export", destination]


def parse_event(line: str) -> tuple[str, str] | None:
    if not line.startswith("::"):
        return None
    kind, _, rest = line[2:].partition(" ")
    return kind, rest.strip()


def explain_exit(code: int) -> str:
    if code == EXIT_OK:
        return ""
    if code == PKEXEC_REFUSED:
        return "Authentication was cancelled, so nothing was changed."
    if code == PKEXEC_NO_AGENT:
        return ("No authentication agent answered, so the password could not be "
                "asked for. Log out and in, or install mate-polkit.")
    if code == EXIT_PRIVILEGE:
        return "That was run with the wrong privileges. Nothing was changed."
    if code == EXIT_NO_SPACE:
        return "There is not enough free space on this drive for that selection. Nothing was copied."
    if code == EXIT_PAUSED:
        return "Paused. The old drive is unmounted and safe to unplug."
    return f"It did not finish (exit status {code}). The details say where it stopped."


def tree_rows(inventory: Inventory) -> list[tuple[str, str, list[tuple[str, str, str, bool]]]]:
    """(category, heading, [(id, label, size, ticked)]) for every category with items."""
    groups = []
    for category, heading in CATEGORIES:
        rows = []
        for item in inventory.items:
            if item.category != category:
                continue
            label = f"{item.label} ({item.note})" if item.note else item.label
            rows.append((item.id, label, human(item.bytes) if item.bytes else "", item.default))
        if rows:
            groups.append((category, heading, rows))
    return groups


def card_text(candidate: dict) -> tuple[str, str]:
    """A source as a card: what it is, then where and which portlin.

    describe() is the one-line form every front end shares; a card has room
    for two lines, so the same facts are split across them.
    """
    if candidate.get("kind") == "archive":
        where = f"backup on {candidate['model']}" if candidate.get("model") else "backup archive"
        return Path(candidate["path"]).name, where
    title = " ".join(part for part in (candidate.get("model"), candidate.get("size")) if part)
    version = f"portlin {candidate['version']}" if candidate.get("version") else "portlin"
    return title or candidate["path"], f"{version} · {candidate['path']}"


def plan_document(candidate: dict, ids: list[str], inventory_data: dict) -> dict:
    """The plan file apply reads. The passphrase is never in it: apply asks
    again on stdin, and this window hands over the one it already holds."""
    return {
        "source": candidate["path"],
        # Finds the drive again on resume if it comes back under another name.
        "uuid": candidate.get("uuid", ""),
        "kind": candidate["kind"],
        "encrypted": bool(candidate.get("encrypted")),
        "ids": list(ids),
        "firstboot": False,
        "label": describe(Candidate(**candidate)),
        "inventory": inventory_data,
    }


def write_plan_file(path: Path, plan: dict) -> None:
    """Write the plan 0600 from the moment it exists: it carries the old
    account's password hash by way of the inventory, and a window between
    creation and a later chmod is a window where the default umask governs
    a file worth more than that.

    ``touch`` leaves an existing file's mode alone, hence the belt-and-braces
    ``chmod`` after it: a stale plan from a previous run may already be
    sitting there with different permissions.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    path.touch(mode=0o600, exist_ok=True)
    path.chmod(0o600)
    path.write_text(json.dumps(plan, indent=2))


def read_plan_file(path: Path) -> dict | None:
    """A plan left by a run that was paused or stopped, or None."""
    try:
        plan = json.loads(path.read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(plan, dict) or not plan.get("source") or not isinstance(plan.get("ids"), list):
        return None
    return plan


def has_passwordless_sudo(run=subprocess.run) -> bool:
    try:
        return run(["sudo", "-n", "true"], stdin=subprocess.DEVNULL, capture_output=True, timeout=3).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def space_summary(selected: int, free: int) -> tuple[str, bool]:
    """The line under the space meter, and whether the selection fits."""
    if selected > free:
        return f"needs {human(selected - free)} more than is free here", False
    return f"{human(free - selected)} free here afterwards", True


# -- numbers, worded ---------------------------------------------------------


def format_clock(seconds: float) -> str:
    """Elapsed time as a stopwatch shows it: 0:07, 4:12, 1:02:09."""
    total = max(0, int(seconds))
    hours, rest = divmod(total, 3600)
    minutes, secs = divmod(rest, 60)
    return f"{hours}:{minutes:02}:{secs:02}" if hours else f"{minutes}:{secs:02}"


def format_remaining(seconds: float) -> str:
    """Time left, rounded the way a person says it, never to the second."""
    if seconds < 60:
        return "under a minute"
    minutes = math.ceil(seconds / 60)
    if minutes < 60:
        return f"about {minutes} min"
    hours, minutes = divmod(minutes, 60)
    return f"about {hours} h {minutes} min" if minutes else f"about {hours} h"


def format_span(seconds: float) -> str:
    """How long a finished phase took, for its row."""
    if seconds < 10:
        return f"{seconds:.1f} s"
    if seconds < 60:
        return f"{int(seconds)} s"
    return format_clock(seconds)


def format_rate(bytes_per_second: float) -> str:
    return f"{human(int(bytes_per_second))}/s"


# -- the run, from the protocol ---------------------------------------------


@dataclass
class Stage:
    text: str
    bytes: int = 0
    state: str = "pending"  # pending, active, done or failed
    started: float | None = None
    finished: float | None = None
    detail: str = ""


class RunTracker:
    """Everything the copy page shows, worked out from protocol events.

    No GTK here, so it is tested on its own; the window only draws what this
    says. The phases come from ::stages before the first one starts; a tool
    too old to send them still works, each ::step becoming a phase as it
    arrives. A ::step naming no phase ahead is a child speaking for itself
    (portlin-install inside "Installing ..."), and becomes that phase's detail.
    """

    def __init__(self, clock=time.monotonic) -> None:
        self.clock = clock
        self.started = clock()
        self.finished: float | None = None
        self.stages: list[Stage] = []
        self.outlined = False
        self.active = -1
        self.copied = 0
        self.total = 0
        self.percent = 0
        self.files: int | None = None
        self.warnings: list[str] = []
        self.outcome: str | None = None  # None while running, then "ok", "failed" or "paused"
        self.message = ""
        self.rate: float | None = None
        self._sample: tuple[float, int] | None = None

    # events

    def on_stages(self, rest: str) -> None:
        try:
            outline = json.loads(rest)
        except ValueError:
            return
        if not isinstance(outline, list):
            return
        self.stages = [
            Stage(str(entry.get("text", "")), int(entry.get("bytes") or 0))
            for entry in outline if isinstance(entry, dict)
        ]
        self.outlined = True
        if not self.total:
            self.total = sum(stage.bytes for stage in self.stages)

    def on_step(self, text: str) -> None:
        now = self.clock()
        if 0 <= self.active < len(self.stages) and self.stages[self.active].text == text:
            return  # The next path of the same item: still one phase.
        ahead = next((index for index in range(self.active + 1, len(self.stages))
                      if self.stages[index].text == text), None)
        if ahead is None and self.outlined:
            if self.active >= 0:
                self.stages[self.active].detail = text
            return
        if ahead is None:
            self.stages.append(Stage(text))
            ahead = len(self.stages) - 1
        self._close_active(now, "done")
        # Phases the run went past without announcing (a step with nothing
        # to do) are done too, or the list would show them waiting forever.
        for index in range(max(self.active, 0), ahead):
            if self.stages[index].state == "pending":
                self.stages[index].state = "done"
        self.active = ahead
        stage = self.stages[ahead]
        stage.state, stage.started = "active", now

    def on_progress(self, rest: str) -> None:
        if rest.isdigit():
            self.percent = min(100, int(rest))

    def on_bytes(self, rest: str) -> None:
        try:
            copied, total = (int(part) for part in rest.split()[:2])
        except ValueError:
            return
        now = self.clock()
        if self._sample is not None:
            then, before = self._sample
            if now - then < 0.5:
                self.copied, self.total = copied, total or self.total
                return
            sample = max(0, copied - before) / (now - then)
            self.rate = sample if self.rate is None else (
                self.rate * (1 - RATE_SMOOTHING) + sample * RATE_SMOOTHING
            )
        self._sample = (now, copied)
        self.copied, self.total = copied, total or self.total

    def on_files(self, rest: str) -> None:
        if rest.isdigit():
            self.files = int(rest)

    def on_warn(self, text: str) -> None:
        self.warnings.append(text)

    def finish(self, ok: bool, message: str = "", *, paused: bool = False) -> None:
        now = self.clock()
        self.finished = now
        self.outcome = "ok" if ok else "paused" if paused else "failed"
        self.message = message
        self._close_active(now, "done" if ok else self.outcome)
        if ok:
            for stage in self.stages:
                if stage.state == "pending":
                    stage.state = "done"
            self.copied = max(self.copied, self.total)

    def _close_active(self, now: float, state: str) -> None:
        if 0 <= self.active < len(self.stages):
            stage = self.stages[self.active]
            if stage.state == "active":
                stage.state, stage.finished = state, now

    # readings

    def elapsed(self) -> float:
        return (self.finished if self.finished is not None else self.clock()) - self.started

    def fraction(self) -> float:
        if self.outcome == "ok":
            return 1.0
        if self.total:
            return min(1.0, self.copied / self.total)
        return self.percent / 100

    def remaining(self) -> float | None:
        """Seconds left for the bytes still to copy, once there is a steady
        enough speed to say. None while it is too early, or nothing is left."""
        if self.outcome or not self.rate or self.copied >= self.total:
            return None
        if self.elapsed() < ESTIMATE_AFTER:
            return None
        return (self.total - self.copied) / self.rate

    def average_rate(self) -> float | None:
        """Bytes over the whole run, once it has run long enough for the
        figure to mean something."""
        elapsed = self.elapsed()
        return self.copied / elapsed if self.copied and elapsed >= 1 else None

    def stage_fraction(self, index: int) -> float | None:
        """How far through its own bytes a copying phase is."""
        stage = self.stages[index]
        if not stage.bytes:
            return None
        offset = sum(earlier.bytes for earlier in self.stages[:index])
        return min(1.0, max(0.0, (self.copied - offset) / stage.bytes))

    def boundaries(self) -> list[float]:
        """Where each copying phase ends along the whole, for the strip's
        dividers: the run drawn as a partition map of what it copies."""
        if not self.total:
            return []
        edges, running = [], 0
        sized = [stage.bytes for stage in self.stages if stage.bytes]
        for size in sized[:-1]:
            running += size
            edges.append(running / self.total)
        return edges

    def position(self) -> tuple[int, int]:
        """(phase number, phase count), counting from one."""
        return (max(self.active, 0) + 1 if self.stages else 0), len(self.stages)


# -- drawing -------------------------------------------------------------------


def _rgb(color: str) -> tuple[float, float, float]:
    return tuple(int(color[i:i + 2], 16) / 255 for i in (1, 3, 5))


def _rounded(cr, x: float, y: float, w: float, h: float, r: float) -> None:
    r = min(r, h / 2, w / 2)
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


class ProgressStrip:
    """The run's bar: a rounded track filled in a blue ramp, divided where
    each copying phase ends, with a soft light sweeping along the filled
    part while the run is live. The fill eases toward each new reading
    instead of jumping, and turns green when the run is done."""

    HEIGHT = 16

    def __init__(self) -> None:
        self.target = 0.0
        self.shown = 0.0
        self.edges: list[float] = []
        self.state = "running"
        self.sweep = 0.0
        if HAVE_CAIRO:
            self.widget = Gtk.DrawingArea()
            self.widget.set_size_request(-1, self.HEIGHT)
            self.widget.connect("draw", self._draw)
        else:
            self.widget = Gtk.ProgressBar()

    def reset(self) -> None:
        self.target = self.shown = 0.0
        self.edges = []
        self.state = "running"
        self.refresh()

    def advance(self, seconds: float) -> None:
        """One animation frame: ease toward the target and move the sweep."""
        self.shown += (self.target - self.shown) * min(1.0, seconds * 5)
        if abs(self.target - self.shown) < 0.0005:
            self.shown = self.target
        self.sweep = (self.sweep + seconds / 1.8) % 1.0
        self.refresh()

    def refresh(self) -> None:
        if HAVE_CAIRO:
            self.widget.queue_draw()
        else:
            self.widget.set_fraction(self.shown)

    def _draw(self, widget, cr) -> bool:
        width = widget.get_allocated_width()
        height = widget.get_allocated_height()
        radius = height / 2
        _rounded(cr, 0.5, 0.5, width - 1, height - 1, radius)
        cr.set_source_rgb(*_rgb(PANEL))
        cr.fill_preserve()
        cr.set_source_rgb(*_rgb(LINE))
        cr.set_line_width(1)
        cr.stroke()

        filled = width * self.shown
        if filled > 0:
            cr.save()
            _rounded(cr, 0, 0, width, height, radius)
            cr.clip()
            cr.rectangle(0, 0, max(filled, height), height)
            cr.clip()
            if self.state == "ok":
                stops = ("#3E9A70", GREEN, "#74D9AB")
            elif self.state == "failed":
                stops = ("#9C7434", AMBER, "#F0C97D")
            elif self.state == "paused":
                stops = ("#4A5566", MUTED, "#A5B2C2")
            else:
                stops = ("#3D7FB8", BLUE, "#83C4F2")
            ramp = cairo.LinearGradient(0, 0, max(filled, 1), 0)
            for offset, color in zip((0.0, 0.6, 1.0), stops):
                ramp.add_color_stop_rgb(offset, *_rgb(color))
            cr.set_source(ramp)
            cr.paint()
            # A gloss on the upper half, so the fill reads as lit from above.
            gloss = cairo.LinearGradient(0, 0, 0, height)
            gloss.add_color_stop_rgba(0, 1, 1, 1, 0.22)
            gloss.add_color_stop_rgba(0.5, 1, 1, 1, 0.04)
            gloss.add_color_stop_rgba(1, 1, 1, 1, 0)
            cr.set_source(gloss)
            cr.paint()
            if self.state == "running":
                band = width * 0.28
                x = -band + self.sweep * (filled + band * 2)
                light = cairo.LinearGradient(x, 0, x + band, 0)
                light.add_color_stop_rgba(0, 1, 1, 1, 0)
                light.add_color_stop_rgba(0.5, 1, 1, 1, 0.28)
                light.add_color_stop_rgba(1, 1, 1, 1, 0)
                cr.set_source(light)
                cr.paint()
            cr.restore()

        cr.set_source_rgb(*_rgb(INK))
        for edge in self.edges:
            x = round(width * edge)
            if 2 < x < width - 2:
                cr.rectangle(x - 1, 0, 2, height)
        cr.fill()
        return False


class StatusMark:
    """A phase's mark: a ring waiting, a pulsing blue dot under way, a green
    tick done, an amber cross where the run stopped, two bars where it was
    paused."""

    SIZE = 20
    GLYPHS = {"pending": "○", "active": "●", "done": "✓", "failed": "✕", "paused": "‖"}

    def __init__(self) -> None:
        self.state = "pending"
        self.pulse = 0.0
        if HAVE_CAIRO:
            self.widget = Gtk.DrawingArea()
            self.widget.set_size_request(self.SIZE, self.SIZE)
            self.widget.connect("draw", self._draw)
        else:
            self.widget = Gtk.Label(label=self.GLYPHS["pending"])
            self.widget.get_style_context().add_class("mark")
        self.widget.set_valign(Gtk.Align.CENTER)

    def set_state(self, state: str) -> None:
        if state == self.state:
            return
        self.state = state
        if HAVE_CAIRO:
            self.widget.queue_draw()
        else:
            self.widget.set_text(self.GLYPHS[state])

    def advance(self, seconds: float) -> None:
        if self.state == "active":
            self.pulse = (self.pulse + seconds / 1.4) % 1.0
            if HAVE_CAIRO:
                self.widget.queue_draw()

    def _draw(self, widget, cr) -> bool:
        size = min(widget.get_allocated_width(), widget.get_allocated_height())
        middle = size / 2
        radius = size / 2 - 2
        if self.state == "pending":
            cr.set_source_rgb(*_rgb(LINE))
            cr.set_line_width(1.5)
            cr.arc(middle, middle, radius - 1, 0, 2 * math.pi)
            cr.stroke()
            return False
        if self.state == "active":
            glow = 0.5 - 0.5 * math.cos(self.pulse * 2 * math.pi)
            cr.set_source_rgba(*_rgb(BLUE), 0.12 + 0.22 * glow)
            cr.arc(middle, middle, radius, 0, 2 * math.pi)
            cr.fill()
            cr.set_source_rgb(*_rgb(BLUE))
            cr.arc(middle, middle, radius * 0.42, 0, 2 * math.pi)
            cr.fill()
            return False
        if self.state == "paused":
            cr.set_source_rgb(*_rgb(MUTED))
            cr.arc(middle, middle, radius, 0, 2 * math.pi)
            cr.fill()
            cr.set_source_rgb(*_rgb(INK))
            bar = radius * 0.22
            for x in (middle - bar * 1.6, middle + bar * 0.6):
                cr.rectangle(x, middle - radius * 0.45, bar, radius * 0.9)
            cr.fill()
            return False
        color = GREEN if self.state == "done" else AMBER
        cr.set_source_rgb(*_rgb(color))
        cr.arc(middle, middle, radius, 0, 2 * math.pi)
        cr.fill()
        cr.set_source_rgb(*_rgb(INK))
        cr.set_line_width(2)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        unit = radius * 0.45
        if self.state == "done":
            cr.move_to(middle - unit, middle + unit * 0.05)
            cr.line_to(middle - unit * 0.25, middle + unit * 0.75)
            cr.line_to(middle + unit, middle - unit * 0.65)
        else:
            cr.move_to(middle - unit * 0.7, middle - unit * 0.7)
            cr.line_to(middle + unit * 0.7, middle + unit * 0.7)
            cr.move_to(middle + unit * 0.7, middle - unit * 0.7)
            cr.line_to(middle - unit * 0.7, middle + unit * 0.7)
        cr.stroke()
        return False


class SpaceMeter:
    """This drive as a bar: what is used now, what the selection would add,
    and what stays free. Amber where the selection does not fit."""

    def __init__(self) -> None:
        self.used = 0
        self.adding = 0
        self.total = 1
        if HAVE_CAIRO:
            self.widget = Gtk.DrawingArea()
            self.widget.set_size_request(-1, 10)
            self.widget.connect("draw", self._draw)
        else:
            self.widget = Gtk.LevelBar()

    def update(self, used: int, adding: int, total: int) -> None:
        self.used, self.adding, self.total = used, adding, max(total, 1)
        if HAVE_CAIRO:
            self.widget.queue_draw()
        else:
            self.widget.set_value(min(1.0, (used + adding) / self.total))

    def _draw(self, widget, cr) -> bool:
        width = widget.get_allocated_width()
        height = widget.get_allocated_height()
        _rounded(cr, 0, 0, width, height, height / 2)
        cr.set_source_rgb(*_rgb(LINE))
        cr.fill_preserve()
        cr.clip()
        used = width * min(1.0, self.used / self.total)
        adding = width * min(1.0, self.adding / self.total)
        cr.set_source_rgb(*_rgb(MUTED))
        cr.rectangle(0, 0, used, height)
        cr.fill()
        fits = self.used + self.adding <= self.total
        cr.set_source_rgb(*_rgb(BLUE if fits else AMBER))
        cr.rectangle(used, 0, min(adding, width - used) if fits else width - used, height)
        cr.fill()
        return False


