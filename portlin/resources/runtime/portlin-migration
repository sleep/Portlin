def _label(text: str = "", *classes: str, xalign: float = 0.0, wrap: bool = False) -> Gtk.Label:
    label = Gtk.Label(label=text, xalign=xalign)
    if wrap:
        label.set_line_wrap(True)
    for name in classes:
        label.get_style_context().add_class(name)
    return label


def _ellipsize(label: Gtk.Label) -> Gtk.Label:
    from gi.repository import Pango

    label.set_ellipsize(Pango.EllipsizeMode.END)
    return label


def _classed(widget, *classes: str):
    for name in classes:
        widget.get_style_context().add_class(name)
    return widget


class StageRow:
    """One phase in the copy page's list."""

    def __init__(self, stage: Stage) -> None:
        self.mark = StatusMark()
        self.text = _ellipsize(_label(stage.text, "stage-text"))
        self.detail = _ellipsize(_label("", "stage-detail"))
        self.value = _label("", "mono", "muted", xalign=1.0)
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        texts.set_valign(Gtk.Align.CENTER)
        texts.pack_start(self.text, False, False, 0)
        texts.pack_start(self.detail, False, False, 0)
        self.box = Gtk.Box(spacing=12)
        self.box.pack_start(self.mark.widget, False, False, 0)
        self.box.pack_start(texts, True, True, 0)
        self.box.pack_end(self.value, False, False, 0)
        self.row = Gtk.ListBoxRow(activatable=False, selectable=False)
        self.row.add(self.box)
        self.state = ""

    def update(self, stage: Stage, value: str, detail: str) -> None:
        if stage.state != self.state:
            context = self.box.get_style_context()
            if self.state:
                context.remove_class(f"stage-{self.state}")
            context.add_class(f"stage-{stage.state}")
            self.state = stage.state
            self.mark.set_state(stage.state)
        self.value.set_text(value)
        self.detail.set_text(detail)
        self.detail.set_visible(bool(detail))


