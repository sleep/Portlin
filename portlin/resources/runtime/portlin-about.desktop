[Desktop Entry]
Version=1.0
Type=Application
Name=About Portlin
Comment=What this stick is, and what it is running on
Exec=portlin-about
Icon=portlin
Terminal=false
StartupNotify=true
# The categories xfce4-about.desktop uses. X-Xfce-Toplevel keeps the entry
# out of a submenu and at the applications menu's root level, which is where
# About Xfce lives too, but not next to it: that placement, right above About
# Xfce at the bottom of the menu, comes from portlin-about.menu instead.
Categories=X-XFCE;X-Xfce-Toplevel;
Keywords=portlin;about;version;usb;stick;
