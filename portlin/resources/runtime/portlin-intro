# How many words fly past before the last one arrives. More than this and the
# middle of the film drags; the rest of the list is there so that dropping the
# scripts with no font still leaves enough.
FLYBY_COUNT = 13

# The timeline, in seconds from the first frame. Everything from the launch
# on is measured from the launch, which comes later when there is a drive to
# measure and a partition table to read.
GROUND_IN = (0.0, 1.4)
ENCLOSURE_DRAW = (0.7, 1.3)
BARS_START, BAR_STAGGER, BAR_GROW = 1.6, 0.26, 0.75
MEASURE = (3.3, 1.1)       # the mark slides aside and its bars take real sizes
ROW_START, ROW_GAP, ROW_TYPE = 3.8, 0.3, 0.45  # each lsblk row typing in
LAUNCH_AT = 4.6            # the mark lets go and root pulls away to the right
MEASURED_HOLD = 2.4        # how much later that is, with a table to read
LAUNCH_LENGTH = 1.1
WARP_LAG, WARP_RISE = 0.3, 1.6   # the streaks reach cruising speed
FLYBY_LAG, FLYBY_GAP, FLYBY_LIFE = 0.7, 0.78, 3.3
ARRIVAL = 3.2              # how long the last word takes to come to rest
REST_BAR = 1.3             # the root bar's run under it, once it has landed
