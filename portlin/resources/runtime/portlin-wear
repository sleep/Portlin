#!/usr/bin/env python3
"""Apply Portlin's storage-wear settings.

This deliberately accepts only named boolean settings: it is invoked through
pkexec, so it must not become a general-purpose root configuration editor.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

CONFIG = Path("/etc/portlin/wear.conf")
JOURNAL = Path("/etc/systemd/journald.conf.d/90-portlin-wear.conf")
APT = Path("/etc/apt/apt.conf.d/90portlin-wear")
DEFAULTS = {"journal": False, "portlin_logs": False, "maintenance": False,
            "ram_cache": True, "downloads": False}
TIMERS = ("apt-daily.timer", "apt-daily-upgrade.timer", "man-db.timer")


def settings() -> dict[str, bool]:
    value = DEFAULTS.copy()
    try:
        for line in CONFIG.read_text().splitlines():
            key, raw = line.split("=", 1)
            if key in value and raw in ("0", "1"):
                value[key] = raw == "1"
    except (OSError, ValueError):
        pass
    return value


def write_settings(value: dict[str, bool]) -> None:
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    text = "".join(f"{key}={int(value[key])}\n" for key in DEFAULTS)
    fd, name = tempfile.mkstemp(dir=CONFIG.parent, prefix=".wear-", text=True)
    with os.fdopen(fd, "w") as handle:
        handle.write(text)
    os.chmod(name, 0o644)
    os.replace(name, CONFIG)


def write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    os.chmod(path, 0o644)


def apply(value: dict[str, bool], changed: str) -> None:
    if changed == "journal":
        write(JOURNAL, "[Journal]\nStorage=" + ("persistent" if value["journal"] else "volatile") + "\n")
        subprocess.run(["systemctl", "restart", "systemd-journald.service"], check=False)
    elif changed == "downloads":
        write(APT, 'Binary::apt::APT::Keep-Downloaded-Packages "' + ("true" if value["downloads"] else "false") + '";\n')
    elif changed == "maintenance":
        command = ["systemctl", "enable" if value["maintenance"] else "disable", "--now", *TIMERS]
        subprocess.run(command, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main(argv: list[str]) -> int:
    if argv == ["status"]:
        print(json.dumps(settings(), sort_keys=True))
        return 0
    if len(argv) != 3 or argv[0] != "set" or argv[1] not in DEFAULTS or argv[2] not in ("0", "1"):
        print("usage: portlin-wear status | set SETTING 0|1", file=sys.stderr)
        return 2
    if os.geteuid() != 0:
        print("portlin-wear must run as root", file=sys.stderr)
        return 3
    value = settings()
    changed = argv[1]
    value[changed] = argv[2] == "1"
    write_settings(value)
    apply(value, changed)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
