"""A cup in the panel that stops the machine going to sleep.

A stick spends its life in other people's laptops, on power settings nobody
chose and cannot be bothered to change for one long copy. This is the switch
for that: click the cup, and nothing suspends, blanks or dims until it is
clicked again.

Keeping a machine awake takes three separate refusals, because each covers a
route to sleep the others do not reach. logind decides suspends, idle timers
and what a closing lid means, and a systemd-inhibit lock is what blocks all
three. The session's own screensaver and power manager blank the display
without ever consulting logind, and each has its own D-Bus inhibit call. The X
server underneath both has a blanking timer and a DPMS timer that answer to
neither, and only xset turns those off. Any one of the three alone leaves a
hole, and the hole is invisible until a machine sleeps anyway.
"""

from __future__ import annotations

import signal
import subprocess
import sys
import time
from dataclasses import dataclass, replace

sys.path.insert(0, "/usr/lib/portlin")

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")

from gi.repository import Gio, GLib, Gtk  # noqa: E402

from caffeine import (  # noqa: E402
    DURATIONS,
    ICONS,
    WHO,
    WHY,
    Settings,
    die_with_parent,
    duration_index,
    inhibit_argv,
    load_settings,
    save_settings,
    status_text,
)

APP_ID = "org.portlin.Caffeine"
# Stock names from the icon naming spec, used only if the SVGs in ICONS cannot be
# rasterised. Distinct in both directions, because a fallback that shows the
# same picture in both states is a switch with no indicator on it.
FALLBACK_ICONS = {True: "user-available", False: "user-idle"}


SUSPEND_BLANKING_ARGV = ["xset", "s", "off", "-dpms"]


@dataclass(frozen=True)
class SessionInhibitor:
    """One session service that has to be told separately to stop blanking."""

    name: str
    path: str
    interface: str


# The two the Xfce session runs. Neither sees the logind lock: that one stops
# the machine suspending, and these two are what stop the screen going dark
# while it stays awake.
SESSION_INHIBITORS = (
    SessionInhibitor(
        "org.freedesktop.ScreenSaver",
        "/org/freedesktop/ScreenSaver",
        "org.freedesktop.ScreenSaver",
    ),
    SessionInhibitor(
        "org.freedesktop.PowerManagement",
        "/org/freedesktop/PowerManagement/Inhibit",
        "org.freedesktop.PowerManagement.Inhibit",
    ),
)


def _numbers(line: str) -> list[int]:
    """The integers in an xset report line, in order."""
    values = []
    for field in line.replace(":", " ").split():
        try:
            values.append(int(field))
        except ValueError:
            continue
    return values


def parse_xset(text: str) -> dict:
    """Read the screen-blanking settings out of `xset q`.

    Read before changing them so they can be put back exactly. `xset s
    default` would be one line shorter and wrong: the numbers a person chose
    in the power manager are not the X server's compiled-in defaults, and
    turning caffeine off is not a reason to quietly replace one with the other.
    """
    saved: dict = {}
    for line in (line.strip() for line in text.splitlines()):
        if line.startswith("timeout:"):
            values = _numbers(line)
            if len(values) >= 2:
                saved["screensaver"] = (values[0], values[1])
        elif line.startswith("Standby:"):
            values = _numbers(line)
            if len(values) >= 3:
                saved["dpms"] = (values[0], values[1], values[2])
        elif line.startswith("DPMS is"):
            saved["dpms_enabled"] = line.endswith("Enabled")
    return saved


def restore_argv(saved: dict) -> list[str]:
    """The xset command that puts back what parse_xset read.

    Empty when there was nothing to read -- no xset on the system, or no
    display -- because restoring from an empty reading would invent timeouts
    nobody set.

    The +dpms/-dpms switch goes last on purpose: `xset dpms <standby>
    <suspend> <off>` turns DPMS on as a side effect of setting the numbers, so
    a -dpms written before them is undone by the very next argument.
    """
    argv: list[str] = []
    screensaver = saved.get("screensaver")
    if screensaver:
        argv += ["s", str(screensaver[0]), str(screensaver[1])]
    dpms = saved.get("dpms")
    if dpms:
        argv += ["dpms", *(str(value) for value in dpms)]
    enabled = saved.get("dpms_enabled")
    if enabled is not None:
        argv.append("+dpms" if enabled else "-dpms")
    return ["xset", *argv] if argv else []


class Caffeine:
    """The tray icon, and the three refusals it holds while it is active."""

    def __init__(self, settings: Settings, application) -> None:
        self.settings = settings
        self.application = application
        self.inhibitor: subprocess.Popen | None = None
        self.cookies: list[tuple[SessionInhibitor, int]] = []
        self.saved_screen: dict = {}
        self.expiry_source: int | None = None
        self.menu = None
        self.icon_size = 22
        # Paths already complained about. The panel repaints on every size
        # change and every toggle, so an unguarded message about a file that
        # is still broken is a line a second in the session log for as long as
        # the session lasts.
        self.icons_warned: set[str] = set()

        self.icon = Gtk.StatusIcon()
        self.icon.set_title("Caffeine")
        self.icon.connect("activate", lambda *_: self.toggle())
        self.icon.connect("popup-menu", self._on_popup)
        self.icon.connect("size-changed", self._on_size_changed)

        if self.settings.active:
            self._acquire()
        self._schedule_expiry()
        self._refresh()

    # -- the three refusals ------------------------------------------------

    def _bus(self):
        try:
            return Gio.bus_get_sync(Gio.BusType.SESSION, None)
        except GLib.Error:
            return None

    def _acquire(self) -> None:
        """Take every lock. Each is optional; between them one always lands."""
        if self.inhibitor is None:
            try:
                # Not start_new_session: staying in this process group means
                # the lock goes when the session does, on top of the death
                # signal armed above.
                self.inhibitor = subprocess.Popen(
                    inhibit_argv(WHY),
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    preexec_fn=die_with_parent,
                )
            except OSError as exc:
                print(f"portlin-caffeine: no logind lock: {exc}", file=sys.stderr)

        bus = self._bus()
        if bus is not None and not self.cookies:
            for service in SESSION_INHIBITORS:
                try:
                    result = bus.call_sync(
                        service.name,
                        service.path,
                        service.interface,
                        "Inhibit",
                        GLib.Variant("(ss)", (WHO, WHY)),
                        GLib.VariantType("(u)"),
                        Gio.DBusCallFlags.NONE,
                        5000,
                        None,
                    )
                except GLib.Error:
                    # Nothing is listening on that name. Expected on a session
                    # running neither, and covered by the xset call below.
                    continue
                self.cookies.append((service, result.unpack()[0]))

        if not self.saved_screen:
            self.saved_screen = parse_xset(self._xset_query())
        self._run(SUSPEND_BLANKING_ARGV)

    def _release(self) -> None:
        if self.inhibitor is not None:
            self.inhibitor.terminate()
            try:
                self.inhibitor.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.inhibitor.kill()
            self.inhibitor = None

        bus = self._bus()
        for service, cookie in self.cookies:
            if bus is None:
                break
            try:
                bus.call_sync(
                    service.name,
                    service.path,
                    service.interface,
                    "UnInhibit",
                    GLib.Variant("(u)", (cookie,)),
                    None,
                    Gio.DBusCallFlags.NONE,
                    5000,
                    None,
                )
            except GLib.Error:
                continue
        self.cookies = []

        self._run(restore_argv(self.saved_screen))
        self.saved_screen = {}

    @staticmethod
    def _xset_query() -> str:
        try:
            proc = subprocess.run(
                ["xset", "q"], capture_output=True, text=True, timeout=5
            )
        except (OSError, subprocess.SubprocessError):
            return ""
        return proc.stdout

    @staticmethod
    def _run(argv: list[str]) -> None:
        if not argv:
            return
        try:
            subprocess.run(argv, check=False, timeout=5)
        except (OSError, subprocess.SubprocessError) as exc:
            print(f"portlin-caffeine: {argv[0]} failed: {exc}", file=sys.stderr)

    # -- state -------------------------------------------------------------

    def toggle(self) -> None:
        if self.settings.active:
            self.set_active(False)
        else:
            self.set_active(True, self.settings.default_duration)

    def set_active(self, active: bool, duration: int | None = None) -> None:
        deadline = time.time() + duration if active and duration else None
        self.settings = replace(self.settings, active=active, deadline=deadline)
        if active:
            self._acquire()
        else:
            self._release()
        self._schedule_expiry()
        self._refresh()
        save_settings(self.settings)

    def _schedule_expiry(self) -> None:
        """Wake once, when the countdown ends, rather than ticking to find out."""
        if self.expiry_source is not None:
            GLib.source_remove(self.expiry_source)
            self.expiry_source = None
        if not (self.settings.active and self.settings.deadline):
            return
        remaining = max(1, int(self.settings.deadline - time.time()))
        self.expiry_source = GLib.timeout_add_seconds(remaining, self._on_expiry)

    def _on_expiry(self) -> bool:
        self.expiry_source = None
        self.set_active(False)
        if self.settings.notify_on_expiry:
            self._notify(
                "Caffeine has turned off",
                "The time you set has run out. This machine can sleep again.",
            )
        return GLib.SOURCE_REMOVE

    def _notify(self, summary: str, body: str) -> None:
        """Say so over the session bus the applet is already speaking.

        Rather than libnotify, which would add a gir dependency to
        portlin-desktop for one string, and rather than nothing: a timed
        session ending in silence is a machine that changed behaviour with no
        explanation on screen.
        """
        bus = self._bus()
        if bus is None:
            return
        try:
            bus.call_sync(
                "org.freedesktop.Notifications",
                "/org/freedesktop/Notifications",
                "org.freedesktop.Notifications",
                "Notify",
                GLib.Variant(
                    "(susssasa{sv}i)",
                    (WHO, 0, ICONS[False], summary, body, [], {}, 8000),
                ),
                None,
                Gio.DBusCallFlags.NONE,
                5000,
                None,
            )
        except GLib.Error:
            pass

    # -- the icon and its menu ---------------------------------------------

    def _on_size_changed(self, _icon, size: int) -> bool:
        self.icon_size = size
        self._refresh()
        return True

    def _refresh(self) -> None:
        active = self.settings.active
        path = ICONS[active]
        try:
            from gi.repository import GdkPixbuf

            self.icon.set_from_pixbuf(
                GdkPixbuf.Pixbuf.new_from_file_at_scale(
                    path, self.icon_size, self.icon_size, True
                )
            )
        except Exception as exc:
            # A stick is a system people remove packages from, and a panel with
            # no cup in it is worse than a panel with the wrong cup in it. But
            # the substitution is silent from the panel's side: a cup is always
            # there and nothing says it is the wrong one, so a shipped drawing
            # that no longer loads looks like a drawing somebody chose. Said
            # once per path, that is a line in the log; said on every repaint
            # it is noise nobody reads on a machine with no librsvg at all.
            if path not in self.icons_warned:
                self.icons_warned.add(path)
                print(
                    f"portlin-caffeine: could not draw {path}: {exc}; "
                    f"falling back to {FALLBACK_ICONS[active]}",
                    file=sys.stderr,
                )
            self.icon.set_from_icon_name(FALLBACK_ICONS[active])
        self.icon.set_tooltip_text(
            status_text(active, self.settings.deadline, time.time())
        )

    def _on_popup(self, icon, button: int, activate_time: int) -> None:
        # Kept on the instance, not in a local: the only reference to a menu
        # built here is the Python one, and letting it fall out of scope
        # destroys the menu at the moment it is being shown.
        menu = self.menu = self._build_menu()
        menu.show_all()
        menu.popup(None, None, Gtk.StatusIcon.position_menu, icon, button, activate_time)

    def _build_menu(self) -> Gtk.Menu:
        """Built fresh on every click, so the countdown in it is never stale."""
        menu = Gtk.Menu()

        header = Gtk.MenuItem(
            label=status_text(
                self.settings.active, self.settings.deadline, time.time()
            )
        )
        header.set_sensitive(False)
        menu.append(header)
        menu.append(Gtk.SeparatorMenuItem())

        about = Gtk.MenuItem(label="About Portlin")
        about.connect("activate", lambda *_: self._run(["portlin-about"]))
        menu.append(about)

        preferences = Gtk.MenuItem(label="Preferences...")
        preferences.connect("activate", lambda *_: self._open_preferences())
        menu.append(preferences)
        menu.append(Gtk.SeparatorMenuItem())

        activate_for = Gtk.MenuItem(label="Activate for")
        submenu = Gtk.Menu()
        for seconds, label in DURATIONS:
            item = Gtk.MenuItem(label=label)
            item.connect(
                "activate", lambda _item, s=seconds: self.set_active(True, s)
            )
            submenu.append(item)
        activate_for.set_submenu(submenu)
        menu.append(activate_for)
        menu.append(Gtk.SeparatorMenuItem())

        quit_item = Gtk.MenuItem(label="Quit")
        quit_item.connect("activate", lambda *_: self.quit())
        menu.append(quit_item)
        return menu

    def _open_preferences(self) -> None:
        dialog = Gtk.Dialog(title="Caffeine Preferences")
        dialog.add_button("Close", Gtk.ResponseType.CLOSE)
        dialog.set_border_width(12)
        box = dialog.get_content_area()
        box.set_spacing(8)

        restore = Gtk.CheckButton(label="Restore the last state when I log in")
        restore.set_active(self.settings.restore_at_login)
        box.pack_start(restore, False, False, 0)

        notify = Gtk.CheckButton(label="Tell me when a timed session runs out")
        notify.set_active(self.settings.notify_on_expiry)
        box.pack_start(notify, False, False, 0)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row.pack_start(Gtk.Label(label="Clicking the cup activates for"), False, False, 0)
        chooser = Gtk.ComboBoxText()
        for _, label in DURATIONS:
            chooser.append_text(label)
        chooser.set_active(duration_index(self.settings.default_duration))
        row.pack_start(chooser, False, False, 0)
        box.pack_start(row, False, False, 0)

        def apply(*_args):
            self.settings = replace(
                self.settings,
                restore_at_login=restore.get_active(),
                notify_on_expiry=notify.get_active(),
                default_duration=DURATIONS[chooser.get_active()][0],
            )
            save_settings(self.settings)
            dialog.destroy()

        # Closing the window sends a response too, so there is no path out of
        # this dialog that skips saving what was ticked in it.
        dialog.connect("response", apply)
        dialog.show_all()

    def quit(self) -> None:
        """Give the machine back before going, whether asked to or killed."""
        self._release()
        save_settings(self.settings)
        self.application.quit()


def main() -> int:
    application = Gtk.Application(application_id=APP_ID)
    running: dict[str, Caffeine] = {}

    def on_activate(app) -> None:
        # Fired again when a second copy is launched from the menu: that
        # process exits and this one is asked to show itself. There is nothing
        # to raise -- a tray icon is always visible -- and building a second
        # one would put two cups in the panel holding two sets of locks.
        if running:
            return
        app.hold()
        applet = running["applet"] = Caffeine(load_settings(), app)

        def on_signal() -> bool:
            # Logging out is the ordinary way this ends, and it arrives as a
            # signal rather than a click on Quit. Handled so the screen
            # settings are put back on the way out.
            applet.quit()
            return GLib.SOURCE_REMOVE

        for number in (signal.SIGINT, signal.SIGTERM):
            GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, number, on_signal)

    application.connect("activate", on_activate)
    return application.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
