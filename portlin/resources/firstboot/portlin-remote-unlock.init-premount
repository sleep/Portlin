#
# Start the SSH server for remote unlock, if there is a cable to answer on.
#
# Installed as /etc/initramfs-tools/scripts/init-premount/dropbear, where it
# takes the place of dropbear-initramfs's script of the same name: mkinitramfs
# copies the boot scripts under /etc into the initramfs after the ones under
# /usr/share, so the one here is the one that boots. It does the same job the
# same way -- the network and dropbear are brought up in the background, so
# someone at the keyboard can type the passphrase at once, and Debian's
# init-bottom script still stops them before the real system starts -- with
# one difference. Debian's starts DHCP whether or not a cable is plugged in.
# A stick is mostly booted in laptops with nothing in the ethernet port, and
# there that means minutes of "no response" over the passphrase prompt and,
# worse, up to a minute's wait after the passphrase is typed, while
# init-bottom gives the network its chance to come up before it can stop
# dropbear. So this looks for a link first, briefly, and starts nothing
# without one.
#
# Wi-Fi is not an option this early: the initramfs carries no wireless
# drivers and no supplicant. It is a cable or nothing.

PREREQ="udev"
prereqs() { echo "$PREREQ"; }
case "$1" in
    prereqs) prereqs; exit 0 ;;
esac

[ -x /sbin/dropbear ] || exit 0

. /scripts/functions

# portlin's switch and port, put here by the gate hook. Belt and braces: when
# the switch is off the hook has already left no dropbear behind.
CONF=/etc/portlin/remote-unlock.conf
grep -qsx 'enabled=1' "$CONF" || exit 0
PORT="$(sed -n 's/^port=//p' "$CONF" 2>/dev/null)"
case "$PORT" in
    '' | *[!0-9]*) PORT=2222 ;;
esac

# Debian's conffile. DROPBEAR_OPTIONS set there replaces portlin's, which are
# the port above, no port forwarding (-j -k), an idle timeout (-I), and the
# unlock prompt as the only thing a login can run. Password logins are off
# either way: -s is among the flags below, as in Debian's script.
if [ -e /etc/dropbear/dropbear.conf ]; then
    . /etc/dropbear/dropbear.conf
fi
: "${DROPBEAR_OPTIONS=-I 180 -j -k -p $PORT -c /bin/cryptroot-unlock}"

# How long a plugged-in cable gets to report a link once its interface is up.
# Autonegotiation takes a second or two; a USB adapter a few more.
LINK_WAIT=8

uptime_seconds() {
    read -r up _ < /proc/uptime
    echo "${up%.*}"
}

wait_for_link() {
    local device deadline
    # Carrier is only reported on an interface that is up. ipconfig would
    # bring them up itself, but it is not running yet.
    for device in /sys/class/net/*; do
        [ "${device##*/}" = lo ] && continue
        ip link set dev "${device##*/}" up 2>/dev/null || true
    done
    deadline=$(( $(uptime_seconds) + LINK_WAIT ))
    while :; do
        for device in /sys/class/net/*; do
            [ "${device##*/}" = lo ] && continue
            [ "$(cat "$device/carrier" 2>/dev/null)" = 1 ] && return 0
        done
        [ "$(uptime_seconds)" -ge "$deadline" ] && return 1
        sleep 1
    done
}

run_dropbear() {
    local flags="Fs"
    [ "$debug" != y ] || flags="E$flags" # log to standard error

    # Nothing to answer on. Silent, because a message here lands on top of
    # the passphrase prompt, which someone may be in the middle of typing.
    wait_for_link || exit 0

    configure_networking

    log_begin_msg "Starting dropbear"
    # exec, and in the foreground, so that init-bottom can tell this shell
    # from the server it becomes, and can stop whichever it finds.
    exec /sbin/dropbear -$flags ${DROPBEAR_OPTIONS-}
}

run_dropbear &
echo $! >/run/dropbear.pid
