#!/bin/sh
#
# Part of portlin. Copyright (C) 2026 the portlin authors.
# Licensed under the GNU General Public License, version 3 or later.
# See <https://www.gnu.org/licenses/gpl-3.0.html>.
#
# Offer to encrypt the root filesystem, from the initramfs, on first boot.
#
# This has to happen here and nowhere else. Adding a LUKS header shifts every
# byte of the filesystem forward to make room for it, so the device must not be
# mounted -- which rules out doing it from the running system. The initramfs is
# the only point where root exists as a block device but is not yet in use.
#
# Triggered by portlin.encrypt=ask on the kernel command line, which the write
# stage adds to unencrypted sticks and the first-boot wizard removes once this
# has run. That keeps the decision out of any file this script would have to
# mount something to read.

# No prereqs, and in particular not cryptroot. Debian's cryptroot names every
# other local-top script as its own prereq so that it always runs last, so
# naming it here is a cycle: tsort complains on every initramfs rebuild and
# picks an order arbitrarily. Running first is also the order this needs. It
# has to see the raw partition to encrypt or recover it, and when cryptroot
# follows it finds portlin_root already open and leaves it alone. Run after an
# unlock instead, it would see a plain filesystem and offer to encrypt it again.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
    prereqs) prereqs; exit 0 ;;
esac

. /scripts/functions

grep -qw 'portlin.encrypt=ask' /proc/cmdline || exit 0

# The splash would otherwise cover the prompt completely.
plymouth quit >/dev/null 2>&1 || true

# Overridable so the test harness can point this at a pty and drive the whole
# script without booting anything. Every bug found in this file so far was one a
# one-minute standalone run would have caught, versus a fifteen-minute emulated
# boot read off a photograph.
CONSOLE="${PORTLIN_CONSOLE:-/dev/console}"
say() { printf '%s\n' "$1" > "$CONSOLE"; }

# A line on this console is gone within a second of boot carrying on: quiet
# boot and the setup screen cover it. So every failure is also left in /run,
# which survives the pivot, for the first-boot wizard to show and log.
STATE_DIR=/run/portlin
record_failure() {
    (mkdir -p "$STATE_DIR" && printf '%s\n' "$1" > "$STATE_DIR/encrypt-failed") 2>/dev/null || true
}

# For failures after someone has answered yes, and so is at the keyboard.
fail() {
    say ""
    say "portlin: $1"
    record_failure "$1"
    printf 'Press Enter to continue. ' > "$CONSOLE"
    read -r _ < "$CONSOLE"
    say ""
}

# cryptsetup reencrypt rewrites every block of the partition, used or not, so
# the cost is the partition's size over the drive's write speed.
format_minutes() {
    if [ "$1" -lt 60 ]; then
        echo "$1 min"
    else
        echo "$(($1 / 60))h $(($1 % 60))m"
    fi
}

# Hand the passphrase to the first-boot wizard, which is minutes away and will
# need it to grow the LUKS mapping into the rest of the drive.
#
# On every later boot the crypttab keyscript does this. It cannot do it on this
# one: crypttab is written by portlin-finalise-encryption, in userspace, after
# the disk is already open, so on the boot the container is created this script
# is the only thing that ever holds the passphrase in the clear. Expansion runs
# on exactly this boot, and the volume key is unrecoverable once the initramfs
# is gone -- so without this the wizard has to ask for a passphrase typed a
# minute earlier at the same keyboard.
#
# Same terms as the keyscript: /run is tmpfs and is moved onto the real root at
# pivot, so the passphrase reaches the wizard without ever being written to the
# stick, and the wizard deletes it the moment it is spent. The umask covers the
# directory and the file in one go, leaving no moment where either exists at the
# default mode. Failure is silent and harmless: it costs the wizard one prompt,
# which is not worth risking the boot over.
stash_passphrase() {
    (
        umask 077
        mkdir -p /run/portlin && printf '%s' "$1" > /run/portlin/luks-pass
    ) 2>/dev/null || true
}

# Resolve the root device, trying every form the kernel command line can take.
# local-top runs before initramfs-tools does its own wait for the root device,
# and a USB stick takes a second or two to enumerate -- so on real hardware the
# first attempt reliably finds nothing. Virtio disks in a VM appear instantly,
# which is exactly why this only ever failed on the real thing.
resolve_root() {
    _dev=""
    _uuid=""
    case "$ROOT" in
        UUID=*)  _uuid="${ROOT#UUID=}";  _dev="/dev/disk/by-uuid/$_uuid" ;;
        LABEL=*) _dev="/dev/disk/by-label/${ROOT#LABEL=}" ;;
        /dev/*)  _dev="$ROOT" ;;
    esac
    if [ -b "$_dev" ]; then
        readlink -f "$_dev"
        return 0
    fi
    _dev="$(resolve_device "$ROOT" 2>/dev/null)" || _dev=""
    if [ -b "$_dev" ]; then
        echo "$_dev"
        return 0
    fi
    if [ -n "$_uuid" ]; then
        _dev="$(blkid -U "$_uuid" 2>/dev/null)" || _dev=""
        if [ -b "$_dev" ]; then
            echo "$_dev"
            return 0
        fi
    fi
    return 1
}

ROOT_DEV=""
attempt=0
while [ "$attempt" -lt 60 ]; do
    ROOT_DEV="$(resolve_root)" && break
    ROOT_DEV=""
    [ "$attempt" = 4 ] && say "portlin: waiting for the drive to appear..."
    sleep 0.5
    attempt=$((attempt + 1))
done

if [ -z "$ROOT_DEV" ] || [ ! -b "$ROOT_DEV" ]; then
    say "portlin: could not identify the root device after 30s, skipping encryption."
    record_failure "The drive holding the system could not be found within 30 seconds."
    exit 0
fi

# Already a LUKS container, yet portlin.encrypt=ask is still on the command
# line -- which only happens when a previous boot encrypted the drive but setup
# did not finish, so /etc/crypttab was never written and the initramfs has no
# idea how to unlock this. Nothing else will open it, and the boot would die in
# an initramfs shell. Unlock it here so the system comes up and setup can retry.
#
# Or the encryption itself was cut short, by a power cut or a pulled cable. The
# header then carries the online-reencrypt requirement until it is finished.
if cryptsetup isLuks "$ROOT_DEV" 2>/dev/null; then
    interrupted=""
    if cryptsetup luksDump "$ROOT_DEV" 2>/dev/null | grep -q 'online-reencrypt'; then
        interrupted=1
    fi
    say ""
    if [ -n "$interrupted" ]; then
        say "Portlin: encrypting this drive was interrupted last time."
        say "Enter the passphrase to finish it; the data is intact."
    else
        say "Portlin: this drive is encrypted but setup did not finish last time."
        say "Enter the passphrase to continue; setup will run again."
    fi
    attempt=0
    while [ "$attempt" -lt 3 ]; do
        attempt=$((attempt + 1))
        stty -echo < "$CONSOLE" 2>/dev/null
        printf 'Passphrase: ' > "$CONSOLE"
        read -r recover < "$CONSOLE"
        stty echo < "$CONSOLE" 2>/dev/null
        say ""
        if [ -n "$interrupted" ]; then
            # A crash mid-encryption leaves metadata that has to be repaired
            # before anything will open the device, and repair is also what
            # checks the passphrase here. The rest of the drive is then
            # encrypted from where it stopped; opening it half done would
            # leave the stick that way for good.
            if ! printf '%s' "$recover" | cryptsetup repair --key-file - "$ROOT_DEV" > /dev/null 2>&1; then
                say "That passphrase was not accepted."
                continue
            fi
            say "Resuming the encryption. Do not remove the drive or power off."
            if ! printf '%s' "$recover" | cryptsetup reencrypt --resume-only \
                    --key-file - --progress-frequency 5 "$ROOT_DEV" > "$CONSOLE" 2>&1; then
                fail "Resuming the encryption failed. Restart to try again."
                exit 0
            fi
            interrupted=""
        fi
        if printf '%s' "$recover" | cryptsetup open --key-file - "$ROOT_DEV" portlin_root; then
            ROOT=/dev/mapper/portlin_root
            export ROOT
            # Setup is about to run again, expansion and all, so it needs this
            # for the same reason the encrypt path below does.
            stash_passphrase "$recover"
            say "Unlocked. Continuing boot."
            exit 0
        fi
        say "That passphrase was not accepted."
    done
    say "Could not unlock the drive. Dropping to the initramfs shell."
    exit 0
fi

SECTORS="$(cat "/sys/class/block/$(basename "$ROOT_DEV")/size" 2>/dev/null)"
case "$SECTORS" in
    '' | *[!0-9]*) SECTORS=0 ;;
esac
SIZE_MIB=$((SECTORS / 2048))

say ""
say "======================================================================"
say "  Portlin: encrypt this drive?"
say ""
say "  Encrypting protects everything on the stick if it is lost or stolen."
say "  You will be asked for the passphrase every time it boots."
say ""
say "  It can only be done now, before the system starts, and it must not"
say "  be interrupted."
if [ "$SIZE_MIB" -gt 0 ]; then
    say ""
    say "  Every block of the $((SIZE_MIB / 1024)) GiB partition is rewritten, used or not:"
    say "  about $(format_minutes $((SIZE_MIB / 100 / 60 + 1))) on a fast drive, $(format_minutes $((SIZE_MIB / 20 / 60 + 1))) on a slow one."
fi
say ""
say "  Answering no is remembered. sudo portlin-encrypt offers it again."
say "======================================================================"
say ""

printf 'Encrypt this drive? [y/N] ' > "$CONSOLE"
read -r answer < "$CONSOLE"
case "$answer" in
    y | Y | yes | YES) ;;
    *)
        # portlin-finalise-encryption reads this and takes the offer off the
        # command line, so a declined drive is not asked on every boot.
        (mkdir -p "$STATE_DIR" && : > "$STATE_DIR/encrypt-declined") 2>/dev/null || true
        say "Continuing without encryption."
        exit 0
        ;;
esac

# Read the passphrase twice with echo off, and refuse to proceed until they
# match. Getting this wrong means an unopenable stick, so there is no "close
# enough" here.
attempt=0
chosen=""
while [ "$attempt" -lt 3 ]; do
    attempt=$((attempt + 1))
    stty -echo < "$CONSOLE" 2>/dev/null
    printf 'New passphrase: ' > "$CONSOLE"
    read -r pass1 < "$CONSOLE"
    printf '\nRepeat passphrase: ' > "$CONSOLE"
    read -r pass2 < "$CONSOLE"
    stty echo < "$CONSOLE" 2>/dev/null
    say ""

    if [ -z "$pass1" ] || [ "${#pass1}" -lt 8 ]; then
        say "Too short: use at least 8 characters."
        continue
    fi
    if [ "$pass1" != "$pass2" ]; then
        say "Those did not match."
        continue
    fi
    chosen=1
    break
done

if [ -z "$chosen" ]; then
    fail "No usable passphrase after three tries. Giving up on encryption; continuing unencrypted."
    exit 0
fi

# The LUKS2 header goes at the FRONT of the device, so making room for it shifts
# the filesystem forward and leaves less space than before. ext4 records its own
# size in the superblock and does not notice, so unless it is shrunk first it
# ends up believing it is larger than the device holding it -- and fsck refuses
# to mount it, dropping the machine to an initramfs shell. Shrinking must happen
# BEFORE the header is inserted; there is no fixing the order afterwards.
HEADER_BYTES=33554432  # 32 MiB, matching --reduce-device-size below

say "Preparing the filesystem. This must finish; do not power off."
e2fsck -f -y "$ROOT_DEV" > "$CONSOLE" 2>&1
status=$?
# 1 is "errors corrected", which leaves a clean filesystem.
if [ "$status" -gt 1 ]; then
    fail "Filesystem check failed (e2fsck exit $status); leaving the drive unencrypted."
    exit 0
fi

if [ "$SECTORS" -eq 0 ]; then
    fail "Could not measure $ROOT_DEV; leaving the drive unencrypted."
    exit 0
fi
TARGET_KIB=$(( (SECTORS * 512 - HEADER_BYTES) / 1024 ))

say "Shrinking the filesystem by 32 MiB to make room for the header."
if ! resize2fs "$ROOT_DEV" "${TARGET_KIB}K" > "$CONSOLE" 2>&1; then
    fail "Could not shrink the filesystem; leaving the drive unencrypted. Nothing has been changed."
    exit 0
fi

say ""
say "Encrypting $ROOT_DEV. Do not remove the drive or power off."
say "(Progress is shown below.)"
say ""

# --reduce-device-size makes room at the front for the LUKS2 header by shifting
# the filesystem, which is why the partition ends up slightly smaller. The
# argon2id cost is capped for the same reason it is capped at build time: the
# stick has to be openable on whatever low-RAM machine it meets next.
#
# No --batch-mode: besides skipping questions, it silences cryptsetup's progress
# output entirely, --progress-frequency included, leaving a blank screen for
# minutes. Encrypting with a key file asks nothing anyway.
if printf '%s' "$pass1" | cryptsetup reencrypt --encrypt \
        --type luks2 \
        --reduce-device-size 32M \
        --pbkdf argon2id \
        --pbkdf-memory 262144 \
        --iter-time 2000 \
        --cipher aes-xts-plain64 \
        --key-size 512 \
        --hash sha256 \
        --key-file - \
        --progress-frequency 5 \
        "$ROOT_DEV" > "$CONSOLE" 2>&1; then
    say ""
    say "Encryption complete. Unlocking and continuing boot."
elif cryptsetup isLuks "$ROOT_DEV" 2>/dev/null; then
    # The header is written and part of the drive is encrypted, so the plain
    # filesystem is gone and this boot cannot go on. The next one finds the
    # interrupted encryption above and finishes it.
    fail "Encryption stopped partway. The data is intact: restart and enter the passphrase to finish."
    reboot -f 2>/dev/null || echo b > /proc/sysrq-trigger
    exit 0
else
    fail "Encryption failed before it changed anything; continuing unencrypted."
    exit 0
fi

if ! printf '%s' "$pass1" | cryptsetup open --key-file - "$ROOT_DEV" portlin_root; then
    fail "Could not open the new container. Restart and enter the passphrase."
    exit 0
fi

# initramfs-tools sources this script, so reassigning ROOT redirects the rest of
# boot at the unlocked mapping instead of the now-encrypted raw partition.
ROOT=/dev/mapper/portlin_root
export ROOT

stash_passphrase "$pass1"

# Breadcrumb for the first-boot wizard, which finishes the job in userspace:
# writes crypttab, rebuilds the initramfs and drops portlin.encrypt=ask so the
# next boot unlocks normally.
mkdir -p /run/portlin
: > /run/portlin/just-encrypted
