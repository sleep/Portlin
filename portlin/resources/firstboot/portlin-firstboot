def step_welcome() -> None:
    message(
        "Welcome to Portlin",
        "\nThis stick is a full Debian system with an Xfce desktop, and it "
        "carries its changes with it from machine to machine.\n\n"
        "Setting it up takes a minute. Nothing is written until the last step.",
    )


def step_keyboard() -> tuple[str, str]:
    layout = choose(
        "Keyboard layout",
        "Which keyboard layout does this machine have?\n"
        "You can pick a different one later from the Xfce settings.",
        COMMON_KEYMAPS + [("other", "Something else (type the code)")],
    )
    if layout == "other":
        layout = ask("Keyboard layout", "Enter an X11 layout code, for example 'cz' or 'br':", "us")
    return layout, dict(COMMON_KEYMAPS).get(layout, layout)


def step_locale() -> str:
    locale = choose(
        "Language",
        "Which language and regional formats should the desktop use?",
        COMMON_LOCALES + [("other", "Something else (type the name)")],
    )
    if locale == "other":
        locale = ask("Language", "Enter a locale name, for example 'cs_CZ.UTF-8':", "en_US.UTF-8")
    return locale


def _timezones() -> list[str]:
    proc = subprocess.run(
        ["timedatectl", "list-timezones"], capture_output=True, text=True
    )
    if proc.returncode == 0 and proc.stdout.strip():
        return proc.stdout.split()
    # Fall back to walking the zoneinfo tree if timedatectl is unavailable.
    base = Path("/usr/share/zoneinfo")
    zones = []
    for path in base.rglob("*"):
        if path.is_file() and "/" in str(path.relative_to(base)):
            zones.append(str(path.relative_to(base)))
    return sorted(zones)


def step_timezone() -> str:
    zones = _timezones()
    if not zones:
        return "UTC"
    regions = sorted({z.split("/", 1)[0] for z in zones})
    region = choose(
        "Time zone",
        "Which region are you in?",
        [(r, r.replace("_", " ")) for r in regions],
    )
    cities = sorted(z for z in zones if z.split("/", 1)[0] == region)
    if len(cities) <= 1:
        return cities[0] if cities else region
    return choose(
        "Time zone",
        f"Which city in {region} shares your time zone?",
        [(c, c.split("/", 1)[1].replace("_", " ")) for c in cities],
    )


def step_hostname() -> str:
    while True:
        hostname = ask(
            "Computer name",
            "What should this stick call itself on a network?",
            "portlin",
        )
        if HOSTNAME_RE.match(hostname):
            return hostname
        message("Computer name", f"\n'{hostname}' is not a valid hostname.\n\n"
                                 "Use letters, digits and hyphens, starting and ending with a "
                                 "letter or digit.")


def _desktop_installed() -> bool:
    """Whether this stick has the desktop whose appearance there is to choose.

    A --minimal stick installs portlin-runtime alone, so none of the files the
    picker rewrites are there. Keyed on the files themselves rather than on a
    dpkg query, because these are the only reason the question is being asked.
    """
    return all(Path(path).exists() for path in THEME_TARGETS)


def step_theme() -> str:
    return choose(
        "Appearance",
        "\nChoose the desktop theme.\n\n"
        "This can be changed later in Settings, Appearance.",
        THEMES,
        height=14,
    )


def step_account() -> tuple[str, str, str]:
    while True:
        full_name = ask("Your account", "What is your full name? (optional, shown on the login screen)")
        username = ask("Your account", "Choose a username. Lowercase letters, digits, - and _.",
                       _suggest_username(full_name))
        if not USERNAME_RE.match(username):
            message("Your account", f"\n'{username}' is not a valid username.\n\n"
                                    "Start with a lowercase letter or underscore, then use "
                                    "lowercase letters, digits, hyphens or underscores.")
            continue
        if _user_exists(username):
            message("Your account", f"\nThe user '{username}' already exists. Choose another name.")
            continue

        password = _ask_matching_password(
            "Your account",
            "Choose a password for this account.\n"
            "It is also the password sudo will ask for.",
        )
        if password is None:
            continue
        return username, full_name, password


def _suggest_username(full_name: str) -> str:
    first = full_name.strip().split(" ")[0].lower() if full_name.strip() else ""
    candidate = re.sub(r"[^a-z0-9_-]", "", first)
    return candidate if USERNAME_RE.match(candidate) else "user"


def _user_exists(username: str) -> bool:
    return subprocess.run(["id", "--", username], capture_output=True).returncode == 0


def _ask_matching_password(title: str, text: str) -> str | None:
    password = ask_password(title, text)
    if len(password) < 4:
        message(title, "\nThat password is too short. Use at least 4 characters.")
        return None
    again = ask_password(title, "Type the same password again to confirm.")
    if password != again:
        message(title, "\nThose passwords did not match. Let's try again.")
        return None
    return password


def _luks_device() -> str | None:
    """The backing device of the encrypted root, if this stick has one.

    Read from crypttab rather than guessed, so it stays correct no matter how the
    stick's partitions are enumerated on this particular machine.
    """
    if not CRYPTTAB.exists():
        return None
    for line in CRYPTTAB.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        fields = line.split()
        if len(fields) < 2:
            continue
        source = fields[1]
        if source.startswith("UUID="):
            path = Path("/dev/disk/by-uuid") / source.split("=", 1)[1]
            return str(path) if path.exists() else None
        return source if Path(source).exists() else None
    return None


def _encrypted_at_boot() -> bool:
    """Whether this stick's passphrase was chosen at this machine.

    The initramfs offers encryption on the first boot of any stick written
    without --encrypt, and whoever accepts types the passphrase there and then.
    The finaliser records that by writing a crypttab of its own, which outlives
    the boot -- unlike /run/portlin/finalised, so setup still knows on a later
    run after a cancelled one.
    """
    if not CRYPTTAB.exists():
        return False
    return CRYPTTAB_BOOT_MARKER in CRYPTTAB.read_text()


def step_change_passphrase(device: str) -> None:
    # Nothing to offer when the passphrase is already theirs: they typed it into
    # the initramfs prompt on the way to this wizard.
    if _encrypted_at_boot():
        return

    if not confirm(
        "Disk encryption",
        "\nThis stick's storage is encrypted.\n\n"
        "The passphrase was set by whoever built it. Would you like to change it "
        "to one only you know?",
        default_yes=True,
    ):
        return

    # cryptsetup prompts on the tty directly. Passing the passphrases through
    # files or arguments instead would leave them readable to other processes,
    # so the interactive path is both simpler and safer here.
    subprocess.run(["clear"])
    print("\nChanging the disk passphrase for", device)
    print("You will be asked for the current passphrase, then the new one.\n")
    result = subprocess.run(["cryptsetup", "luksChangeKey", device])
    if result.returncode != 0:
        message("Disk encryption", "\nThe passphrase was not changed. "
                                   "Your existing passphrase still works.")
    else:
        message("Disk encryption", "\nThe passphrase was changed successfully.")


def _root_devices() -> tuple[str, str, int] | None:
    """Locate (disk, partition, number) holding the root filesystem.

    Everything is resolved from the running system rather than assumed, because
    the stick is a different device on every machine it is plugged into. On an
    encrypted stick the root is a device-mapper node, so this walks one extra
    level down to the LUKS partition underneath it.
    """
    source = subprocess.run(
        ["findmnt", "-no", "SOURCE", "/"], capture_output=True, text=True
    ).stdout.strip()
    if not source:
        return None

    partition = _backing_partition(source)
    if not partition:
        log(f"could not find the partition behind {source}")
        return None
    disk = _parent_disk(partition)
    if not disk:
        log(f"could not find the disk behind {partition}")
        return None

    digits = re.search(r"(\d+)$", partition)
    if not digits:
        return None
    return f"/dev/{disk}", f"/dev/{partition}", int(digits.group(1))


def _backing_partition(source: str) -> str:
    """Kernel name of the partition holding ``source``.

    On an encrypted stick the root is a device-mapper node, and dm devices have
    no "device" link in sysfs -- which is why `lsblk -o PKNAME` returns an empty
    string for them and every lookup built on it silently produced nothing. The
    supported relationship is /sys/block/<dm>/slaves/, listing what the mapping
    is built on top of.
    """
    node = _sysfs_node(source)
    if node is None:
        return ""
    slaves = node / "slaves"
    if slaves.is_dir():
        entries = sorted(entry.name for entry in slaves.iterdir())
        if entries:
            return entries[0]
    # Not a mapping at all: the source is already the partition.
    return node.resolve().name


def _sysfs_node(device: str) -> Path | None:
    """Sysfs directory for a device node, located by its device number.

    Resolving /dev/mapper/<name> as a symlink only works where udev created it
    that way. Without udev -- in an initramfs, a container, or a minimal system
    -- cryptsetup makes a real device node there instead, and resolve() returns
    the path unchanged, pointing at a sysfs entry that does not exist. The
    major:minor pair is how the kernel identifies the device either way.
    """
    try:
        status = os.stat(device)
    except OSError:
        return None
    path = Path(f"/sys/dev/block/{os.major(status.st_rdev)}:{os.minor(status.st_rdev)}")
    return path if path.exists() else None


def _parent_disk(partition_name: str) -> str:
    """Kernel name of the whole disk a partition belongs to.

    /sys/class/block/sda4 is a symlink into the device tree, where the partition
    sits inside its disk's directory -- so the parent directory's name is the
    disk. Works identically for sdaN, nvme0n1pN and loop0pN, none of which
    follow the same naming rule.
    """
    path = Path("/sys/class/block") / partition_name
    if not path.exists():
        return ""
    parent = path.resolve().parent.name
    return parent if parent != "block" else ""


def _sectors(name: str, attribute: str) -> int:
    """Read a sector count the kernel publishes for a block device."""
    try:
        return int((Path("/sys/class/block") / name / attribute).read_text().strip())
    except (OSError, ValueError):
        return 0


def _free_space_bytes(disk: str, partition: str) -> int:
    """Unallocated bytes after the last partition.

    Taken from sysfs rather than by parsing a command's output. The previous
    version shelled out to partx with a malformed argument, and because the
    failure produced an empty string that parsed as zero free space, expansion
    was silently never offered -- no error, no log, just a missing step.
    """
    disk_sectors = _sectors(Path(disk).name, "size")
    part_name = Path(partition).name
    end = _sectors(part_name, "start") + _sectors(part_name, "size")
    if not disk_sectors or end <= 0:
        return 0
    # The GPT backup header and its partition array occupy the last 33 sectors.
    return max(0, (disk_sectors - end - 34) * 512)


def _unused_inside_partition(partition: str) -> int:
    """Space inside the partition that the filesystem is not using.

    Expansion has two separate gaps and they are not the same thing: room after
    the partition, and room inside it the filesystem has not claimed. An
    interrupted expansion grows the partition and stops -- leaving zero free
    space after it, so a check that only looked at the first gap would decide
    there was nothing to do and never offer again, stranding the user at the
    original size inside a full-size partition.
    """
    partition_bytes = _sectors(Path(partition).name, "size") * 512
    if not partition_bytes:
        return 0

    source = subprocess.run(
        ["findmnt", "-no", "SOURCE", "/"], capture_output=True, text=True
    ).stdout.strip()
    used = subprocess.run(
        ["dumpe2fs", "-h", source], capture_output=True, text=True
    ).stdout
    blocks = re.search(r"Block count:\s+(\d+)", used)
    size = re.search(r"Block size:\s+(\d+)", used)
    if not blocks or not size:
        return 0

    filesystem_bytes = int(blocks.group(1)) * int(size.group(1))
    # A LUKS header sits between the two, so allow generous slack before
    # calling the difference meaningful.
    return max(0, partition_bytes - filesystem_bytes - 64 * 1024**2)


def step_expand() -> bool:
    """Offer to grow the system to fill the stick.

    The image is deliberately smaller than any stick worth using, so almost
    every first boot has free space to claim.
    """
    located = _root_devices()
    if located is None:
        log("could not identify the root device, skipping expansion")
        return False
    disk, partition, _ = located
    free = _free_space_bytes(disk, partition) + _unused_inside_partition(partition)
    log(f"expansion: disk={disk} partition={partition} free={free} bytes")
    # Below a gigabyte there is nothing worth the risk of repartitioning.
    if free < 1024**3:
        log("expansion: not enough free space to be worth offering")
        return False

    gigabytes = free / 1024**3
    return confirm(
        "Expand to fill the drive",
        f"\nThis drive has {gigabytes:.1f} GB of unused space beyond the "
        f"installed system.\n\n"
        "Grow the system to use all of it? Your files and settings are "
        "untouched; this only makes the existing filesystem bigger.\n\n"
        "You can skip this and do it later, but it is easiest now.",
        default_yes=True,
    )


def apply_expand() -> None:
    """Grow the partition, the LUKS mapping, then the filesystem, in that order.

    All three resize online, on the mounted running system: growpart uses the
    kernel's partition-resize ioctl, and both cryptsetup and ext4 support growing
    while in use. The order matters and is strictly outside-in -- each layer can
    only grow into space the layer beneath it has already claimed.
    """
    located = _root_devices()
    if located is None:
        return
    disk, partition, number = located

    result = run(["growpart", disk, str(number)], check=False)
    if result.returncode != 0:
        # growpart exits 1 with NOCHANGE when there is nothing to do, which is
        # not an error worth alarming anyone about.
        if "NOCHANGE" not in (result.stdout + result.stderr):
            raise RuntimeError(f"growpart failed: {result.stderr.strip()}")
        return

    source = subprocess.run(
        ["findmnt", "-no", "SOURCE", "/"], capture_output=True, text=True
    ).stdout.strip()
    if source.startswith("/dev/mapper/"):
        _resize_mapping(Path(source).name)
    run(["resize2fs", source])


def _resize_mapping(name: str) -> None:
    """Grow the LUKS mapping into the enlarged partition.

    Rebuilding a dm-crypt mapping needs the volume key, and after boot that key
    is unreachable. cryptsetup hands it to the kernel as a "logon" key, whose
    payload userspace is never permitted to read back, and the keyring holding
    it belonged to the initramfs process that unlocked the disk, which is gone.
    The dm table shows only a dangling reference. cryptsetup then quietly falls
    back to prompting -- and a prompt with no terminal answers itself with
    "Nothing to read on input", killing the expansion.

    So, in order: try the keyring anyway, in case a future cryptsetup can still
    find it; spend the passphrase the boot keyscript stashed in /run; and only
    ask if both fail, which happens on a stick whose crypttab predates the
    keyscript or whose passphrase has since changed.
    """
    result = run(["cryptsetup", "resize", name], check=False)
    if result.returncode == 0:
        return

    log(f"cryptsetup resize needed a passphrase: {result.stderr.strip()}")

    # Read it, spend it, delete it. This is the last thing on the stick that
    # needs the passphrase in the clear, so it should not outlive this call.
    if STASH.exists():
        try:
            stashed = STASH.read_text()
        except OSError as exc:
            log(f"could not read the stashed passphrase: {exc}")
            stashed = ""
        STASH.unlink(missing_ok=True)
        if stashed:
            retry = run(
                ["cryptsetup", "resize", "--key-file", "-", name],
                check=False,
                stdin=stashed,
            )
            if retry.returncode == 0:
                return
            log("the stashed passphrase was refused; falling back to asking")

    for _ in range(3):
        passphrase = ask_password(
            "Disk encryption",
            "\nEnter this drive's passphrase to finish expanding it.\n\n"
            "This is the passphrase you typed when the system started.",
        )
        if not passphrase:
            break
        retry = run(
            ["cryptsetup", "resize", "--key-file", "-", name],
            check=False,
            stdin=passphrase,
        )
        if retry.returncode == 0:
            return
        message("Disk encryption", "\nThat passphrase was not accepted.")

    raise RuntimeError(f"could not resize the encrypted mapping: {result.stderr.strip()}")


def finalise_encryption() -> bool:
    """Whether the boot-time encryption finaliser acted earlier this boot.

    The work itself is done by portlin-finalise-encryption.service, which is
    ordered before this wizard and also runs on sticks whose wizard has long
    since disabled itself. This only reports it, so the wizard can explain to
    the user what happened.
    """
    return Path("/run/portlin/finalised").exists()


def step_autologin(username: str, *, encrypted: bool) -> bool:
    warning = (
        "Convenient on a stick you carry, but anyone who boots it reaches your "
        "desktop without typing anything."
    )
    if not encrypted:
        # An encrypted stick gets a self-unlocking keyring below, so the cost
        # named here applies only where that trade is not on offer.
        warning += (
            "\n\nBecause this stick is not encrypted, it also means the password "
            "keyring stays locked. Browsers and the Wi-Fi applet will ask for "
            "your password the first time they need a saved one after each boot."
        )
    return confirm(
        "Automatic login",
        f"\nLog in as '{username}' automatically when this stick boots?\n\n{warning}",
        default_yes=False,
    )


def step_sudo_password(username: str, *, encrypted: bool, autologin: bool) -> bool:
    warning = (
        "Saying no lets any command run as root without asking, so anyone who "
        "reaches this desktop owns the whole system."
    )
    if autologin and not encrypted:
        # Neither a passphrase at boot nor a password at the login screen, so
        # a waiver here would leave nothing at all on the path from plugging
        # the stick in to root on the machine it was plugged into.
        warning += (
            "\n\nThis stick is not encrypted and logs in automatically, so "
            "nothing else would stand in the way either."
        )
    return confirm(
        "Administrator password",
        f"\nRequire a password when '{username}' runs sudo?\n\n{warning}",
    )


# --------------------------------------------------------------------------
# Applying the answers
# --------------------------------------------------------------------------

def apply_keyboard(layout: str) -> None:
    Path("/etc/default/keyboard").write_text(
        "\n".join(
            [
                "XKBMODEL=pc105",
                f'XKBLAYOUT="{layout}"',
                'XKBVARIANT=""',
                'XKBOPTIONS=""',
                'BACKSPACE="guess"',
                "",
            ]
        )
    )
    run(["setupcon", "--save"], check=False)
    run(["localectl", "set-x11-keymap", layout], check=False)


def apply_locale(locale: str) -> None:
    Path("/etc/locale.gen").write_text(f"{locale} UTF-8\nC.UTF-8 UTF-8\n")
    run(["locale-gen"])
    Path("/etc/default/locale").write_text(f'LANG="{locale}"\n')
    run(["localectl", "set-locale", f"LANG={locale}"], check=False)


def apply_timezone(timezone: str) -> None:
    if run(["timedatectl", "set-timezone", timezone], check=False).returncode != 0:
        run(["ln", "-sf", f"/usr/share/zoneinfo/{timezone}", "/etc/localtime"], check=False)
        Path("/etc/timezone").write_text(f"{timezone}\n")


def apply_hostname(hostname: str) -> None:
    Path("/etc/hostname").write_text(f"{hostname}\n")
    hosts = Path("/etc/hosts")
    lines = [
        line for line in hosts.read_text().splitlines()
        if not line.startswith("127.0.1.1")
    ]
    lines.insert(1, f"127.0.1.1\t{hostname}")
    hosts.write_text("\n".join(lines) + "\n")
    run(["hostnamectl", "set-hostname", hostname], check=False)


def apply_theme(theme: str) -> None:
    """Point every file that names a theme at the chosen one.

    Rewriting three of the four is worse than rewriting none: the greeter or
    the window borders keep the old name, and the desktop looks broken rather
    than merely unchanged. So a file that does not come out naming the chosen
    theme raises here, where the wizard can report it, rather than leaving a
    half-applied appearance behind.
    """
    for path, (pattern, replacement) in THEME_TARGETS.items():
        target = Path(path)
        text = target.read_text()
        rewritten = re.sub(pattern, replacement.format(theme=theme), text, count=1)
        if theme not in rewritten:
            raise RuntimeError(f"{path} does not name a theme in the expected form")
        target.write_text(rewritten)
    log(f"theme set to {theme}")


def apply_account(username: str, full_name: str, password: str) -> None:
    existing = {g.gr_name for g in grp.getgrall()}
    groups = [g for g in DESIRED_GROUPS if g in existing]
    run(
        [
            "useradd",
            "--create-home",
            "--shell", "/bin/bash",
            "--comment", full_name,
            "--groups", ",".join(groups),
            username,
        ]
    )
    run(["chpasswd"], stdin=f"{username}:{password}\n")


def apply_sudo_password(username: str, required: bool) -> bool:
    """Record whether sudo asks this account for a password.

    Requiring one needs no file: the account is in the 'sudo' group and
    Debian's stock sudoers already prompts that group. Only the waiver has to
    be written down, so only the waiver has to be taken back.

    Returns whether the answer was honoured. A rule sudo refuses to parse
    disables sudo for every account, and root is locked on this image, so the
    stick would be left with no way to reach privilege at all. The rule is
    therefore written aside, judged by visudo while it is still inert, and
    moved into place only if it passes.
    """
    if required:
        SUDOERS_DROPIN.unlink(missing_ok=True)
        return True

    draft = SUDOERS_DROPIN.with_name(SUDOERS_DROPIN.name + ".draft")
    draft.write_text(SUDOERS_NOPASSWD_RULE.format(username=username))
    draft.chmod(0o440)
    checked = run(["visudo", "--check", "--file", str(draft)], check=False)
    if checked.returncode != 0:
        log(f"refusing an unparseable sudoers rule for {username!r}")
        draft.unlink(missing_ok=True)
        return False
    draft.replace(SUDOERS_DROPIN)
    return True


def apply_autologin(username: str, enabled: bool) -> None:
    config = Path("/etc/lightdm/lightdm.conf.d/10-portlin.conf")
    if not enabled:
        config.unlink(missing_ok=True)
        return
    # Debian's LightDM PAM configuration only permits autologin for members of
    # the 'autologin' group, so the group has to exist and contain the user.
    run(["groupadd", "-f", "autologin"], check=False)
    run(["usermod", "-aG", "autologin", username], check=False)
    config.parent.mkdir(parents=True, exist_ok=True)
    config.write_text(
        "\n".join(
            [
                "[Seat:*]",
                f"autologin-user={username}",
                "autologin-user-timeout=0",
                "",
            ]
        )
    )


def apply_keyring_autounlock(username: str) -> bool:
    """Give the account a login keyring that needs no password to open.

    Autologin sessions authenticate through the lightdm-autologin PAM service,
    which satisfies auth with pam_permit instead of including common-auth. That
    is what lets the desktop start with nothing typed, and it is also why
    pam_gnome_keyring never sees a password to unlock the login keyring with.
    The daemon still starts from common-session, so every libsecret client --
    browsers, the Wi-Fi applet -- meets a locked keyring and prompts for a login
    password the user may never have knowingly given the keyring.

    A keyring whose password is empty is opened by the daemon at startup without
    prompting, so creating one is what makes autologin quiet. This is only ever
    called for encrypted sticks, where LUKS already protects the secrets at rest
    and the keyring's own password guards nothing the boot passphrase has not
    covered. On an unencrypted stick the same change would leave saved passwords
    readable to anyone who picks the stick up, so step_autologin warns instead.

    gnome-keyring's on-disk format is encrypted even when the password is empty,
    so writing the file directly would mean deriving keys here. --login is the
    entry point PAM itself feeds; an empty password on stdin therefore produces
    exactly the right keyring without this script knowing the format.
    """
    home = Path(os.path.expanduser(f"~{username}"))
    keyring = home / ".local/share/keyrings/login.keyring"
    if keyring.exists():
        # Whatever password it already carries is the user's to change, and
        # replacing it here would silently discard secrets stored under it.
        return True
    if not Path(GNOME_KEYRING_DAEMON).exists():
        # A --minimal stick has no keyring at all, so nothing can prompt.
        return True

    # --daemonize so the parent exits once the keyring exists; the daemon it
    # leaves behind belongs to no session, so it is stopped again rather than
    # left to race the real one the display manager is about to start.
    run(
        [
            "runuser", "-u", username, "--",
            "env", f"HOME={home}", f"XDG_DATA_HOME={home}/.local/share",
            GNOME_KEYRING_DAEMON, "--daemonize", "--login",
        ],
        stdin="",
        check=False,
    )
    run(["pkill", "-u", username, "-x", "gnome-keyring-daemon"], check=False)

    if not keyring.exists():
        log(f"keyring: {keyring} was not created; autologin will prompt for secrets")
        return False
    return True


def drop_passphrase_stash() -> None:
    """Take the keyscript back out of crypttab now that setup is over.

    The keyscript exists to hand this wizard the passphrase typed at boot. Left
    in place it would go on writing that passphrase into /run on every future
    boot, with no wizard coming along to spend and delete it. The initramfs
    carries its own copy of crypttab, so this has to happen before the rebuild
    below rather than after it.
    """
    if CRYPTTAB.exists():
        current = CRYPTTAB.read_text()
        if STASH_KEYSCRIPT_OPTION in current:
            CRYPTTAB.write_text(current.replace(f",{STASH_KEYSCRIPT_OPTION}", ""))
    # Also covers the stick whose owner declined the expansion, where nothing
    # else would ever have consumed the file.
    STASH.unlink(missing_ok=True)


def refresh_initramfs_for_keymap(encrypted: bool) -> None:
    """Rebuild the initramfs so the LUKS prompt uses the chosen keyboard layout.

    The passphrase prompt happens in the initramfs, long before /etc/default/keyboard
    is read at boot. Without this rebuild a passphrase containing symbols is typed
    on a US layout no matter what the user selected here, which is a genuinely
    horrible way to be locked out of your own stick.
    """
    if not encrypted:
        return
    run(["update-initramfs", "-u", "-k", "all"], check=False)


# --------------------------------------------------------------------------

def wizard() -> None:
    step_welcome()
    layout, _ = step_keyboard()
    apply_keyboard(layout)

    locale = step_locale()
    timezone = step_timezone()
    hostname = step_hostname()
    username, full_name, password = step_account()

    luks_device = _luks_device()
    autologin = step_autologin(username, encrypted=luks_device is not None)
    sudo_password = step_sudo_password(
        username, encrypted=luks_device is not None, autologin=autologin
    )
    theme = step_theme() if _desktop_installed() else ""
    expand = step_expand()

    if not confirm(
        "Ready to apply",
        f"\nAccount:   {username}\n"
        f"Computer:  {hostname}\n"
        f"Language:  {locale}\n"
        f"Keyboard:  {layout}\n"
        f"Time zone: {timezone}\n"
        f"Autologin: {'yes' if autologin else 'no'}\n"
        f"Sudo:      {'asks for a password' if sudo_password else 'no password'}\n"
        + (f"Theme:     {theme}\n" if theme else "")
        + f"Expand:    {'yes, use the whole drive' if expand else 'no'}\n\n"
        "Apply these settings now?",
    ):
        raise Cancelled()

    # Before anything else: if the initramfs just encrypted this drive, make
    # that permanent, so a crash later in setup cannot leave a stick that is
    # encrypted but no longer bootable.
    if finalise_encryption():
        info(
            "Encryption",
            "\nThis drive was encrypted during boot.\n\n"
            "Recording the settings so it unlocks normally from now on.",
        )

    if expand:
        # First, so everything below writes into the full-size filesystem rather
        # than the handful of gigabytes the image shipped with.
        info(
            "Expanding",
            "\nGrowing the system to fill the drive.\n\n"
            "This takes a few seconds. Do not remove the drive.",
        )
        apply_expand()

    apply_locale(locale)
    apply_timezone(timezone)
    apply_hostname(hostname)
    apply_account(username, full_name, password)
    if not apply_sudo_password(username, sudo_password):
        message(
            "Administrator password",
            "\nThe rule that skips the sudo password could not be installed, "
            f"so sudo will ask '{username}' for one after all.",
        )
    if theme:
        apply_theme(theme)
    apply_autologin(username, autologin)
    # Only together: a password login unlocks the keyring by itself, and without
    # LUKS a passwordless keyring trades away real protection for convenience.
    if autologin and luks_device:
        apply_keyring_autounlock(username)
    drop_passphrase_stash()
    refresh_initramfs_for_keymap(luks_device is not None)

    if luks_device:
        step_change_passphrase(luks_device)

    SENTINEL.unlink(missing_ok=True)
    run(["systemctl", "disable", "portlin-firstboot.service"], check=False)
    message(
        "All set",
        f"\nWelcome, {full_name or username}.\n\n"
        "The desktop is starting now. Everything you change on this stick is "
        "saved to it, on whatever machine you plug it into next.",
    )


def main() -> int:
    if os.geteuid() != 0:
        print("portlin-firstboot must run as root", file=sys.stderr)
        return 1

    try:
        claim_console(True)
        wizard()
    except Cancelled:
        # The sentinel stays, so setup runs again on the next boot rather than
        # leaving the stick with no way in.
        message(
            "Setup postponed",
            "\nSetup was cancelled. It will run again the next time this stick "
            "boots.\n\nThere is no user account yet, so you cannot log in until "
            "it is finished.",
        )
        return 1
    except Exception:
        detail = traceback.format_exc()
        log(detail)
        message(
            "Setup failed",
            "\nSomething went wrong during setup.\n\n"
            f"The details are in {LOG}.\n\n"
            "Setup will run again the next time this stick boots.",
        )
        return 1
    finally:
        # Always hand the console back, including on the failure paths above.
        claim_console(False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
