# The Terminus sizes console-setup carries, as (height, width), largest first.
TERMINUS_SIZES = [(32, 16), (28, 14), (24, 12), (22, 11), (20, 10), (18, 10)]


def console_font(size_file: Path = FRAMEBUFFER_SIZE, fonts: Path = CONSOLE_FONTS) -> Path | None:
    """The console font that keeps setup legible on this screen, if a change is due.

    Scaled the way a desktop scales: 8x16 at 1080 lines and proportionally
    taller from there, so 1440 gets 20 or 22 pixels and 2160 gets 32. None
    when the screen is 1080 lines or fewer, or its size or the fonts cannot be
    found, which leaves the kernel's font in place.
    """
    try:
        _width, height = (int(n) for n in size_file.read_text().strip().split(","))
    except (OSError, ValueError):
        return None
    wanted = 16 * height // 1080
    if wanted <= 16:
        return None
    for glyph_height, glyph_width in TERMINUS_SIZES:
        if glyph_height > wanted:
            continue
        for face in ("TerminusBold", "Terminus"):
            path = fonts / f"Uni2-{face}{glyph_height}x{glyph_width}.psf.gz"
            if path.exists():
                return path
    return None


def claim_console(quiet: bool) -> None:
    """Take sole possession of tty1, or hand it back.

    Three separate things write to this terminal during boot and each needs its
    own silencer: the kernel's printk stream, systemd's service status lines, and
    plymouth's splash. Left alone they scribble straight through the wizard's
    screens, which looks like a crash rather than a prompt.

    Everything here is best-effort and reversible. Failing to quiet the console
    is a cosmetic problem; failing to restore it would leave the machine
    permanently unable to report anything at boot, which is much worse.
    """
    def attempt(argv: list[str]) -> None:
        """Run a console-wrangling command, and never let it block the wizard.

        Every one of these talks to something that may already be gone, and a
        plymouth command with no daemon to answer it blocks indefinitely --
        hanging the wizard before it draws anything, which presents as a machine
        that simply never finishes booting. None of them matters enough to wait
        on.
        """
        try:
            subprocess.run(argv, capture_output=True, timeout=5)
        except (subprocess.TimeoutExpired, OSError) as exc:
            log(f"console setup: {' '.join(argv)} did not complete ({exc})")

    if quiet:
        # "deactivate", not "quit". Quitting kills the daemon that
        # plymouth-quit-wait is blocking on, deadlocking the boot; deactivating
        # just makes plymouth let go of the terminal, which is all that is
        # actually needed here.
        attempt(["plymouth", "deactivate"])
        # Put tty1 in front of the user. The unit does this too, but a wizard
        # drawing to a console nobody is looking at is the single worst failure
        # mode here -- it looks exactly like a hung boot -- so it is worth
        # asserting from both sides.
        attempt(["chvt", "1"])
        # Before curses starts, so it reads the console's size in the new font.
        # Not undone on the way out: the larger font serves the login prompt on
        # tty1 just as well.
        font = console_font()
        if font is not None:
            attempt(["setfont", str(font)])
    attempt(["setterm", "--msg", "off" if quiet else "on"])
    try:
        # SIGRTMIN+21 disables systemd's console status output, +20 re-enables it.
        os.kill(1, signal.SIGRTMIN + (21 if quiet else 20))
    except (OSError, AttributeError, ValueError):
        log("could not toggle systemd console status")


def log(message: str, *, force: bool = False) -> None:
    """Note what setup did, if the owner keeps setup logs.

    force is for the one thing worth a write either way: why setup failed,
    which the failure screen points at.
    """
    try:
        if not force and "portlin_logs=1" not in WEAR_CONFIG.read_text().splitlines():
            return
    except OSError:
        if not force:
            return
    try:
        with LOG.open("a") as handle:
            handle.write(message.rstrip() + "\n")
    except OSError:
        pass


def run(argv: list[str], *, check: bool = True, stdin: str | None = None) -> subprocess.CompletedProcess:
    """Run a command, with the console kept out of its reach.

    stdin is a pipe even when there is nothing to feed in, because the wizard's
    unit gives it tty1 with StandardInput=tty-force and a child that inherits
    that has a controlling terminal to prompt on. cryptsetup is the one that
    does: given a terminal it opens /dev/tty and asks for the passphrase itself,
    over the top of whatever is on screen, and waits. With a pipe it fails with
    "Nothing to read on input" instead, which lets the caller decide what to
    ask and how -- the assumption every fallback in _resize_mapping is built on.
    """
    log(f"run: {' '.join(argv)}")
    proc = subprocess.run(argv, input=stdin or "", capture_output=True, text=True)
    if proc.stderr.strip():
        log(f"  stderr: {proc.stderr.strip()}")
    if check and proc.returncode != 0:
        raise RuntimeError(f"command failed ({proc.returncode}): {' '.join(argv)}\n{proc.stderr}")
    return proc


def _write_private(path: Path, text: str) -> None:
    """Write a file that holds a secret, never readable by anyone but root.

    Created with its final mode rather than chmod-ed afterwards, so there is
    no moment in which a network password sits in a world-readable file.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as handle:
        handle.write(text)
    os.chmod(path, 0o600)


def _write(path: Path, text: str, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    os.chmod(path, mode)


