def hardware_scan() -> dict:
    """portlin-install's view of this machine, or nothing if it has none."""
    if not Path(INSTALL_TOOL).exists():
        return {}
    try:
        proc = subprocess.run([INSTALL_TOOL, "scan", "--json"], input="", capture_output=True, text=True, timeout=60)
        report = json.loads(proc.stdout) if proc.returncode == 0 else {}
    except (OSError, ValueError, subprocess.SubprocessError):
        return {}
    return report if isinstance(report, dict) else {}


def _zram_percent() -> int:
    try:
        found = re.search(r"(?m)^PERCENT=(\d+)", ZRAM_CONFIG.read_text())
    except OSError:
        return 50
    return int(found.group(1)) if found else 50


def step_hardware(state: State):
    if state.scan is None:
        ui.busy("Hardware", "Looking at this machine's hardware.")
        state.scan = hardware_scan()
    if state.swap is None:
        state.swap = _zram_percent()
    drive = measure_drive(state)
    if state.swapfile is None:
        state.swapfile = _swapfile_gigabytes()
    # A card the PCI ID database does not know is named just "Device", which
    # says nothing; its vendor and device numbers at least identify it.
    gpus = [
        gpu.get("name", "") if gpu.get("name", "") not in ("", "Device") else f"unnamed device [{gpu.get('id', '?')}]"
        for gpu in state.scan.get("gpus", []) if isinstance(gpu, dict)
    ]
    machine = state.scan.get("machine")
    preface = [(f"Model: {machine}", "text")] if machine and isinstance(machine, str) else []
    preface += [(f"Graphics: {', '.join(gpus) if gpus else 'not identified'}", "text")]
    preface += [(note, "muted") for note in state.scan.get("notes", []) if isinstance(note, str)]
    rows = []
    suggested = [s for s in state.scan.get("suggestions", [])
                 if isinstance(s, dict) and ENTRY_ID.match(str(s.get("entry", "")))]
    for suggestion in suggested:
        entry = suggestion["entry"]
        reason = DRIVER_HELP.get(entry, suggestion.get("reason", ""))
        if suggestion.get("detail"):
            reason += f" {suggestion['detail']}."
        if state.online:
            rows.append(Row(f"driver:{entry}", DRIVER_LABELS.get(entry, entry),
                            [(False, "not now"), (True, "install")], entry in state.drivers, help=reason))
        else:
            rows.append(Row(f"driver:{entry}", DRIVER_LABELS.get(entry, entry), [(False, "needs network")],
                            False, enabled=False,
                            help=reason + " Connect on the Network step to install it now, or later from Drivers in the Portlin menu."))
    memory = _memory_bytes()

    def swap_help(values):
        percent = values["swap"]
        if not percent:
            return ("No swap at all. Programs are closed when memory runs out.", True)
        size = f"up to {memory * percent / 100 / 1024**3:.1f} GB" if memory else f"{percent}% of memory"
        return (f"Compressed swap kept in RAM, {size} on this machine. Nothing is ever paged out "
                "to the stick, which would be slow and wear it out.")

    rows.append(Row("swap", "Compressed swap", [(0, "off"), (25, "25% of RAM"), (50, "50% of RAM"),
                                                (75, "75% of RAM"), (100, "100% of RAM")],
                    state.swap if state.swap in (0, 25, 50, 75, 100) else 50, help=swap_help))
    rows.append(swapfile_row(drive, state.swapfile))
    values = ui.settings("Hardware", "Drivers for this machine, and how memory is stretched.", rows,
                         preface=preface)
    state.drivers = [key.split(":", 1)[1] for key, chosen in values.items() if key.startswith("driver:") and chosen]
    state.swap = values["swap"]
    state.swapfile = values["swapfile"]
    return True


def drive_kind(disk: str) -> str:
    """What the system drive is, as far as the kernel can tell: hdd, usb or ssd.

    A spinning disk says so in its queue attributes. Anything else behind USB
    is reported as usb, because a flash stick and a USB SSD look the same from
    here, and paging is only a problem on the first.
    """
    name = Path(disk).name
    try:
        if Path(f"/sys/block/{name}/queue/rotational").read_text().strip() == "1":
            return "hdd"
    except OSError:
        pass
    return "usb" if "/usb" in str(Path(f"/sys/block/{name}").resolve()) else "ssd"


def measure_drive(state: State) -> dict:
    """The system drive's kind and the room it has for a swap file, measured once.

    Room counts the space expansion would add, since the Storage step offers
    that by default and expansion runs before the swap file is made.
    """
    if state.drive is None:
        ui.busy("Hardware", "Measuring the drive.")
        if state.expand_free is None:
            state.expand_free = expansion_offer()
        located = _root_devices()
        try:
            stats = os.statvfs(SWAPFILE.parent)
            free = stats.f_bavail * stats.f_frsize
        except OSError:
            free = 0
        # A swap file that already exists is replaced, so its space counts too.
        state.drive = {
            "kind": drive_kind(located[0]) if located else "unknown",
            "free": free + (state.expand_free or 0) + _swapfile_gigabytes() * 1024**3,
        }
    return state.drive


def swapfile_sizes(room: int) -> list[int]:
    """Swap file sizes, in GB, that leave the drive its headroom."""
    return [size for size in SWAPFILE_SIZES if size * 1024**3 + SWAPFILE_HEADROOM <= room]


def swapfile_row(drive: dict, current: int) -> Row:
    room = drive["free"]
    sizes = swapfile_sizes(room)
    choices = [(0, "off")] + [(size, f"{size} GB") for size in sizes]
    where = {"hdd": "this hard disk", "ssd": "this drive", "usb": "this USB drive"}.get(drive["kind"], "the drive")

    def describe(values):
        size = values["swapfile"]
        if not sizes:
            return "There is not enough room on the drive for a swap file."
        if not size:
            return (f"No swap on the drive. Choose a size to page out to {where} once compressed swap "
                    "is full, rather than closing programs.")
        text = f"A {size} GB file on {where}, used only once compressed swap is full."
        if drive["kind"] == "usb":
            return (text + " Fine on a USB hard disk or SSD. On a flash stick it is slow and wears the "
                    "stick out.", True)
        if drive["kind"] == "hdd":
            return text + " Slower than memory, but far better than programs being closed."
        return text

    return Row("swapfile", "Swap on the drive", choices, current if current in dict(choices) else 0,
               help=describe)


# -- services --------------------------------------------------------------

def step_services(state: State):
    has_ssh, has_ufw = Path(SSHD).exists(), Path(UFW).exists()
    if not has_ssh and not has_ufw:
        return False

    def ssh_help(values):
        if not has_ssh:
            return "The SSH server is not installed on this stick."
        if not values["ssh"]:
            return "Nobody can log in to this stick over the network."
        text = (f"Other computers can log in as {state.username or 'your account'} with its password. "
                "Turn it on only if you need it.")
        if values.get("firewall"):
            return text + " The firewall lets SSH through, slowed down for repeated attempts."
        return text, True

    def firewall_help(values):
        if not has_ufw:
            return "The firewall is not installed on this stick."
        if values["firewall"]:
            return ("Blocks connections that other machines start. Everything this stick connects "
                    "to itself keeps working.")
        return ("Any service running on this stick can be reached by every machine on the same "
                "network, which on public Wi-Fi means strangers.", True)

    rows = [
        Row("ssh", "SSH server", [(False, "off"), (True, "on")] if has_ssh else [(False, "not installed")],
            state.ssh and has_ssh, help=ssh_help, enabled=has_ssh),
        Row("firewall", "Firewall", [(True, "on"), (False, "off")] if has_ufw else [(False, "not installed")],
            state.firewall and has_ufw, help=firewall_help, enabled=has_ufw),
    ]
    values = ui.settings("Services", "What this stick lets other machines do.", rows)
    state.ssh, state.firewall = values["ssh"], values["firewall"]
    return True


# -- storage ---------------------------------------------------------------

def wear_status() -> dict | None:
    if not Path(WEAR_TOOL).exists():
        return None
    try:
        proc = subprocess.run([WEAR_TOOL, "status"], input="", capture_output=True, text=True, timeout=30)
        status = json.loads(proc.stdout) if proc.returncode == 0 else None
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    if not isinstance(status, dict):
        return None
    return {key: bool(status.get(key)) for key, _, _ in WEAR_ROWS}


def step_storage(state: State):
    if state.expand_free is None:
        ui.busy("Storage", "Measuring the drive.")
        state.expand_free = expansion_offer()
    if not state.wear_checked:
        state.wear = wear_status()
        state.wear_initial = dict(state.wear) if state.wear else None
        state.wear_checked = True
    rows = []
    if state.expand_free:
        gigabytes = state.expand_free / 1024**3
        if state.expand is None:
            state.expand = True
        rows.append(Row("expand", "Use the whole drive", [(True, "yes"), (False, "not now")], state.expand,
                        help=lambda v: f"The system fills {gigabytes:.1f} GB of the drive that is not used yet. "
                                       "Your files and settings are untouched; only the filesystem grows."
                        if v["expand"] else
                        (f"{gigabytes:.1f} GB stays unused. portlin-expand can grow it later.", True)))
    else:
        state.expand = False
    for key, label, detail in WEAR_ROWS if state.wear is not None else ():
        rows.append(Row(f"wear:{key}", label, [(False, "no"), (True, "yes")], state.wear[key], help=detail))
    if not rows:
        return False
    values = ui.settings("Storage", "How the system uses the drive. Flash wears out with writes, so "
                                    "portlin writes as little as it can unless asked.", rows)
    state.expand = values.get("expand", False)
    if state.wear is not None:
        state.wear = {key: values[f"wear:{key}"] for key, _, _ in WEAR_ROWS}
    return True


# -- review ----------------------------------------------------------------

def _yes(value: bool, yes: str = "yes", no: str = "no") -> str:
    return yes if value else no


def summary_groups(state: State) -> list[tuple[str, str, str]]:
    groups = []
    if state.migration:
        groups.append(("restore", "Restore",
                       f"{len(state.migrated_ids)} items from {state.migration.get('label', 'the old drive')}"))
    keymaps = {code: label for code, label, _ in _keyboard_layouts()}
    groups.append(("keyboard", "Keyboard", f"{keymaps.get(state.layout, state.layout)} ({state.layout})"))
    groups.append(("language", "Language", dict(COMMON_LOCALES).get(state.locale, state.locale)))
    groups.append(("time", "Time zone",
                   f"{state.timezone}, hardware clock in {_yes(state.rtc_local, 'local time', 'universal time')}"))
    if state.wifi:
        connection = f"Wi-Fi {state.wifi['ssid']}"
    elif state.online:
        connection = "connected"
    else:
        connection = "not connected"
    groups.append(("network", "Network",
                   f"{state.hostname}, {connection}, hardware address {dict(MAC_CHOICES)[state.mac]}"))
    account = state.username + (f" ({state.full_name})" if state.full_name else "")
    if state.account_plan:
        account += ", from the old drive"
    groups.append(("account", "Account", account))
    security = [
        f"automatic login {_yes(state.autologin, 'on', 'off')}",
        f"sudo {_yes(state.sudo_password, 'asks for a password', 'never asks')}",
    ]
    if state.has_desktop:
        security.append(f"locks after {state.lock_minutes} minutes" if state.lock_minutes else "never locks")
    if state.change_passphrase:
        security.append("new disk passphrase")
    if state.found_message:
        security.append(f"if found: {state.found_message}")
    groups.append(("security", "Security", ", ".join(security)))
    if state.has_desktop:
        appearance = [dict(DESKTOPS)[state.desktop]] if state.choose_desktop else []
        appearance += [part for part in (state.theme, state.icon_theme) if part]
        appearance.append({"auto": "automatic scale", "1": "100% scale", "2": "200% scale"}[state.scale])
        groups.append(("appearance", "Appearance", ", ".join(appearance)))
    drivers = ", ".join(DRIVER_LABELS.get(entry, entry) for entry in state.drivers) or "no drivers to install"
    swap = [f"compressed swap {state.swap}% of RAM" if state.swap else "no compressed swap"]
    swap.append(f"{state.swapfile} GB swap file" if state.swapfile else "no swap file")
    groups.append(("hardware", "Hardware", ", ".join([drivers, *swap])))
    if Path(SSHD).exists() or Path(UFW).exists():
        groups.append(("services", "Services",
                       f"SSH {_yes(state.ssh, 'on', 'off')}, firewall {_yes(state.firewall, 'on', 'off')}"))
    storage = []
    if state.expand_free:
        storage.append("use the whole drive" if state.expand else "leave the drive as it is")
    if state.wear:
        kept = [label[0].lower() + label[1:] for key, label, _ in WEAR_ROWS if state.wear.get(key)]
        storage.append(", ".join(kept) if kept else "minimal writes")
    if storage:
        groups.append(("storage", "Storage", ", ".join(storage)))
    return groups


def step_review(state: State):
    return ui.review(
        "Ready to apply",
        "Check everything once more. Pick a line to change it, or apply. "
        "This is the first point at which anything is written to the stick.",
        summary_groups(state),
    )


# --------------------------------------------------------------------------
# Device discovery and expansion
# --------------------------------------------------------------------------

def _root_devices() -> tuple[str, str, int] | None:
    """Locate (disk, partition, number) holding the root filesystem.

    Everything is resolved from the running system rather than assumed, because
    the stick is a different device on every machine it is plugged into. On an
    encrypted stick the root is a device-mapper node, so this walks one extra
    level down to the LUKS partition underneath it.
    """
    source = subprocess.run(
        ["findmnt", "-no", "SOURCE", "/"], capture_output=True, text=True
    ).stdout.strip()
    if not source:
        return None

    partition = _backing_partition(source)
    if not partition:
        log(f"could not find the partition behind {source}")
        return None
    disk = _parent_disk(partition)
    if not disk:
        log(f"could not find the disk behind {partition}")
        return None

    digits = re.search(r"(\d+)$", partition)
    if not digits:
        return None
    return f"/dev/{disk}", f"/dev/{partition}", int(digits.group(1))


def _backing_partition(source: str) -> str:
    """Kernel name of the partition holding ``source``.

    On an encrypted stick the root is a device-mapper node, and dm devices have
    no "device" link in sysfs -- which is why `lsblk -o PKNAME` returns an empty
    string for them and every lookup built on it silently produced nothing. The
    supported relationship is /sys/block/<dm>/slaves/, listing what the mapping
    is built on top of.
    """
    node = _sysfs_node(source)
    if node is None:
        return ""
    slaves = node / "slaves"
    if slaves.is_dir():
        entries = sorted(entry.name for entry in slaves.iterdir())
        if entries:
            return entries[0]
    # Not a mapping at all: the source is already the partition.
    return node.resolve().name


def _sysfs_node(device: str) -> Path | None:
    """Sysfs directory for a device node, located by its device number.

    Resolving /dev/mapper/<name> as a symlink only works where udev created it
    that way. Without udev -- in an initramfs, a container, or a minimal system
    -- cryptsetup makes a real device node there instead, and resolve() returns
    the path unchanged, pointing at a sysfs entry that does not exist. The
    major:minor pair is how the kernel identifies the device either way.
    """
    try:
        status = os.stat(device)
    except OSError:
        return None
    path = Path(f"/sys/dev/block/{os.major(status.st_rdev)}:{os.minor(status.st_rdev)}")
    return path if path.exists() else None


def _parent_disk(partition_name: str) -> str:
    """Kernel name of the whole disk a partition belongs to.

    /sys/class/block/sda4 is a symlink into the device tree, where the partition
    sits inside its disk's directory -- so the parent directory's name is the
    disk. Works identically for sdaN, nvme0n1pN and loop0pN, none of which
    follow the same naming rule.
    """
    path = Path("/sys/class/block") / partition_name
    if not path.exists():
        return ""
    parent = path.resolve().parent.name
    return parent if parent != "block" else ""


def _sectors(name: str, attribute: str) -> int:
    """Read a sector count the kernel publishes for a block device."""
    try:
        return int((Path("/sys/class/block") / name / attribute).read_text().strip())
    except (OSError, ValueError):
        return 0


def _free_space_bytes(disk: str, partition: str) -> int:
    """Unallocated bytes after the last partition.

    Taken from sysfs rather than by parsing a command's output. The previous
    version shelled out to partx with a malformed argument, and because the
    failure produced an empty string that parsed as zero free space, expansion
    was silently never offered -- no error, no log, just a missing step.
    """
    disk_sectors = _sectors(Path(disk).name, "size")
    part_name = Path(partition).name
    end = _sectors(part_name, "start") + _sectors(part_name, "size")
    if not disk_sectors or end <= 0:
        return 0
    # The GPT backup header and its partition array occupy the last 33 sectors.
    return max(0, (disk_sectors - end - 34) * 512)


def _unused_inside_partition(partition: str) -> int:
    """Space inside the partition that the filesystem is not using.

    Expansion has two separate gaps and they are not the same thing: room after
    the partition, and room inside it the filesystem has not claimed. An
    interrupted expansion grows the partition and stops -- leaving zero free
    space after it, so a check that only looked at the first gap would decide
    there was nothing to do and never offer again, stranding the user at the
    original size inside a full-size partition.
    """
    partition_bytes = _sectors(Path(partition).name, "size") * 512
    if not partition_bytes:
        return 0

    source = subprocess.run(
        ["findmnt", "-no", "SOURCE", "/"], capture_output=True, text=True
    ).stdout.strip()
    used = subprocess.run(
        ["dumpe2fs", "-h", source], capture_output=True, text=True
    ).stdout
    blocks = re.search(r"Block count:\s+(\d+)", used)
    size = re.search(r"Block size:\s+(\d+)", used)
    if not blocks or not size:
        return 0

    filesystem_bytes = int(blocks.group(1)) * int(size.group(1))
    # A LUKS header sits between the two, so allow generous slack before
    # calling the difference meaningful.
    return max(0, partition_bytes - filesystem_bytes - 64 * 1024**2)


def expansion_offer() -> int:
    """Bytes the system could grow into, or 0 when it is not worth offering.

    The image is deliberately smaller than any stick worth using, so almost
    every first boot has free space to claim.
    """
    located = _root_devices()
    if located is None:
        log("could not identify the root device, skipping expansion")
        return 0
    disk, partition, _ = located
    free = _free_space_bytes(disk, partition) + _unused_inside_partition(partition)
    log(f"expansion: disk={disk} partition={partition} free={free} bytes")
    # Below a gigabyte there is nothing worth the risk of repartitioning.
    if free < 1024**3:
        log("expansion: not enough free space to be worth offering")
        return 0
    return free


def apply_expand() -> None:
    """Grow the partition, the LUKS mapping, then the filesystem, in that order.

    All three resize online, on the mounted running system: growpart uses the
    kernel's partition-resize ioctl, and both cryptsetup and ext4 support growing
    while in use. The order matters and is strictly outside-in -- each layer can
    only grow into space the layer beneath it has already claimed.
    """
    located = _root_devices()
    if located is None:
        return
    disk, partition, number = located

    result = run(["growpart", disk, str(number)], check=False)
    if result.returncode != 0:
        # growpart exits 1 with NOCHANGE when there is nothing to do, which is
        # not an error worth alarming anyone about.
        if "NOCHANGE" not in (result.stdout + result.stderr):
            raise RuntimeError(f"growpart failed: {result.stderr.strip()}")
        return

    source = subprocess.run(
        ["findmnt", "-no", "SOURCE", "/"], capture_output=True, text=True
    ).stdout.strip()
    if source.startswith("/dev/mapper/"):
        _resize_mapping(Path(source).name)
    run(["resize2fs", source])


def _resize_mapping(name: str) -> None:
    """Grow the LUKS mapping into the enlarged partition.

    Rebuilding a dm-crypt mapping needs the volume key, and after boot that key
    is unreachable. cryptsetup hands it to the kernel as a "logon" key, whose
    payload userspace is never permitted to read back, and the keyring holding
    it belonged to the initramfs process that unlocked the disk, which is gone.
    The dm table shows only a dangling reference. cryptsetup then quietly falls
    back to prompting -- and a prompt with no terminal answers itself with
    "Nothing to read on input", killing the expansion.

    So, in order: try the keyring anyway, in case a future cryptsetup can still
    find it; spend the passphrase the boot keyscript stashed in /run; and only
    ask if both fail, which happens on a stick whose crypttab predates the
    keyscript or whose passphrase has since changed.
    """
    result = run(["cryptsetup", "resize", name], check=False)
    if result.returncode == 0:
        return

    log(f"cryptsetup resize needed a passphrase: {result.stderr.strip()}")

    # Read it, spend it, delete it. This is the last thing on the stick that
    # needs the passphrase in the clear, so it should not outlive this call.
    if STASH.exists():
        try:
            stashed = STASH.read_text()
        except OSError as exc:
            log(f"could not read the stashed passphrase: {exc}")
            stashed = ""
        STASH.unlink(missing_ok=True)
        if stashed:
            retry = run(
                ["cryptsetup", "resize", "--key-file", "-", name],
                check=False,
                stdin=stashed,
            )
            if retry.returncode == 0:
                return
            log("the stashed passphrase was refused; falling back to asking")

    for _ in range(3):
        passphrase = ask_password(
            "Disk passphrase",
            "Enter this drive's passphrase to finish expanding it. "
            "This is the passphrase you typed when the system started.",
        )
        if not passphrase:
            break
        retry = run(
            ["cryptsetup", "resize", "--key-file", "-", name],
            check=False,
            stdin=passphrase,
        )
        if retry.returncode == 0:
            return
        message("Disk passphrase", "That passphrase was not accepted.")

    raise RuntimeError(f"could not resize the encrypted mapping: {result.stderr.strip()}")


def finalise_encryption() -> bool:
    """Whether the boot-time encryption finaliser acted earlier this boot.

    The work itself is done by portlin-finalise-encryption.service, which is
    ordered before this wizard and also runs on sticks whose wizard has long
    since disabled itself. This only reports it, so the wizard can explain to
    the user what happened.
    """
    return Path("/run/portlin/finalised").exists()


def _luks_device() -> str | None:
    """The backing device of the encrypted root, if this stick has one.

    Read from crypttab rather than guessed, so it stays correct no matter how the
    stick's partitions are enumerated on this particular machine.
    """
    if not CRYPTTAB.exists():
        return None
    for line in CRYPTTAB.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        fields = line.split()
        if len(fields) < 2:
            continue
        source = fields[1]
        if source.startswith("UUID="):
            path = Path("/dev/disk/by-uuid") / source.split("=", 1)[1]
            return str(path) if path.exists() else None
        return source if Path(source).exists() else None
    return None


def change_luks_passphrase(device: str, current: str, new: str) -> bool:
    """Replace the passphrase in the keyslot ``current`` opens.

    Both passphrases travel by pipe: the current one on stdin, the new one on
    a second descriptor cryptsetup reads as its new key file. Neither is ever
    an argument, which /proc would show to every user, nor a file on disk.
    """
    read_end, write_end = os.pipe()
    argv = ["cryptsetup", "luksChangeKey", "--key-file", "-", device, f"/dev/fd/{read_end}"]
    log(f"run: {' '.join(argv)}")
    try:
        proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True, pass_fds=(read_end,))
    except OSError as exc:
        os.close(read_end)
        os.close(write_end)
        log(f"  could not start cryptsetup: {exc}")
        return False
    os.close(read_end)
    try:
        with os.fdopen(write_end, "w") as handle:
            handle.write(new)
    except BrokenPipeError:
        # cryptsetup gave up before reading the new passphrase; its exit
        # status below says so.
        pass
    _, stderr = proc.communicate(current)
    if stderr.strip():
        log(f"  stderr: {stderr.strip()}")
    return proc.returncode == 0


def step_change_passphrase(device: str) -> None:
    def check(values):
        if not values["current"]:
            return "current", "Type the passphrase you unlocked this stick with."
        if len(values["new"]) < 8:
            return "new", "Use at least 8 characters. This is the only thing between the stick and a stranger.", "new", "again"
        if values["new"] != values["again"]:
            return "new", "Those did not match. Type them again.", "new", "again"
        return None

    for _ in range(3):
        try:
            values = ui.form(
                "Disk passphrase",
                "Choose the passphrase this stick asks for at boot. Whoever built it knows the "
                "current one; after this, only you will.",
                [
                    Field("current", "Current passphrase", secret=True, limit=512),
                    Field("new", "New passphrase", secret=True, limit=512),
                    Field("again", "Repeat new passphrase", secret=True, limit=512),
                ],
                validate=check, back_label="keep the current one", submit="Change passphrase",
            )
        except Back:
            break
        ui.busy("Disk passphrase", "Changing the passphrase. This takes a few seconds.")
        if change_luks_passphrase(device, values["current"], values["new"]):
            ui.message("Disk passphrase", "The passphrase was changed. Use the new one from the next boot on.")
            return
        ui.message("Disk passphrase", "The passphrase was not changed. Check the current passphrase and try again.")
    ui.message("Disk passphrase", "The passphrase was not changed. The existing one still works.")


