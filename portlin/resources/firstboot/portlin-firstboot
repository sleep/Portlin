def _machine_description() -> str:
    def read(name: str) -> str:
        try:
            return Path(f"/sys/class/dmi/id/{name}").read_text().strip()
        except OSError:
            return ""

    # Firmware fills these with placeholders often enough to filter the
    # common ones rather than print them as a machine's name.
    placeholders = ("to be filled by o.e.m.", "system product name", "default string", "not applicable")
    vendor, product = read("sys_vendor"), read("product_version") or read("product_name")
    names = [part for part in (vendor, product) if part and part.lower() not in placeholders]
    if len(names) == 2 and names[1].lower().startswith(names[0].lower()):
        names = names[1:]
    parts = [" ".join(names)] if names else []
    memory = _memory_bytes()
    if memory:
        parts.append(f"{memory / 1024**3:.0f} GB memory")
    return ", ".join(parts)


def _memory_bytes() -> int:
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            if line.startswith("MemTotal:"):
                return int(line.split()[1]) * 1024
    except (OSError, ValueError, IndexError):
        pass
    return 0


def step_welcome(state: State):
    machine = _machine_description()
    text = (
        "This stick is a full Debian system with an Xfce desktop. It carries "
        "everything you change with it, from machine to machine.\n\n"
        "Setup takes a couple of minutes. Each step has sensible answers already "
        "chosen, so Enter moves on, and Esc goes back to change an earlier one. "
        "Nothing is written to the stick until you confirm the summary at the end."
    )
    if machine:
        text += f"\n\nThis machine: {machine}"
    if state.luks_device:
        text += "\nThis stick's storage is encrypted."
    ui.dialog("Welcome to Portlin", text, ["Start setup"], back=False)


def migration_candidates() -> list[dict]:
    """What portlin-migrate can see, or nothing when it is absent or confused.

    Nothing here may stop setup. A tool that is missing, that fails, or that
    prints something other than a list of candidates means there is simply
    no restore screen, and the wizard goes on as it did before the tool
    existed.
    """
    if not Path(MIGRATE_TOOL).exists():
        return []
    try:
        proc = subprocess.run(
            [MIGRATE_TOOL, "candidates", "--json"], input="", capture_output=True, text=True, timeout=60
        )
        found = json.loads(proc.stdout) if proc.returncode == 0 else []
    except (OSError, ValueError, subprocess.SubprocessError):
        return []
    if not isinstance(found, list) or not all(isinstance(c, dict) and "path" in c for c in found):
        return []
    return found


def step_migration(state: State):
    """Offer a restore, and hand the choosing to the tool's own screens.

    The tool is run with the console rather than through run(): its screens
    are whiptail, and they need tty1 the way this wizard's do. It keeps the
    old drive open afterwards so apply can copy from it without asking for the
    passphrase twice. Coming back to this step releases any earlier plan
    first, so a second answer starts clean.
    """
    names = "\n".join(
        f"  {c.get('model') or Path(c['path']).name} {c.get('size', '')}".rstrip() for c in state.candidates
    )
    wanted = ui.confirm(
        "Restore from another portlin",
        f"Another portlin was found:\n\n{names}\n\n"
        "Bring its account, files and settings over to this stick? You choose "
        "exactly what to bring on the next screen.",
        yes="Restore", no="Start fresh",
    )
    close_migration()
    state.migration, state.prefill, state.account_plan, state.migrated_ids = None, {}, None, set()
    if not wanted:
        return True
    with ui.suspended():
        proc = subprocess.run([MIGRATE_TOOL, "plan", "--firstboot", "--keep-open", "--out", str(MIGRATION_PLAN)])
    plan = None
    if proc.returncode == 0:
        try:
            plan = json.loads(MIGRATION_PLAN.read_text())
        except (OSError, ValueError):
            plan = None
    if not isinstance(plan, dict) or not isinstance(plan.get("ids"), list):
        ui.message("Restore", "Nothing will be restored. Setup continues as for a new stick.")
        return True
    log(f"migration planned from {plan.get('source')}: {len(plan['ids'])} items")
    state.migration = plan
    state.prefill = plan.get("identity") or {}
    account_plan = plan.get("account")
    # The plan is the tool's output, and only an account named the way the
    # account screen would accept is taken from it; anything else means the
    # account is asked for as usual.
    if not isinstance(account_plan, dict) or not USERNAME_RE.fullmatch(str(account_plan.get("name") or "")):
        account_plan = None
    state.account_plan = account_plan
    state.migrated_ids = set(plan.get("ids") or [])
    return True


def apply_migration() -> bool:
    """The copy, drawn by the tool's own gauge on the console."""
    with ui.suspended():
        return subprocess.run([MIGRATE_TOOL, "apply", "--plan", str(MIGRATION_PLAN), "--gauge"]).returncode == 0


def close_migration() -> None:
    """Release the old drive and the plan, on every way out of setup."""
    if not MIGRATION_PLAN.exists():
        return
    if Path(MIGRATE_TOOL).exists():
        # This runs from main's finally, where a hung unmount must not keep
        # the console claimed forever and a failure must not hide whatever
        # brought setup here.
        try:
            subprocess.run([MIGRATE_TOOL, "close"], input="", capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.SubprocessError):
            pass
    MIGRATION_PLAN.unlink(missing_ok=True)


def _current_keyboard() -> str:
    try:
        found = re.search(r'(?m)^XKBLAYOUT="?([^",\n]*)', Path("/etc/default/keyboard").read_text())
    except OSError:
        return ""
    return found.group(1) if found else ""


def _keyboard_layouts() -> list[tuple[str, str, str]]:
    entries = [(code, label, code) for code, label in COMMON_KEYMAPS]
    seen = {code for code, _ in COMMON_KEYMAPS}
    try:
        text = XKB_RULES.read_text()
    except OSError:
        return entries
    section, others = "", []
    for line in text.splitlines():
        if line.startswith("!"):
            section = line[1:].strip()
            continue
        if section != "layout" or not line.strip():
            continue
        code, _, label = line.strip().partition(" ")
        if code and code not in seen:
            seen.add(code)
            others.append((code, label.strip(), code))
    return entries + sorted(others, key=lambda entry: entry[1].lower())


def step_keyboard(state: State):
    entries = _keyboard_layouts()
    default = state.layout or state.prefill.get("keyboard", "") or _current_keyboard() or "us"
    if default not in [entry[0] for entry in entries]:
        entries.insert(0, (default, default, default))
    state.layout = ui.menu(
        "Keyboard layout",
        "Which keyboard does this machine have? Everything after this is typed "
        "with it, including the disk passphrase at boot.",
        entries, default=default, search=True,
    )
    ui.busy("Keyboard layout", "Switching the keyboard layout.")
    apply_keyboard(state.layout)
    ui.repaint()
    return True


def _locales() -> list[tuple[str, str, str]]:
    entries = [(code, label, code) for code, label in COMMON_LOCALES]
    seen = {code for code, _ in COMMON_LOCALES}
    try:
        text = SUPPORTED_LOCALES.read_text()
    except OSError:
        return entries
    for line in text.splitlines():
        fields = line.split()
        if len(fields) == 2 and fields[1] == "UTF-8" and fields[0] not in seen:
            seen.add(fields[0])
            entries.append((fields[0], fields[0], ""))
    return entries


def step_locale(state: State):
    entries = _locales()
    default = state.locale or state.prefill.get("locale", "") or "en_US.UTF-8"
    if default not in [entry[0] for entry in entries]:
        entries.insert(0, (default, default, default))
    state.locale = ui.menu(
        "Language",
        "Which language and regional formats should the desktop use?",
        entries, default=default, search=True,
    )
    return True


def _timezones() -> list[str]:
    proc = subprocess.run(
        ["timedatectl", "list-timezones"], capture_output=True, text=True
    )
    if proc.returncode == 0 and proc.stdout.strip():
        return proc.stdout.split()
    # Fall back to walking the zoneinfo tree if timedatectl is unavailable.
    base = Path("/usr/share/zoneinfo")
    zones = []
    for path in base.rglob("*"):
        if path.is_file() and "/" in str(path.relative_to(base)):
            zones.append(str(path.relative_to(base)))
    return sorted(zones)


def _windows_on_this_machine() -> bool:
    """Whether this machine boots Windows, which keeps the hardware clock in local time."""
    try:
        listing = subprocess.run(["efibootmgr"], input="", capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    return "Windows Boot Manager" in listing


def step_timezone(state: State):
    zones = _timezones() or ["UTC"]
    entries = [
        (zone, zone.rsplit("/", 1)[-1].replace("_", " "), zone.rsplit("/", 1)[0].replace("_", " ") if "/" in zone else "")
        for zone in zones
    ]
    while True:
        default = state.timezone or state.prefill.get("timezone", "")
        if not default:
            try:
                default = Path("/etc/timezone").read_text().strip()
            except OSError:
                default = "UTC"
        state.timezone = ui.menu(
            "Time zone",
            "Where are you? Type a city or region to find it.",
            entries, default=default, search=True,
        )
        windows = _windows_on_this_machine()
        if state.rtc_local is None:
            state.rtc_local = windows
        try:
            choice = ui.menu(
                "Hardware clock",
                "Machines disagree about the time their hardware clock keeps. Linux and "
                "Macs keep universal time; Windows keeps local time. Pick what the "
                "machines you plug this stick into mostly run, so the clock is right "
                "from boot and the stick never shifts a Windows PC's clock."
                + ("\n\nThis machine boots Windows." if windows else ""),
                [
                    ("utc", "Universal time", "Linux and Mac machines"),
                    ("local", "Local time", "Windows PCs"),
                ],
                default="local" if state.rtc_local else "utc",
            )
        except Back:
            continue
        state.rtc_local = choice == "local"
        return True


# -- network ---------------------------------------------------------------

def _nmcli(args: list[str], timeout: int = 30) -> subprocess.CompletedProcess | None:
    try:
        return subprocess.run(["nmcli", *args], input="", capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None


def _terse(line: str) -> list[str]:
    """Split one line of `nmcli -t`, which escapes ':' and '\\' inside fields."""
    fields, current, escaped = [], "", False
    for char in line:
        if escaped:
            current += char
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == ":":
            fields.append(current)
            current = ""
        else:
            current += char
    fields.append(current)
    return fields


def network_status() -> tuple[bool, bool]:
    """(has a Wi-Fi adapter, already online), once NetworkManager is answering."""
    for _ in range(10):
        running = _nmcli(["-t", "-f", "RUNNING", "general"])
        if running is None:
            return False, False
        if running.stdout.strip() == "running":
            break
        time.sleep(1)
    devices = _nmcli(["-t", "-f", "TYPE,STATE", "device"])
    has_wifi = bool(devices) and any(_terse(line)[0] == "wifi" for line in devices.stdout.splitlines())
    general = _nmcli(["-t", "-f", "STATE", "general"])
    online = bool(general) and general.stdout.strip() == "connected"
    return has_wifi, online


def wifi_networks() -> list[dict]:
    _nmcli(["radio", "wifi", "on"])
    listing = _nmcli(["-t", "-f", "SSID,SECURITY,SIGNAL", "device", "wifi", "list", "--rescan", "yes"], timeout=45)
    best: dict[str, dict] = {}
    for line in (listing.stdout.splitlines() if listing else []):
        fields = _terse(line)
        if len(fields) < 3 or not fields[0]:
            continue
        try:
            signal_strength = int(fields[2] or 0)
        except ValueError:
            signal_strength = 0
        security = fields[1].strip()
        if not security or security == "--":
            kind = "open"
        elif "802.1X" in security:
            kind = "enterprise"
        elif "WPA3" in security and "WPA2" not in security:
            kind = "sae"
        else:
            kind = "psk"
        found = {"ssid": fields[0], "security": kind, "label": security if kind != "open" else "open",
                 "signal": signal_strength}
        if fields[0] not in best or best[fields[0]]["signal"] < signal_strength:
            best[fields[0]] = found
    return sorted(best.values(), key=lambda network: -network["signal"])


def _keyfile_value(text: str) -> str:
    escaped = text.replace("\\", "\\\\").replace("\n", "\\n").replace("\t", "\\t").replace("\r", "\\r")
    return "\\s" + escaped[1:] if escaped.startswith(" ") else escaped


def wifi_keyfile(identifier: str, ssid: str, security: str, password: str, *, hidden: bool = False) -> str:
    """A NetworkManager profile, in the keyfile format it stores them in.

    The SSID is written as its bytes, which the keyfile format accepts for any
    network name, so no SSID can break the file whatever it contains.
    """
    lines = [
        "[connection]",
        f"id={_keyfile_value(ssid)}",
        f"uuid={identifier}",
        "type=wifi",
        "autoconnect=true",
        "",
        "[wifi]",
        "mode=infrastructure",
        "ssid=" + "".join(f"{byte};" for byte in ssid.encode()),
    ]
    if hidden:
        lines.append("hidden=true")
    lines.append("")
    if security != "open":
        lines += [
            "[wifi-security]",
            f"key-mgmt={'sae' if security == 'sae' else 'wpa-psk'}",
            f"psk={_keyfile_value(password)}",
            "",
        ]
    lines += ["[ipv4]", "method=auto", "", "[ipv6]", "addr-gen-mode=stable-privacy", "method=auto", ""]
    return "\n".join(lines)


def forget_wifi(wifi: dict | None) -> None:
    if not wifi:
        return
    _nmcli(["connection", "delete", "uuid", wifi["uuid"]])
    Path(wifi["path"]).unlink(missing_ok=True)


def wifi_connect(ssid: str, security: str, password: str, *, hidden: bool = False) -> tuple[dict | None, str]:
    """Join a network with a profile kept in /run, and say why if it failed.

    The password goes into a file NetworkManager reads rather than onto
    nmcli's command line, where every user on the machine could read it.
    """
    identifier = str(uuid.uuid4())
    path = NM_RUN_CONNECTIONS / f"portlin-setup-{identifier}.nmconnection"
    _write_private(path, wifi_keyfile(identifier, ssid, security, password, hidden=hidden))
    _nmcli(["connection", "load", str(path)])
    up = _nmcli(["--wait", "45", "connection", "up", "uuid", identifier], timeout=60)
    joined = {"ssid": ssid, "uuid": identifier, "path": str(path), "security": security}
    if up is not None and up.returncode == 0:
        return joined, ""
    forget_wifi(joined)
    reason = ((up.stderr or up.stdout).strip().splitlines() or ["no answer"])[-1] if up else "nmcli did not answer"
    return None, re.sub(r"^Error:\s*", "", reason)


def _set_runtime_mac(mode: str) -> None:
    if mode == "off":
        NM_RUN_MAC_CONF.unlink(missing_ok=True)
    else:
        _write(NM_RUN_MAC_CONF, MAC_CONF.format(mode=mode))
    _nmcli(["general", "reload", "conf"])


MAC_CHOICES = [("stable", "random per network"), ("random", "random every time"), ("off", "the real one")]


def _signal_bars(strength: int) -> str:
    filled = min(4, max(1, (strength + 24) // 25))
    return ui.g("done") * filled + ui.g("todo") * (4 - filled)


def step_network(state: State):
    while True:
        values = ui.settings(
            "Network",
            "How this stick introduces itself to networks.",
            [
                Row("hostname", "Computer name", text=True,
                    value=state.hostname or state.prefill.get("hostname") or "portlin", limit=63,
                    help="Shown to other machines on the network. Letters, digits and hyphens."),
                Row("mac", "Hardware address", MAC_CHOICES, state.mac,
                    help=lambda v: {
                        "stable": "Each network sees a different made-up address, the same one every "
                                  "visit, so logins on hotel and cafe networks keep working but no two "
                                  "networks can tell they saw the same stick.",
                        "random": "A new made-up address on every connection. The most private, but "
                                  "networks that remember devices will ask you to log in every time.",
                        "off": ("Every network sees the hardware's own address, so this stick can be "
                                "recognised wherever it connects.", True),
                    }[v["mac"]]),
            ],
            validate=lambda v: None if HOSTNAME_RE.match(v["hostname"]) else (
                "hostname", f"'{v['hostname']}' is not a valid computer name. Use letters, digits and "
                            "hyphens, starting and ending with a letter or digit."),
        )
        state.hostname, state.mac = values["hostname"], values["mac"]
        if not state.network_checked:
            ui.busy("Network", "Looking for network adapters.")
            state.has_wifi, state.online = network_status()
            state.network_checked = True
        if not state.has_wifi or (state.online and not state.wifi):
            return True
        try:
            step_wifi(state)
            return True
        except Back:
            continue


def step_wifi(state: State) -> None:
    _set_runtime_mac(state.mac)
    while True:
        ui.busy("Wi-Fi", "Looking for networks.")
        networks = wifi_networks()
        entries = [
            (network["ssid"], network["ssid"], f"{_signal_bars(network['signal'])}  {network['label']}")
            for network in networks
        ]
        entries += [
            ("\0hidden", "Hidden network", "type its name"),
            ("\0rescan", "Look again", ""),
            ("\0skip", "Not now", "set it up later from the desktop"),
        ]
        current = state.wifi["ssid"] if state.wifi else None
        chosen = ui.menu(
            "Wi-Fi",
            ("Connected to " + current + ". Pick it again to keep it, or another network."
             if current else
             "Connecting now sets the clock and lets setup download drivers. "
             "The password is saved only when you apply the summary."),
            entries, default=current or (entries[0][0] if networks else "\0skip"),
        )
        if chosen == "\0rescan":
            continue
        if chosen == "\0skip":
            forget_wifi(state.wifi)
            state.wifi = None
            state.online = network_status()[1]
            return
        if current and chosen == current:
            return
        hidden = chosen == "\0hidden"
        network = next((n for n in networks if n["ssid"] == chosen), None)
        if network and network["security"] == "enterprise":
            ui.message("Wi-Fi", f"{chosen} uses enterprise sign-in, which needs more than a password. "
                                "Set it up from the network icon on the desktop.")
            continue
        security = network["security"] if network else "psk"
        fields = []
        if hidden:
            fields.append(Field("ssid", "Network name", limit=32))
        if security != "open":
            fields.append(Field("password", "Password", secret=True, limit=63,
                                hint="Leave empty for an open network" if hidden else ""))

        def check(values):
            if hidden and not values["ssid"]:
                return "ssid", "Type the network's name."
            password = values.get("password", "")
            if hidden and not password:
                return None
            if security != "open" and security != "sae" and not 8 <= len(password) <= 63:
                return "password", "Wi-Fi passwords are 8 to 63 characters."
            if security == "sae" and not password:
                return "password", "Type the network's password."
            return None

        try:
            values = ui.form("Wi-Fi", f"Join {chosen}." if not hidden else "Join a network that does not "
                             "announce its name.", fields, validate=check, submit="Connect") if fields else {}
        except Back:
            continue
        ssid = values.get("ssid", chosen)
        password = values.get("password", "")
        if hidden and not password:
            security = "open"
        forget_wifi(state.wifi)
        state.wifi = None
        ui.busy("Wi-Fi", f"Connecting to {ssid}. This can take half a minute.")
        joined, reason = wifi_connect(ssid, security, password, hidden=hidden)
        if joined:
            state.wifi, state.online = joined, True
            return
        ui.message("Wi-Fi", f"Could not connect to {ssid}.\n\n{reason}", tone="text")


# -- account ---------------------------------------------------------------

def step_account(state: State):
    if state.account_plan:
        # The tool recreates the account with its password hash, so there is
        # no password to ask for and none to hold here.
        state.username = state.account_plan.get("name", "")
        state.full_name = state.account_plan.get("gecos", "")
        state.password = None
        ui.message("Your account",
                   f"The account '{state.username}' comes over from the old drive, with its password.",
                   back=True)
        return True

    edited = {"username": bool(state.username)}

    def derive(values, changed):
        if changed == "username":
            edited["username"] = True
        elif changed == "full_name" and not edited["username"]:
            values["username"] = _suggest_username(values["full_name"])

    def check(values):
        username = values["username"]
        if ":" in values["full_name"] or not values["full_name"].isprintable():
            return "full_name", "A name cannot contain ':'."
        if not USERNAME_RE.match(username):
            return ("username", "Start with a lowercase letter or underscore, then use lowercase "
                                "letters, digits, hyphens or underscores.")
        if _user_exists(username) and username != _account_from_earlier_run():
            return "username", f"The user '{username}' already exists. Choose another name."
        if len(values["password"]) < 4:
            return "password", "Use at least 4 characters.", "password", "again"
        if values["password"] != values["again"]:
            return "password", "Those did not match. Type both again.", "password", "again"
        return None

    values = ui.form(
        "Your account",
        "The account you log in with. It can run administrator commands with sudo.",
        [
            Field("full_name", "Full name", state.full_name, hint="Optional, for the login screen"),
            Field("username", "Username", state.username or _suggest_username(state.full_name)),
            Field("password", "Password", state.password or "", secret=True, limit=128),
            Field("again", "Repeat password", state.password or "", secret=True, limit=128),
        ],
        validate=check, derive=derive,
    )
    state.full_name, state.username, state.password = values["full_name"], values["username"], values["password"]
    return True


def _suggest_username(full_name: str) -> str:
    first = full_name.strip().split(" ")[0].lower() if full_name.strip() else ""
    candidate = re.sub(r"[^a-z0-9_-]", "", first)
    return candidate if USERNAME_RE.match(candidate) else "user"


def _user_exists(username: str) -> bool:
    return subprocess.run(["id", "--", username], capture_output=True).returncode == 0


# -- security --------------------------------------------------------------

def _autologin_help(username: str, encrypted: bool):
    def describe(values):
        if not values["autologin"]:
            return "The login screen asks for the password on every boot."
        warning = (
            f"Boots straight to {username}'s desktop. Convenient on a stick you carry, but anyone "
            "who boots it reaches your desktop without typing anything."
        )
        if not encrypted:
            # An encrypted stick gets a self-unlocking keyring, so the cost
            # named here applies only where that trade is not on offer.
            warning += (
                " Because this stick is not encrypted, the password keyring also stays locked: "
                "browsers and the Wi-Fi applet ask for your password the first time they need a "
                "saved one after each boot."
            )
        return warning, not encrypted
    return describe


def _sudo_help(encrypted: bool):
    def describe(values):
        if values["sudo_password"]:
            return "sudo asks for the account password before running anything as root."
        warning = (
            "Any command can run as root without asking, so anyone who reaches this desktop "
            "owns the whole system."
        )
        if values.get("autologin") and not encrypted:
            # Neither a passphrase at boot nor a password at the login screen,
            # so a waiver here would leave nothing at all on the path from
            # plugging the stick in to root on the machine it was plugged into.
            warning += " This stick is not encrypted and logs in automatically, so nothing else would stand in the way either."
        return warning, True
    return describe


def _found_help(encrypted: bool) -> str:
    where = "on the boot menu and above the passphrase prompt" if encrypted else "on the boot menu"
    return (f"A line shown {where}, for whoever finds this stick if you lose it. "
            "For example: If found, please email sam@example.com. Leave it empty for none.")


def _encrypted_at_boot() -> bool:
    """Whether this stick's passphrase was chosen at this machine.

    The initramfs offers encryption on the first boot of any stick written
    without --encrypt, and whoever accepts types the passphrase there and then.
    The finaliser records that by writing a crypttab of its own, which outlives
    the boot -- unlike /run/portlin/finalised, so setup still knows on a later
    run after a cancelled one.
    """
    if not CRYPTTAB.exists():
        return False
    return CRYPTTAB_BOOT_MARKER in CRYPTTAB.read_text()


def step_security(state: State):
    encrypted = state.luks_device is not None
    plan = state.account_plan or {}
    if state.autologin is None:
        state.autologin = bool(plan.get("autologin"))
    if state.sudo_password is None:
        state.sudo_password = not plan.get("sudo_nopasswd")
    # Nothing to offer when the passphrase is already theirs: they typed it
    # into the initramfs prompt on the way here.
    offer_passphrase = encrypted and not _encrypted_at_boot()
    if state.change_passphrase is None:
        state.change_passphrase = offer_passphrase
    rows = [
        Row("autologin", "Log in automatically", [(False, "no"), (True, "yes")], state.autologin,
            help=_autologin_help(state.username, encrypted)),
        Row("sudo_password", "sudo password", [(True, "ask for it"), (False, "never ask")],
            state.sudo_password, help=_sudo_help(encrypted)),
    ]
    if state.has_desktop:
        rows += [
            Row("lock_minutes", "Lock the screen after",
                [(5, "5 minutes"), (10, "10 minutes"), (15, "15 minutes"), (30, "30 minutes"), (0, "never")],
                state.lock_minutes,
                help=lambda v: ("The screen stays unlocked however long the machine is left.", True)
                if v["lock_minutes"] == 0 else
                f"Locks after {v['lock_minutes']} minutes without input. Unlocking takes the account password."),
            Row("lock_on_suspend", "Lock on suspend", [(True, "yes"), (False, "no")], state.lock_on_suspend,
                help="Lock before the machine sleeps, so closing the lid is enough to leave it."),
        ]
    if offer_passphrase:
        rows.append(Row("change_passphrase", "New disk passphrase", [(True, "yes"), (False, "no")],
                        state.change_passphrase,
                        help=lambda v: "Whoever built this stick chose its passphrase. Setup asks for a new "
                                       "one only you know, after everything else is applied."
                        if v["change_passphrase"] else
                        ("The passphrase stays the one whoever built this stick chose.", True)))
    rows.append(Row("found_message", "If found", text=True, value=state.found_message,
                    placeholder="no message", limit=FOUND_LIMIT, help=_found_help(encrypted)))
    values = ui.settings("Security", "Who can get in, and what a finder sees.", rows)
    state.autologin, state.sudo_password = values["autologin"], values["sudo_password"]
    state.lock_minutes = values.get("lock_minutes", state.lock_minutes)
    state.lock_on_suspend = values.get("lock_on_suspend", state.lock_on_suspend)
    state.change_passphrase = values.get("change_passphrase", False)
    state.found_message = _clean_found_message(values["found_message"])
    return True


def _clean_found_message(text: str) -> str:
    """One printable line that is safe in a GRUB theme string and a plain file."""
    text = "".join(char for char in text if char.isprintable())
    text = re.sub(r"\s+", " ", text.replace('"', "'").replace("\\", "/")).strip()
    return text[:FOUND_LIMIT]


