# Applying the answers
# --------------------------------------------------------------------------

def apply_keyboard(layout: str) -> None:
    Path("/etc/default/keyboard").write_text(
        "\n".join(
            [
                "XKBMODEL=pc105",
                f'XKBLAYOUT="{layout}"',
                'XKBVARIANT=""',
                'XKBOPTIONS=""',
                'BACKSPACE="guess"',
                "",
            ]
        )
    )
    # Keyboard only: a full setupcon also reloads the font from
    # /etc/default/console-setup, putting back the 8x16 that console_font()
    # replaced and shrinking setup mid-way on a high-resolution screen.
    run(["setupcon", "--keyboard-only", "--save"], check=False)
    run(["localectl", "set-x11-keymap", layout], check=False)


def apply_locale(locale_name: str) -> None:
    Path("/etc/locale.gen").write_text(f"{locale_name} UTF-8\nC.UTF-8 UTF-8\n")
    run(["locale-gen"])
    Path("/etc/default/locale").write_text(f'LANG="{locale_name}"\n')
    run(["localectl", "set-locale", f"LANG={locale_name}"], check=False)


def apply_timezone(timezone: str) -> None:
    if run(["timedatectl", "set-timezone", timezone], check=False).returncode != 0:
        run(["ln", "-sf", f"/usr/share/zoneinfo/{timezone}", "/etc/localtime"], check=False)
        Path("/etc/timezone").write_text(f"{timezone}\n")


def apply_clock(local: bool) -> None:
    """Say which time the hardware clock keeps, without rewriting the clock.

    --adjust-system-clock makes timedatectl reread the hardware clock under
    the new rule, rather than write this boot's time back into it. Writing it
    back is what would shift the clock of the Windows PC the stick is in.
    """
    done = run(["timedatectl", "set-local-rtc", "1" if local else "0", "--adjust-system-clock"], check=False)
    if done.returncode != 0:
        ADJTIME.write_text("0.0 0 0.0\n0\n" + ("LOCAL" if local else "UTC") + "\n")


def apply_hostname(hostname: str) -> None:
    Path("/etc/hostname").write_text(f"{hostname}\n")
    hosts = Path("/etc/hosts")
    lines = [
        line for line in hosts.read_text().splitlines()
        if not line.startswith("127.0.1.1")
    ]
    lines.insert(1, f"127.0.1.1\t{hostname}")
    hosts.write_text("\n".join(lines) + "\n")
    run(["hostnamectl", "set-hostname", hostname], check=False)


def apply_theme(theme: str) -> None:
    """Point every file that names a theme at the chosen one.

    Rewriting three of the four is worse than rewriting none: the greeter or
    the window borders keep the old name, and the desktop looks broken rather
    than merely unchanged. So a file that does not come out naming the chosen
    theme raises here, where the wizard can report it, rather than leaving a
    half-applied appearance behind.
    """
    for path, (pattern, replacement) in THEME_TARGETS.items():
        target = Path(path)
        text = target.read_text()
        rewritten = re.sub(pattern, replacement.format(theme=theme), text, count=1)
        if theme not in rewritten:
            raise RuntimeError(f"{path} does not name a theme in the expected form")
        target.write_text(rewritten)
    log(f"theme set to {theme}")


def apply_icon_theme(icon_theme: str) -> None:
    """Point every file that names an icon theme at the chosen set.

    Checks the set is on the disk before writing anything, which the widget
    theme's equivalent does not need to. First boot runs with no network, so a
    name the image never installed cannot be fetched later: naming it leaves a
    desktop with a wallpaper and blank space where every icon was, and no
    indication of why. Keeping the shipped default is a far better outcome than
    that, so an unknown name stops here.

    Then the same rule as apply_theme: rewriting three of the four is worse
    than rewriting none, because the greeter or the applications menu keeps the
    old set and the desktop looks broken rather than merely unchanged.
    """
    if not Path(f"/usr/share/icons/{icon_theme}/index.theme").exists():
        raise RuntimeError(f"the icon theme {icon_theme} is not installed")
    for path, (pattern, replacement) in ICON_THEME_TARGETS.items():
        target = Path(path)
        text = target.read_text()
        rewritten = re.sub(pattern, replacement.format(theme=icon_theme), text, count=1)
        if icon_theme not in rewritten:
            raise RuntimeError(f"{path} does not name an icon theme in the expected form")
        target.write_text(rewritten)
    log(f"icon theme set to {icon_theme}")


def apply_scale(scale: str) -> None:
    _write(SCALE_CONFIG, f"scale={scale}\n")
    _write(SCALE_SCRIPT, SCALE_SCRIPT_TEXT, 0o755)
    _write(SCALE_AUTOSTART, SCALE_AUTOSTART_TEXT)


def apply_screen_lock(minutes: int, on_suspend: bool) -> None:
    def flag(value: bool) -> str:
        return "true" if value else "false"

    _write(XFCONF_DEFAULTS / "xfce4-screensaver.xml", SCREENSAVER_XML.format(
        idle=flag(minutes > 0), minutes=minutes or 10,
        lock=flag(minutes > 0 or on_suspend), suspend=flag(on_suspend),
    ))
    _write(XFCONF_DEFAULTS / "xfce4-power-manager.xml", POWER_MANAGER_XML.format(suspend=flag(on_suspend)))
    _write(SCREEN_LOCK_CONFIG, f"minutes={minutes}\nsuspend={int(on_suspend)}\n")


def _lite_installed() -> bool:
    """Whether the lite session can start here: its entry and its compositor."""
    return LITE_SESSION_ENTRY.exists() and Path(LABWC).exists()


def _xfce_installed() -> bool:
    return XFCE_SESSION_ENTRY.exists()


def _installed_packages(names: list[str]) -> list[str]:
    """The names dpkg has installed, so apt is never asked about the rest.

    A stick built with --exclude, or a setup re-run after a removal, can lack
    some of them, and apt refuses a whole purge over one unknown name.
    """
    listing = run(["dpkg-query", "-W", "-f", "${Package} ${db:Status-Abbrev}\n", *names], check=False)
    return [line.split()[0] for line in listing.stdout.splitlines()
            if len(line.split()) > 1 and line.split()[1] == "ii"]


def remove_desktop(desktop: str) -> None:
    """Purge one desktop's own packages, and whatever only they needed.

    No network is needed to remove anything, which is what lets setup carry
    both desktops and keep only one.
    """
    installed = _installed_packages(DESKTOP_PACKAGES[desktop])
    if installed:
        run([*APT_ENV, "apt-get", "-y", "purge", *installed])
    run([*APT_ENV, "apt-get", "-y", "--purge", "autoremove"])
    log(f"removed the {desktop} desktop")


def apply_desktop(desktop: str) -> None:
    """Make the chosen desktop the one the login screen starts.

    Xfce is what LightDM picks with no setting at all, so choosing it removes
    the file rather than naming it. autologin-session as well as user-session,
    because an autologin never shows the greeter's session list and would
    otherwise start whatever LightDM's own default is.
    """
    if desktop != "lite":
        SESSION_CONFIG.unlink(missing_ok=True)
        return
    _write(SESSION_CONFIG, "\n".join([
        "# Written by portlin-firstboot. The session the login screen starts by default.",
        "[Seat:*]",
        f"user-session={LITE_SESSION}",
        f"autologin-session={LITE_SESSION}",
        "",
    ]))


def _account_from_earlier_run() -> str | None:
    """The account a setup that failed after creating it left behind, if any.

    Recorded in the sentinel, which only ever exists while setup is unfinished,
    so the next run can take that account up again rather than refusing its
    name as taken and forcing a second account onto the stick.
    """
    try:
        found = re.search(r"(?m)^account=(.+)$", SENTINEL.read_text())
    except OSError:
        return None
    return found.group(1) if found and USERNAME_RE.match(found.group(1)) else None


def apply_account(username: str, full_name: str, password: str) -> None:
    existing = {g.gr_name for g in grp.getgrall()}
    groups = [g for g in DESIRED_GROUPS if g in existing]
    if username == _account_from_earlier_run() and _user_exists(username):
        run(["usermod", "--comment", full_name, "--append", "--groups", ",".join(groups), username])
    else:
        run(
            [
                "useradd",
                "--create-home",
                "--shell", "/bin/bash",
                "--comment", full_name,
                "--groups", ",".join(groups),
                username,
            ]
        )
        SENTINEL.write_text(f"pending\naccount={username}\n")
    run(["chpasswd"], stdin=f"{username}:{password}\n")


def apply_sudo_password(username: str, required: bool) -> bool:
    """Record whether sudo asks this account for a password.

    Requiring one needs no file: the account is in the 'sudo' group and
    Debian's stock sudoers already prompts that group. Only the waiver has to
    be written down, so only the waiver has to be taken back.

    Returns whether the answer was honoured. A rule sudo refuses to parse
    disables sudo for every account, and root is locked on this image, so the
    stick would be left with no way to reach privilege at all. The rule is
    therefore written aside, judged by visudo while it is still inert, and
    moved into place only if it passes.
    """
    if required:
        SUDOERS_DROPIN.unlink(missing_ok=True)
        return True

    draft = SUDOERS_DROPIN.with_name(SUDOERS_DROPIN.name + ".draft")
    draft.write_text(SUDOERS_NOPASSWD_RULE.format(username=username))
    draft.chmod(0o440)
    checked = run(["visudo", "--check", "--file", str(draft)], check=False)
    if checked.returncode != 0:
        log(f"refusing an unparseable sudoers rule for {username!r}")
        draft.unlink(missing_ok=True)
        return False
    draft.replace(SUDOERS_DROPIN)
    return True


def apply_autologin(username: str, enabled: bool) -> None:
    config = Path("/etc/lightdm/lightdm.conf.d/10-portlin.conf")
    if not enabled:
        config.unlink(missing_ok=True)
        return
    # Debian's LightDM PAM configuration only permits autologin for members of
    # the 'autologin' group, so the group has to exist and contain the user.
    run(["groupadd", "-f", "autologin"], check=False)
    run(["usermod", "-aG", "autologin", username], check=False)
    config.parent.mkdir(parents=True, exist_ok=True)
    config.write_text(
        "\n".join(
            [
                "[Seat:*]",
                f"autologin-user={username}",
                "autologin-user-timeout=0",
                "",
            ]
        )
    )


def apply_keyring_autounlock(username: str) -> bool:
    """Give the account a login keyring that needs no password to open.

    Autologin sessions authenticate through the lightdm-autologin PAM service,
    which satisfies auth with pam_permit instead of including common-auth. That
    is what lets the desktop start with nothing typed, and it is also why
    pam_gnome_keyring never sees a password to unlock the login keyring with.
    The daemon still starts from common-session, so every libsecret client --
    browsers, the Wi-Fi applet -- meets a locked keyring and prompts for a login
    password the user may never have knowingly given the keyring.

    A keyring whose password is empty is opened by the daemon at startup without
    prompting, so creating one is what makes autologin quiet. This is only ever
    called for encrypted sticks, where LUKS already protects the secrets at rest
    and the keyring's own password guards nothing the boot passphrase has not
    covered. On an unencrypted stick the same change would leave saved passwords
    readable to anyone who picks the stick up, so the security screen warns
    instead.

    gnome-keyring's on-disk format is encrypted even when the password is empty,
    so writing the file directly would mean deriving keys here. --login is the
    entry point PAM itself feeds; an empty password on stdin therefore produces
    exactly the right keyring without this script knowing the format.
    """
    home = Path(os.path.expanduser(f"~{username}"))
    keyring = home / ".local/share/keyrings/login.keyring"
    if keyring.exists():
        # Whatever password it already carries is the user's to change, and
        # replacing it here would silently discard secrets stored under it.
        return True
    if not Path(GNOME_KEYRING_DAEMON).exists():
        # A --minimal stick has no keyring at all, so nothing can prompt.
        return True

    # --daemonize so the parent exits once the keyring exists; the daemon it
    # leaves behind belongs to no session, so it is stopped again rather than
    # left to race the real one the display manager is about to start.
    run(
        [
            "runuser", "-u", username, "--",
            "env", f"HOME={home}", f"XDG_DATA_HOME={home}/.local/share",
            GNOME_KEYRING_DAEMON, "--daemonize", "--login",
        ],
        stdin="",
        check=False,
    )
    # -f, because the kernel truncates a process name to 15 characters and
    # "gnome-keyring-daemon" would never match it exactly.
    run(["pkill", "-u", username, "-f", GNOME_KEYRING_DAEMON], check=False)

    if not keyring.exists():
        log(f"keyring: {keyring} was not created; autologin will prompt for secrets")
        return False
    return True


def _connection_file_name(ssid: str, identifier: str) -> str:
    safe = re.sub(r"[^A-Za-z0-9._-]", "_", ssid).strip("._") or "wifi"
    return f"{safe}-{identifier[:8]}.nmconnection"


def apply_network(wifi: dict | None, mac: str) -> None:
    """Keep the Wi-Fi joined during setup, and the hardware-address rule."""
    if wifi and Path(wifi["path"]).exists():
        source = Path(wifi["path"])
        _write_private(NM_CONNECTIONS / _connection_file_name(wifi["ssid"], wifi["uuid"]), source.read_text())
        source.unlink()
        run(["nmcli", "connection", "reload"], check=False)
    if mac == "off":
        NM_MAC_CONF.unlink(missing_ok=True)
    else:
        _write(NM_MAC_CONF, MAC_CONF.format(mode=mac))
    NM_RUN_MAC_CONF.unlink(missing_ok=True)
    run(["nmcli", "general", "reload", "conf"], check=False)


def apply_drivers(entries: list[str], progress: Progress) -> bool:
    """Install drivers through portlin-install, narrating its progress lines.

    Returns whether a kernel module was built, which needs a restart before
    the driver is in use.
    """
    argv = [INSTALL_TOOL, "install", *entries]
    log(f"run: {' '.join(argv)}")
    proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, text=True)
    reboot, failed = False, []
    for line in proc.stdout:
        line = line.rstrip()
        log(f"  {line}")
        if line.startswith("::step "):
            progress.note(line[7:].strip())
        elif line.startswith("::progress "):
            try:
                progress.note(progress.details[progress.current], int(line.split()[1]) / 100)
            except (ValueError, IndexError):
                pass
        elif line.startswith("::reboot"):
            reboot = True
        elif line.startswith("::result failed"):
            # "::result failed <id> <reason>": the reason is what makes the
            # red line on the screen worth reading.
            parts = line.split(maxsplit=3)
            entry = parts[2] if len(parts) > 2 else "?"
            failed.append(f"{entry}: {parts[3]}" if len(parts) > 3 else entry)
        else:
            progress.note(progress.details[progress.current])
    if proc.wait() != 0 or failed:
        raise RuntimeError(f"portlin-install could not install {', '.join(failed) or ', '.join(entries)}")
    return reboot


def apply_swap(percent: int) -> None:
    if not percent:
        run(["systemctl", "disable", "--now", "zramswap.service"], check=False)
        return
    try:
        text = ZRAM_CONFIG.read_text()
    except OSError:
        text = "ALGO=zstd\n"
    if re.search(r"(?m)^PERCENT=", text):
        text = re.sub(r"(?m)^PERCENT=.*$", f"PERCENT={percent}", text)
    else:
        text = text.rstrip("\n") + f"\nPERCENT={percent}\n"
    ZRAM_CONFIG.write_text(text)
    run(["systemctl", "enable", "zramswap.service"], check=False)
    run(["systemctl", "restart", "zramswap.service"], check=False)


def _is_swapfile_entry(line: str) -> bool:
    fields = line.split()
    return len(fields) >= 3 and fields[0] == str(SWAPFILE) and fields[2] == "swap"


def _swapfile_gigabytes() -> int:
    """Size of the swap file fstab already names, in whole GB, or 0."""
    try:
        listed = any(_is_swapfile_entry(line) for line in FSTAB.read_text().splitlines())
        return SWAPFILE.stat().st_size // 1024**3 if listed else 0
    except OSError:
        return 0


def apply_swapfile(gigabytes: int) -> None:
    """Make, resize or remove the swap file, and list it in fstab.

    fstab only names the file once it is a working swap area, so a failure
    part way leaves a boot that ignores it rather than one that waits on it.
    """
    if gigabytes == _swapfile_gigabytes():
        return
    try:
        lines = FSTAB.read_text().splitlines()
    except OSError:
        lines = []
    lines = [line for line in lines if not _is_swapfile_entry(line)]
    if SWAPFILE.exists():
        run(["swapoff", str(SWAPFILE)], check=False)
        SWAPFILE.unlink()
    FSTAB.write_text("\n".join(lines) + "\n")
    if not gigabytes:
        return
    stats = os.statvfs(SWAPFILE.parent)
    if gigabytes * 1024**3 + SWAPFILE_HEADROOM > stats.f_bavail * stats.f_frsize:
        raise RuntimeError(f"not enough room on the drive for a {gigabytes} GB swap file")
    # Created owner-only before it holds anything: it will hold pages of memory.
    os.close(os.open(SWAPFILE, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600))
    try:
        run(["fallocate", "-l", f"{gigabytes}G", str(SWAPFILE)])
        run(["mkswap", str(SWAPFILE)])
    except Exception:
        SWAPFILE.unlink(missing_ok=True)
        raise
    lines.append(f"{SWAPFILE}\tnone\tswap\tsw,pri={SWAPFILE_PRIORITY}\t0\t0")
    FSTAB.write_text("\n".join(lines) + "\n")
    run(["swapon", "--priority", str(SWAPFILE_PRIORITY), str(SWAPFILE)], check=False)


def apply_ssh(enabled: bool) -> None:
    """Turn the SSH server on or off.

    The image ships without host keys, because a rootfs is written to many
    sticks and keys baked into it would be shared by all of them. Each stick
    makes its own the first time its server is switched on.
    """
    if enabled:
        run(["ssh-keygen", "-A"])
        run(["systemctl", "enable", "--now", "ssh.service"])
    else:
        run(["systemctl", "disable", "--now", "ssh.service"], check=False)


def apply_firewall(enabled: bool, ssh: bool) -> None:
    if not enabled:
        run([UFW, "--force", "disable"], check=False)
        return
    run([UFW, "default", "deny", "incoming"])
    run([UFW, "default", "allow", "outgoing"])
    if ssh:
        # limit rather than allow: six attempts in thirty seconds from one
        # address and that address is refused for a while.
        run([UFW, "limit", "22/tcp"])
    run([UFW, "--force", "enable"])
    run(["systemctl", "enable", "ufw.service"], check=False)


def apply_wear(wanted: dict, initial: dict) -> None:
    for key, value in wanted.items():
        if initial.get(key) != value:
            run([WEAR_TOOL, "set", key, "1" if value else "0"])


def apply_found_message(text: str) -> None:
    """Write the owner's note where a finder will see it, or remove it everywhere."""
    if GRUB_THEME.exists():
        theme = GRUB_THEME.read_text()
        theme = re.sub(rf"\n?{re.escape(FOUND_BEGIN)}.*?{re.escape(FOUND_END)}\n?", "\n", theme, flags=re.S)
        if text:
            theme = theme.rstrip("\n") + "\n\n" + "\n".join([
                FOUND_BEGIN,
                "+ label {",
                f'    text = "{text}"',
                "    left = 0",
                "    top = 6%",
                "    width = 100%",
                '    align = "center"',
                '    color = "#E8EDF3"',
                '    font = "GNU Unifont Regular 16"',
                "}",
                FOUND_END,
            ]) + "\n"
        GRUB_THEME.write_text(theme)
    if text:
        _write(FOUND_MESSAGE, text + "\n")
        _write(FOUND_HOOK, FOUND_HOOK_TEXT, 0o755)
        _write(FOUND_PREMOUNT, FOUND_PREMOUNT_TEXT, 0o755)
    else:
        for path in (FOUND_MESSAGE, FOUND_HOOK, FOUND_PREMOUNT):
            path.unlink(missing_ok=True)


def drop_passphrase_stash() -> None:
    """Take the keyscript back out of crypttab now that setup is over.

    The keyscript exists to hand this wizard the passphrase typed at boot. Left
    in place it would go on writing that passphrase into /run on every future
    boot, with no wizard coming along to spend and delete it. The initramfs
    carries its own copy of crypttab, so this has to happen before the rebuild
    below rather than after it.
    """
    if CRYPTTAB.exists():
        current = CRYPTTAB.read_text()
        if STASH_KEYSCRIPT_OPTION in current:
            CRYPTTAB.write_text(current.replace(f",{STASH_KEYSCRIPT_OPTION}", ""))
    # Also covers the stick whose owner declined the expansion, where nothing
    # else would ever have consumed the file.
    STASH.unlink(missing_ok=True)


def refresh_initramfs_for_keymap(encrypted: bool) -> None:
    """Rebuild the initramfs so the LUKS prompt uses the chosen keyboard layout.

    The passphrase prompt happens in the initramfs, long before /etc/default/keyboard
    is read at boot. Without this rebuild a passphrase containing symbols is typed
    on a US layout no matter what the user selected here, which is a genuinely
    horrible way to be locked out of your own stick. The same rebuild carries
    the owner's "if found" message in, which is only ever shown at that prompt.
    """
    if not encrypted:
        return
    run(["update-initramfs", "-u", "-k", "all"], check=False)


def apply_all(state: State) -> None:
    """Apply every answer, in the order the system needs them.

    Each task is either essential, in which case a failure stops setup and it
    runs again next boot, or optional, in which case the failure is reported
    at the end and everything else still happens. Nothing optional is allowed
    to leave a stick without an account.
    """
    encrypted = state.luks_device is not None
    tasks: list[tuple[str, object, bool]] = []

    def task(label, function, optional=False):
        tasks.append((label, function, optional))

    # Before anything else: if the initramfs just encrypted this drive, the
    # finaliser has already made that permanent, so a crash later in setup
    # cannot leave a stick that is encrypted but no longer bootable.
    if finalise_encryption():
        task("Encryption recorded during boot", lambda: None)
    if state.expand:
        # First, so everything below writes into the full-size filesystem
        # rather than the handful of gigabytes the image shipped with.
        task("Growing the system to fill the drive", apply_expand)
    if state.wear is not None and state.wear_initial is not None:
        task("Storage wear settings", lambda: apply_wear(state.wear, state.wear_initial), True)
    task("Language and time zone", lambda: (apply_locale(state.locale), apply_timezone(state.timezone),
                                            apply_clock(bool(state.rtc_local))))
    task("Computer name", lambda: apply_hostname(state.hostname))
    if state.password is not None:
        task(f"Creating the account {state.username}",
             lambda: apply_account(state.username, state.full_name, state.password))
    if state.migration:
        # Right after the account exists, so files land under the right uid,
        # and before anything that reads the home directory.
        def restore():
            if not apply_migration():
                state.warnings.append("Not everything could be restored. The details are in "
                                      "/var/log/portlin-migrate.log, and Migrate in the menu can try again.")
            if state.password is None and not _user_exists(state.username):
                raise RuntimeError(f"the account {state.username} was not created by the restore")
        task(f"Restoring from {state.migration.get('label', 'the old drive')}", restore)

    def privilege():
        if not apply_sudo_password(state.username, state.sudo_password):
            state.warnings.append("The rule that skips the sudo password could not be installed, "
                                  f"so sudo asks {state.username} for one after all.")
    task("Administrator access", privilege)

    def login():
        apply_autologin(state.username, state.autologin)
        # Only together: a password login unlocks the keyring by itself, and
        # without LUKS a passwordless keyring trades away real protection.
        if state.autologin and encrypted:
            apply_keyring_autounlock(state.username)
    task("Login", login)
    if state.has_desktop:
        def appearance():
            if state.theme:
                apply_theme(state.theme)
            if state.icon_theme:
                apply_icon_theme(state.icon_theme)
        if state.theme or state.icon_theme:
            task("Theme and icons", appearance)
        if state.choose_desktop:
            task("Desktop", lambda: apply_desktop(state.desktop))
            other = "lite" if state.desktop == "xfce" else "xfce"
            task(f"Removing {dict(DESKTOPS)[other]}", lambda: remove_desktop(other), True)
        task("Display scale", lambda: apply_scale(state.scale), True)
        task("Screen lock", lambda: apply_screen_lock(state.lock_minutes, state.lock_on_suspend), True)
    task("Network", lambda: apply_network(state.wifi, state.mac), True)
    if state.drivers and state.online:
        def drivers():
            # progress is bound below, before any task runs.
            state.reboot = apply_drivers(state.drivers, progress) or state.reboot
        task("Installing drivers", drivers, True)

    def swap():
        # Restarting zramswap pulls every swapped page back into RAM, so it
        # is only worth doing when the size actually changes.
        if not state.swap or state.swap != _zram_percent():
            apply_swap(state.swap)
    task("Compressed swap", swap, True)
    if state.swapfile or _swapfile_gigabytes():
        task("Swap file", lambda: apply_swapfile(state.swapfile), True)
    if Path(SSHD).exists():
        task("SSH server", lambda: apply_ssh(state.ssh), True)
    if Path(UFW).exists():
        task("Firewall", lambda: apply_firewall(state.firewall, state.ssh and Path(SSHD).exists()), True)
    task("If-found message", lambda: apply_found_message(state.found_message), True)
    task("Boot files", lambda: (drop_passphrase_stash(), refresh_initramfs_for_keymap(encrypted)))

    progress = Progress(ui, "Applying", "Setting the stick up. Do not remove it.", [t[0] for t in tasks])
    for index, (label, function, optional) in enumerate(tasks):
        progress.start(index)
        try:
            function()
        except Exception as exc:
            if not optional:
                raise
            log(traceback.format_exc())
            progress.finish(index, "fail", str(exc).splitlines()[0] if str(exc) else "failed")
            state.warnings.append(f"{label}: {str(exc).splitlines()[0] if str(exc) else 'failed'}")
            continue
        progress.finish(index)


# --------------------------------------------------------------------------

STEPS = [
    ("welcome", "Welcome", step_welcome),
    ("restore", "Restore", step_migration),
    ("keyboard", "Keyboard", step_keyboard),
    ("language", "Language", step_locale),
    ("time", "Time zone", step_timezone),
    ("network", "Network", step_network),
    ("account", "Account", step_account),
    ("security", "Security", step_security),
    ("appearance", "Appearance", step_appearance),
    ("hardware", "Hardware", step_hardware),
    ("services", "Services", step_services),
    ("storage", "Storage", step_storage),
    ("review", "Review", step_review),
]


def wizard() -> State:
    state = State()
    state.candidates = migration_candidates()
    state.luks_device = _luks_device()
    state.has_desktop = _desktop_installed()
    # Only while both are here to choose between. A setup that runs again
    # after one was removed keeps the one that is left.
    state.choose_desktop = state.has_desktop and _lite_installed() and _xfce_installed()
    steps = [step for step in STEPS if step[0] != "restore" or state.candidates]
    ui.sections = [(key, label) for key, label, _ in steps]
    keys = [key for key, _, _ in steps]

    # Walk the steps, keeping the ones actually shown so Esc can retrace them.
    # The review step hands back a section to edit; after that one step, the
    # walk jumps straight back to the review rather than through everything
    # after it again.
    index, shown, review_at = 0, [], None
    while index < len(steps):
        key, _, step = steps[index]
        ui.current = key
        try:
            outcome = step(state)
        except Back:
            if review_at is not None:
                index, review_at = review_at, None
            elif shown:
                index = shown.pop()
            continue
        ui.visited.add(key)
        if isinstance(outcome, str):
            review_at, index = index, keys.index(outcome)
            continue
        # An edit from the review is a detour, not a new step on the way back:
        # recording it would make Esc from the review land on it twice.
        if outcome is not False and review_at is None:
            shown.append(index)
        if review_at is not None:
            index, review_at = review_at, None
            continue
        index += 1

    ui.current = ""
    ui.postpone_allowed = False
    apply_all(state)
    if state.luks_device and state.change_passphrase:
        step_change_passphrase(state.luks_device)

    SENTINEL.unlink(missing_ok=True)
    run(["systemctl", "disable", "portlin-firstboot.service"], check=False)

    text = (f"Welcome, {state.full_name or state.username}.\n\n"
            "Everything you change on this stick is saved to it, on whatever machine you plug it into next.")
    if state.warnings:
        text += "\n\nSome things need another look:\n" + "\n".join(f"  {ui.g('fail')} {w}" for w in state.warnings)
    buttons = ["Start the desktop"]
    if state.reboot:
        text += "\n\nThe new driver is in use after a restart."
        buttons = ["Restart now", "Start the desktop"]
    choice = ui.dialog("All set", text, buttons, back=False)
    state.reboot = state.reboot and choice == 0
    return state


def _say(title: str, text: str) -> None:
    """Report on whatever is left of the screen, curses or not."""
    if ui.screen is not None:
        try:
            ui.message(title, text)
            return
        except curses.error:
            pass
    print(f"\n{title}\n\n{text}\n")


def main() -> int:
    if os.geteuid() != 0:
        print("portlin-firstboot must run as root", file=sys.stderr)
        return 1

    restart = False
    try:
        claim_console(True)
        ui.start()
        restart = wizard().reboot
    except Cancelled:
        # The sentinel stays, so setup runs again on the next boot rather than
        # leaving the stick with no way in.
        ui.postpone_allowed = False
        _say("Setup postponed", POSTPONE_TEXT)
        return 1
    except Exception:
        detail = traceback.format_exc()
        log(detail, force=True)
        # stderr is the journal, for when the log cannot be written either.
        print(detail, file=sys.stderr)
        ui.postpone_allowed = False
        _say(
            "Setup failed",
            "Something went wrong during setup.\n\n"
            f"The details are in {LOG}.\n\n"
            "Setup will run again the next time this stick boots.",
        )
        return 1
    finally:
        # Always release the tool's hold on the source drive, including on the
        # failure paths above, so a crash mid-setup does not leave it open.
        close_migration()
        # Always hand the console back, including on the failure paths above.
        ui.stop()
        claim_console(False)
    if restart:
        run(["systemctl", "reboot"], check=False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
