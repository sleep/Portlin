# Brand tokens. On the Linux console these replace the eight palette slots
# outright, so ink is the console's black and crimson its red; elsewhere they
# are approximated from the 256-colour cube.
INK, PANEL, LINE, MUTED, PAPER, ACCENT = "12161C", "1A212B", "2C3542", "7C8B9E", "E8EDF3", "FF3355"
SELECT, DIM = "232B37", "B9C3CF"
LINUX_PALETTE = (INK, ACCENT, PANEL, LINE, MUTED, SELECT, DIM, PAPER)
SLOTS_LINUX = {"ink": 0, "accent": 1, "panel": 2, "line": 3, "muted": 4, "select": 5, "dim": 6, "paper": 7}
SLOTS_256 = {"ink": 233, "accent": 197, "panel": 234, "line": 237, "muted": 103, "select": 235, "dim": 250, "paper": 255}
SLOTS_8 = {"ink": 0, "accent": 1, "panel": 0, "line": 4, "muted": 6, "select": 4, "dim": 7, "paper": 7}
ROLES = {
    "text": ("paper", "ink"),
    "muted": ("muted", "ink"),
    "accent": ("accent", "ink"),
    "side": ("paper", "panel"),
    "side_muted": ("muted", "panel"),
    "side_accent": ("accent", "panel"),
    "focus": ("paper", "line"),
    "focus_muted": ("dim", "line"),
    "focus_accent": ("accent", "line"),
    "field": ("paper", "panel"),
    "button": ("paper", "line"),
    "button_focus": ("paper", "accent"),
    "bar": ("ink", "muted"),
    "bar_accent": ("ink", "accent"),
}
# whiptail's colours for the screens the migration tool draws itself, named
# by the console slots LINUX_PALETTE repaints: black is ink, red crimson,
# green the panel, brown the rule, blue muted and lightgray paper.
NEWT_COLORS = (
    "root=lightgray,black window=lightgray,green border=blue,green "
    "title=lightgray,green textbox=lightgray,green button=lightgray,brown "
    "actbutton=lightgray,red compactbutton=lightgray,green listbox=lightgray,green "
    "actlistbox=lightgray,brown actsellistbox=lightgray,red sellistbox=lightgray,green "
    "entry=lightgray,brown disentry=blue,green checkbox=lightgray,green "
    "actcheckbox=lightgray,brown emptyscale=,brown fullscale=,red "
    "helpline=blue,black roottext=blue,black"
)

# Only glyphs the Linux console's default font was seen to draw: Latin-1, the
# arrows, the ellipsis and the black square. It has no block elements -- half
# blocks came out as diamonds on a real boot -- so every bar, marker and fill
# is a run of spaces in a background colour instead, which any font can draw.
UNICODE_GLYPHS = {
    "done": "\u25a0", "todo": "\u00b7", "empty": "\u00b7", "fail": "\u00d7",
    "more": "\u2026", "keys": "\u2191\u2193", "turn": "\u2190\u2192",
}
ASCII_GLYPHS = {
    "done": "*", "todo": "-", "empty": ".", "fail": "x",
    "more": "...", "keys": "up/down", "turn": "left/right",
}
SPINNER = "|/-\\"

SIDEBAR = 24
# Narrower than this and the step list gives way to a one-line header.
SIDEBAR_MIN_COLUMNS = 72


class Field:
    """One line of a form."""

    def __init__(self, key: str, label: str, value: str = "", *, secret: bool = False,
                 hint: str = "", limit: int = 64) -> None:
        self.key, self.label, self.value = key, label, value
        self.secret, self.hint, self.limit = secret, hint, limit


class Row:
    """One setting on a settings screen: a choice, or a line of text.

    help is a string, or a function of every row's current value returning a
    string, or (string, warning) to draw it in crimson. That is what lets the
    sudo row say something stronger once automatic login has been switched on
    two rows above it.
    """

    def __init__(self, key: str, label: str, choices=None, value=None, *, help="",
                 text: bool = False, placeholder: str = "", limit: int = 64,
                 enabled: bool = True) -> None:
        self.key, self.label, self.choices = key, label, list(choices or [])
        self.value = value if value is not None or text else self.choices[0][0]
        if text and self.value is None:
            self.value = ""
        self.help, self.text, self.placeholder = help, text, placeholder
        self.limit, self.enabled = limit, enabled

    def describe(self, values: dict) -> tuple[str, bool]:
        described = self.help(values) if callable(self.help) else self.help
        if isinstance(described, tuple):
            return described
        return described or "", False

    def shown(self, value) -> str:
        if self.text:
            return value
        return dict(self.choices).get(value, str(value))


class UI:
    """portlin's setup screen: a step list on the left, one question on the right.

    Every widget draws the whole screen and loops on keys until it has an
    answer. Esc raises Back, which the wizard turns into the previous step;
    F10 or Ctrl-C asks whether to postpone, and raises Cancelled if so.
    """

    def __init__(self) -> None:
        self.screen = None
        self.sections: list[tuple[str, str]] = []
        self.current = ""
        self.visited: set[str] = set()
        self.postpone_allowed = True
        self.glyphs = ASCII_GLYPHS
        self.colors: dict[str, int] = {}
        self.linux_palette = False
        self._postponing = False

    # -- lifecycle ----------------------------------------------------------

    def start(self) -> None:
        # Esc is Back, and ncurses otherwise waits a full second to be sure it
        # is not the start of an arrow key.
        os.environ.setdefault("ESCDELAY", "25")
        try:
            locale.setlocale(locale.LC_ALL, "")
        except locale.Error:
            pass
        if "utf" not in (locale.getpreferredencoding(False) or "").lower():
            # A unit started with no LANG gets the C locale, in which curses
            # can neither draw the mark nor read a typed accent. C.UTF-8 is
            # built into Debian's libc, so it is there whatever locale.gen says.
            try:
                locale.setlocale(locale.LC_ALL, "C.UTF-8")
            except locale.Error:
                pass
        if "utf" in (locale.getpreferredencoding(False) or "").lower():
            self.glyphs = UNICODE_GLYPHS
        try:
            self.screen = curses.initscr()
        except curses.error:
            # A TERM with no terminfo entry. Every place this runs is a Linux
            # VT, and that entry is in ncurses-base, which nothing removes.
            os.environ["TERM"] = "linux"
            self.screen = curses.initscr()
        curses.noecho()
        # raw rather than cbreak: Ctrl-C arrives as a key, which asks whether
        # to postpone, instead of a SIGINT that could land while useradd or
        # chpasswd is half done.
        curses.raw()
        self.screen.keypad(True)
        self._cursor(False)
        self._colours()

    def stop(self) -> None:
        if self.screen is None:
            return
        try:
            self.screen.erase()
            self.screen.refresh()
            curses.noraw()
            self.screen.keypad(False)
            curses.echo()
            curses.endwin()
        except curses.error:
            pass
        self.screen = None
        self._reset_palette()

    @contextlib.contextmanager
    def suspended(self):
        """Hand the bare terminal to a child that draws its own screens."""
        if self.screen is None:
            yield
            return
        curses.def_prog_mode()
        curses.endwin()
        self._emit("\033[H\033[2J")
        try:
            yield
        finally:
            curses.reset_prog_mode()
            self.repaint()

    def repaint(self) -> None:
        """Redraw from nothing, after anything else has written to the console.

        setupcon reloads the keymap, and children run in the
        foreground draw over everything, so the next frame cannot assume the
        terminal still holds the last one.
        """
        if self.screen is None:
            return
        if self.linux_palette:
            self._set_linux_palette()
        self.screen.clear()
        self.screen.refresh()

    def _emit(self, text: str) -> None:
        try:
            os.write(sys.stdout.fileno(), text.encode())
        except (OSError, ValueError):
            pass

    def _cursor(self, visible: bool) -> None:
        try:
            curses.curs_set(1 if visible else 0)
        except curses.error:
            pass

    def _colours(self) -> None:
        if not curses.has_colors():
            self.colors = {
                "text": curses.A_NORMAL, "muted": curses.A_DIM, "accent": curses.A_BOLD,
                "side": curses.A_NORMAL, "side_muted": curses.A_DIM, "side_accent": curses.A_BOLD,
                "focus": curses.A_REVERSE, "focus_muted": curses.A_REVERSE,
                "focus_accent": curses.A_REVERSE | curses.A_BOLD, "field": curses.A_UNDERLINE,
                "button": curses.A_NORMAL, "button_focus": curses.A_REVERSE,
                "bar": curses.A_REVERSE, "bar_accent": curses.A_REVERSE,
            }
            return
        curses.start_color()
        term = os.environ.get("TERM", "")
        if term.startswith("linux"):
            self._set_linux_palette()
            slots = SLOTS_LINUX
            # The migration tool's whiptail screens inherit this, and come out
            # in the same palette as everything around them.
            os.environ["NEWT_COLORS"] = NEWT_COLORS
        elif curses.COLORS >= 256:
            slots = SLOTS_256
        else:
            slots = SLOTS_8
        for number, (role, (fg, bg)) in enumerate(ROLES.items(), start=1):
            curses.init_pair(number, slots[fg], slots[bg])
            self.colors[role] = curses.color_pair(number)
        self.screen.bkgd(" ", self.colors["text"])

    def _set_linux_palette(self) -> None:
        # OSC P sets one console palette slot. The bright half gets the same
        # colours, so text the console decides to embolden keeps its colour.
        self._emit("".join(f"\033]P{index:X}{colour}" for index, colour in enumerate(LINUX_PALETTE * 2)))
        self.linux_palette = True

    def _reset_palette(self) -> None:
        if self.linux_palette:
            self._emit("\033]R")
            self.linux_palette = False

    # -- drawing ------------------------------------------------------------

    def c(self, role: str) -> int:
        return self.colors.get(role, 0)

    def g(self, name: str) -> str:
        return self.glyphs[name]

    def put(self, y: int, x: int, text: str, attr: int = 0, width: int | None = None) -> None:
        height, columns = self.screen.getmaxyx()
        if y < 0 or y >= height or x < 0 or x >= columns:
            return
        limit = columns - x if width is None else min(width, columns - x)
        if limit <= 0:
            return
        try:
            self.screen.addstr(y, x, text[:limit], attr)
        except curses.error:
            # Writing the bottom-right cell draws it and then raises, because
            # the cursor has nowhere to go.
            pass

    def block(self, y: int, x: int, width: int, role: str) -> None:
        """A solid run of colour, drawn as spaces so it needs nothing from the font."""
        self.put(y, x, " " * width, self.c(role))

    def wrap(self, text: str, width: int) -> list[str]:
        lines: list[str] = []
        for paragraph in text.split("\n"):
            lines += textwrap.wrap(paragraph, max(width, 10)) or [""]
        return lines

    def frame(self, title: str, text: str = "", hints=()) -> tuple[int, int, int, int]:
        """Clear the screen, draw the chrome, and return the content area.

        The area is (top, left, height, width), starting below the title and
        the wrapped introduction.
        """
        self.screen.erase()
        height, columns = self.screen.getmaxyx()
        if columns >= SIDEBAR_MIN_COLUMNS and height >= 20:
            self._sidebar(height)
            left, top = SIDEBAR + 3, 1
        else:
            self._header(columns)
            left, top = 2, 2
        width = max(columns - left - 2, 20)
        self.put(top, left, title, self.c("text") | curses.A_BOLD)
        y = top + 2
        if text:
            for line in self.wrap(text, width):
                self.put(y, left, line, self.c("muted"))
                y += 1
            y += 1
        self._footer(height, columns, left, hints)
        return y, left, max(height - 2 - y, 3), width

    def _sidebar(self, height: int) -> None:
        side = self.c("side")
        for y in range(height):
            self.put(y, 0, " " * SIDEBAR, side)
        # The mark: the stick's four partitions from the device start, in their
        # true rank order, the encrypted root last and crimson.
        for row, width in enumerate((3, 6, 8, 12)):
            self.block(1 + row, 2, width, "bar_accent" if row == 3 else "bar")
        self.put(6, 2, "portlin", side | curses.A_BOLD)
        self.put(7, 2, "first-boot setup", self.c("side_muted"))
        y = 9
        for key, label in self.sections:
            if y >= height - 2:
                break
            if key == self.current:
                self.put(y, 0, " " * SIDEBAR, self.c("focus"))
                self.block(y, 0, 1, "bar_accent")
                self.put(y, 3, label, self.c("focus") | curses.A_BOLD)
            elif key in self.visited:
                self.put(y, 1, self.g("done"), self.c("side_muted"))
                self.put(y, 3, label, side)
            else:
                self.put(y, 1, self.g("todo"), self.c("side_muted"))
                self.put(y, 3, label, self.c("side_muted"))
            y += 1

    def _header(self, columns: int) -> None:
        side = self.c("side")
        self.put(0, 0, " " * columns, side)
        self.put(0, 1, "portlin", side | curses.A_BOLD)
        keys = [key for key, _ in self.sections]
        label = dict(self.sections).get(self.current, "")
        where = f"  setup  {self.g('todo')}  {label}" if label else "  setup"
        self.put(0, 8, where, self.c("side_muted"))
        if self.current in keys:
            count = f"{keys.index(self.current) + 1}/{len(keys)} "
            self.put(0, columns - len(count) - 1, count, self.c("side_muted"))

    def _footer(self, height: int, columns: int, left: int, hints) -> None:
        x = left
        for key, word in hints:
            self.put(height - 1, x, key, self.c("text") | curses.A_BOLD)
            x += len(key) + 1
            self.put(height - 1, x, word, self.c("muted"))
            x += len(word) + 3
        if self.postpone_allowed and not self._postponing:
            text = "F10 postpone"
            if x + len(text) < columns - 1:
                self.put(height - 1, columns - len(text) - 2, "F10", self.c("text") | curses.A_BOLD)
                self.put(height - 1, columns - len(text) + 2, "postpone", self.c("muted"))

    def _buttons(self, y: int, x: int, labels, focus: int) -> None:
        for index, label in enumerate(labels):
            role = "button_focus" if index == focus else "button"
            text = f"  {label}  "
            self.put(y, x, text, self.c(role) | (curses.A_BOLD if index == focus else 0))
            x += len(text) + 2

    # -- input --------------------------------------------------------------

    KEYS = {
        curses.KEY_UP: "UP", curses.KEY_DOWN: "DOWN", curses.KEY_LEFT: "LEFT",
        curses.KEY_RIGHT: "RIGHT", curses.KEY_HOME: "HOME", curses.KEY_END: "END",
        curses.KEY_PPAGE: "PGUP", curses.KEY_NPAGE: "PGDN", curses.KEY_BACKSPACE: "BACKSPACE",
        curses.KEY_DC: "DELETE", curses.KEY_ENTER: "ENTER", curses.KEY_BTAB: "BTAB",
        curses.KEY_RESIZE: "RESIZE", curses.KEY_F10: "F10",
    }

    def key(self) -> str:
        """The next key, by name. Printable characters come back as themselves."""
        while True:
            try:
                pressed = self.screen.get_wch()
            except KeyboardInterrupt:
                pressed = curses.KEY_F10
            except curses.error:
                continue
            if isinstance(pressed, int):
                name = self.KEYS.get(pressed, "")
            elif pressed in ("\n", "\r"):
                name = "ENTER"
            elif pressed == "\x1b":
                # A key this terminal's entry does not describe still arrives
                # as Esc followed by the rest of its sequence. Swallow the lot
                # rather than read it as Back.
                name = "" if self._drain() else "ESC"
            elif pressed == "\t":
                name = "TAB"
            elif pressed in ("\x7f", "\x08"):
                name = "BACKSPACE"
            elif pressed == "\x03":
                name = "F10"
            elif pressed.isprintable():
                name = pressed
            else:
                name = ""
            if not name:
                continue
            if name == "F10":
                if not self.postpone_allowed or self._postponing:
                    continue
                self._postponing = True
                try:
                    if self.confirm("Postpone setup?", POSTPONE_TEXT, yes="Postpone",
                                    no="Keep going", default_yes=False, back=False):
                        raise Cancelled()
                finally:
                    self._postponing = False
                return "RESIZE"
            return name

    def _drain(self) -> bool:
        """Discard whatever input is already waiting. Returns whether there was any."""
        self.screen.nodelay(True)
        found = False
        try:
            while True:
                try:
                    self.screen.get_wch()
                except curses.error:
                    break
                found = True
        finally:
            self.screen.nodelay(False)
        return found

    # -- widgets ------------------------------------------------------------

    def dialog(self, title: str, text: str, buttons, *, default: int = 0, back: bool = True,
               tone: str = "text") -> int:
        """A message with buttons. Returns the index of the button chosen."""
        focus = default
        hints = [("enter", "choose")] + ([("esc", "back")] if back else [])
        if len(buttons) > 1:
            hints.insert(0, (self.g("turn"), "switch"))
        while True:
            top, left, height, width = self.frame(title, "", hints)
            lines = self.wrap(text, width)[: max(height - 2, 1)]
            for offset, line in enumerate(lines):
                self.put(top + offset, left, line, self.c(tone))
            self._buttons(min(top + len(lines) + 1, top + height), left, buttons, focus)
            self.screen.refresh()
            pressed = self.key()
            if pressed in ("LEFT", "UP", "BTAB"):
                focus = max(focus - 1, 0)
            elif pressed in ("RIGHT", "DOWN", "TAB"):
                focus = min(focus + 1, len(buttons) - 1)
            elif pressed == "ENTER":
                return focus
            elif pressed == "ESC" and back:
                raise Back()

    def confirm(self, title: str, text: str, *, yes: str = "Yes", no: str = "No",
                default_yes: bool = True, back: bool = True) -> bool:
        return self.dialog(title, text, [yes, no], default=0 if default_yes else 1, back=back) == 0

    def message(self, title: str, text: str, *, button: str = "Continue", back: bool = False,
                tone: str = "text") -> None:
        self.dialog(title, text, [button], back=back, tone=tone)

    def busy(self, title: str, text: str) -> None:
        """A screen with nothing to answer, for work happening right now."""
        top, left, _, width = self.frame(title, "", ())
        for offset, line in enumerate(self.wrap(text, width)):
            self.put(top + offset, left, line, self.c("text"))
        self.screen.refresh()

    def menu(self, title: str, text: str, entries, *, default=None, search: bool = False,
             back: bool = True):
        """Pick one of (tag, label, detail). With search, typing filters the list."""
        query = ""
        tags = [entry[0] for entry in entries]
        index = tags.index(default) if default in tags else 0
        offset = 0
        hints = [(self.g("keys"), "move"), ("enter", "choose")]
        if search:
            hints.append(("type", "to search"))
        if back:
            hints.append(("esc", "back"))
        label_width = min(max((len(entry[1]) for entry in entries), default=10) + 2, 34)
        # Matched against tag, label and detail at once, with the underscores
        # zone names use read as spaces, so "new york" finds America/New_York.
        haystacks = [" ".join(map(str, entry)).lower() for entry in entries]
        haystacks = [f"{text} {text.replace('_', ' ')}" for text in haystacks]
        while True:
            needle = query.lower()
            shown = [entry for entry, text in zip(entries, haystacks) if needle in text]
            index = max(0, min(index, len(shown) - 1))
            top, left, height, width = self.frame(title, text, hints)
            y = top
            if search:
                self.put(y, left, "Search", self.c("muted"))
                field = min(width - 8, 36)
                self.put(y, left + 8, " " * field, self.c("field"))
                self.put(y, left + 8, query[-(field - 1):], self.c("field"))
                y += 2
            rows = max(top + height - y, 1)
            if index < offset:
                offset = index
            elif index >= offset + rows:
                offset = index - rows + 1
            offset = max(0, min(offset, max(len(shown) - rows, 0)))
            for row, entry in enumerate(shown[offset: offset + rows]):
                focused = offset + row == index
                base = self.c("focus") if focused else self.c("text")
                if focused:
                    self.put(y + row, left - 1, " " * (width + 1), base)
                    self.block(y + row, left - 1, 1, "bar_accent")
                self.put(y + row, left + 1, entry[1], base | (curses.A_BOLD if focused else 0), label_width - 1)
                detail = entry[2] if len(entry) > 2 else ""
                if detail:
                    self.put(y + row, left + 1 + label_width, detail,
                             self.c("focus_muted") if focused else self.c("muted"), width - label_width - 2)
            if offset > 0:
                self.put(y, left + width - 3, self.g("more"), self.c("muted"))
            if offset + rows < len(shown):
                self.put(y + rows - 1, left + width - 3, self.g("more"), self.c("muted"))
            if not shown:
                self.put(y, left + 1, f"Nothing matches '{query}'.", self.c("muted"))
            self.screen.refresh()
            pressed = self.key()
            if pressed == "UP":
                index -= 1
            elif pressed == "DOWN":
                index += 1
            elif pressed == "PGUP":
                index -= rows
            elif pressed == "PGDN":
                index += rows
            elif pressed == "HOME":
                index = 0
            elif pressed == "END":
                index = len(shown) - 1
            elif pressed == "ENTER" and shown:
                return shown[index][0]
            elif pressed == "ESC":
                if query:
                    query = ""
                elif back:
                    raise Back()
            elif pressed == "BACKSPACE" and search:
                query = query[:-1]
                index = 0
            elif len(pressed) == 1 and search:
                query += pressed
                index = 0
            elif len(pressed) == 1:
                for position, entry in enumerate(shown):
                    if entry[1][:1].lower() == pressed.lower():
                        index = position
                        break

    def form(self, title: str, text: str, fields, *, validate=None, derive=None,
             back: bool = True, back_label: str = "back", submit: str = "Continue") -> dict:
        """Lines of text to fill in.

        validate returns None, or (key, problem, *keys to clear), which puts
        the problem under that field and empties the others named, so a
        mismatched password pair is typed again from scratch.
        """
        values = {field.key: field.value for field in fields}
        focus = 0
        problem = None
        hints = [("tab", "next"), ("enter", "continue")] + ([("esc", back_label)] if back else [])
        label_width = max(len(field.label) for field in fields) + 3
        try:
            while True:
                top, left, height, width = self.frame(title, text, hints)
                box = max(min(width - label_width, 40), 12)
                y = top
                cursor = None
                for index, field in enumerate(fields):
                    focused = index == focus
                    self.put(y, left, field.label, self.c("text") if focused else self.c("muted"))
                    value = values[field.key]
                    shown = "*" * len(value) if field.secret else value
                    shown = shown[-(box - 1):]
                    role = "focus" if focused else "field"
                    self.put(y, left + label_width, " " * box, self.c(role))
                    self.put(y, left + label_width, shown, self.c(role))
                    if focused:
                        cursor = (y, left + label_width + len(shown))
                    if problem and problem[0] == field.key:
                        note, role = problem[1], "accent"
                    else:
                        note, role = field.hint, "muted"
                    lines = self.wrap(note, width - label_width)[:2] if note else []
                    for offset, line in enumerate(lines):
                        self.put(y + 1 + offset, left + label_width, line, self.c(role))
                    y += 2 + max(len(lines), 1)
                self._buttons(y, left + label_width, [submit], 0 if focus == len(fields) else -1)
                if cursor:
                    self._cursor(True)
                    self.screen.move(*cursor)
                else:
                    self._cursor(False)
                self.screen.refresh()
                pressed = self.key()
                if pressed in ("TAB", "DOWN"):
                    focus = min(focus + 1, len(fields))
                elif pressed in ("BTAB", "UP"):
                    focus = max(focus - 1, 0)
                elif pressed == "ENTER":
                    if focus < len(fields) - 1:
                        focus += 1
                        continue
                    problem = validate(values) if validate else None
                    if problem:
                        keys = [field.key for field in fields]
                        focus = keys.index(problem[0]) if problem[0] in keys else 0
                        for key in problem[2:] if len(problem) > 2 else ():
                            values[key] = ""
                        continue
                    return values
                elif pressed == "ESC":
                    if back:
                        raise Back()
                elif focus < len(fields):
                    field = fields[focus]
                    if pressed == "BACKSPACE":
                        values[field.key] = values[field.key][:-1]
                    elif len(pressed) == 1 and len(values[field.key]) < field.limit:
                        values[field.key] += pressed
                    else:
                        continue
                    if problem and problem[0] == field.key:
                        problem = None
                    if derive:
                        derive(values, field.key)
        finally:
            self._cursor(False)

    def settings(self, title: str, text: str, rows, *, preface=(), validate=None,
                 back: bool = True, submit: str = "Continue") -> dict:
        """A list of settings, each changed in place. Enter accepts them all."""
        values = {row.key: row.value for row in rows}
        focus = 0
        problem = None
        hints = [(self.g("keys"), "move"), (self.g("turn"), "change"), ("enter", "continue")]
        if back:
            hints.append(("esc", "back"))
        label_width = max(len(row.label) for row in rows) + 4
        try:
            while True:
                top, left, height, width = self.frame(title, text, hints)
                y = top
                for line, role in preface:
                    for wrapped in self.wrap(line, width):
                        self.put(y, left, wrapped, self.c(role))
                        y += 1
                if preface:
                    y += 1
                cursor = None
                for index, row in enumerate(rows):
                    focused = index == focus
                    if focused:
                        self.put(y, left - 1, " " * (width + 1), self.c("focus"))
                        self.block(y, left - 1, 1, "bar_accent")
                    if not row.enabled:
                        label_role = "focus_muted" if focused else "muted"
                    else:
                        label_role = "focus" if focused else "text"
                    self.put(y, left + 1, row.label, self.c(label_role))
                    value = values[row.key]
                    # Choices are drawn as "< value >" when focused, so every
                    # value starts two columns in and text rows line up with them.
                    x = left + label_width
                    if row.text:
                        x += 2
                        shown = value[-(width - label_width - 2):] if value else ""
                        if not value and not focused:
                            self.put(y, x, row.placeholder, self.c("muted"))
                        else:
                            self.put(y, x, shown, self.c("focus" if focused else "text"))
                        if focused:
                            cursor = (y, x + len(shown))
                    else:
                        shown = row.shown(value)
                        if focused and row.enabled:
                            self.put(y, x, f"< {shown} >", self.c("focus") | curses.A_BOLD)
                        else:
                            role = ("focus_muted" if focused else "muted") if not row.enabled else (
                                "focus" if focused else "text")
                            self.put(y, x, f"  {shown}", self.c(role))
                    y += 1
                y += 1
                described, warn = rows[focus].describe(values)
                if problem:
                    described, warn = problem[1], True
                limit = top + height - 2
                for line in self.wrap(described, width):
                    if y >= limit:
                        break
                    self.put(y, left, line, self.c("accent" if warn else "muted"))
                    y += 1
                # Enter accepts from any row, so the button always looks pressed-ready.
                self._buttons(top + height - 1, left, [submit], 0)
                if cursor:
                    self._cursor(True)
                    self.screen.move(*cursor)
                else:
                    self._cursor(False)
                self.screen.refresh()
                pressed = self.key()
                row = rows[focus]
                if pressed in ("UP", "BTAB"):
                    focus = (focus - 1) % len(rows)
                elif pressed in ("DOWN", "TAB"):
                    focus = (focus + 1) % len(rows)
                elif pressed == "ENTER":
                    problem = validate(values) if validate else None
                    if problem:
                        keys = [r.key for r in rows]
                        focus = keys.index(problem[0]) if problem[0] in keys else focus
                        continue
                    return values
                elif pressed == "ESC":
                    if back:
                        raise Back()
                elif row.text:
                    if pressed == "BACKSPACE":
                        values[row.key] = values[row.key][:-1]
                    elif len(pressed) == 1 and len(values[row.key]) < row.limit:
                        values[row.key] += pressed
                    problem = None
                elif row.enabled and pressed in ("LEFT", "RIGHT", " "):
                    options = [choice for choice, _ in row.choices]
                    current = options.index(values[row.key]) if values[row.key] in options else 0
                    step = -1 if pressed == "LEFT" else 1
                    values[row.key] = options[(current + step) % len(options)]
                    problem = None
        finally:
            self._cursor(False)

    def review(self, title: str, text: str, groups, *, submit: str = "Apply settings"):
        """Everything chosen, by section. Returns a section key to edit, or None to apply."""
        focus = len(groups)
        offset = 0
        hints = [(self.g("keys"), "move"), ("enter", "edit or apply"), ("esc", "back")]
        heading_width = max(len(heading) for _, heading, _ in groups) + 3
        while True:
            top, left, height, width = self.frame(title, text, hints)
            lines: list[tuple[int, str, str]] = []
            for index, (_, heading, summary) in enumerate(groups):
                wrapped = self.wrap(summary, width - heading_width - 1)[:4]
                lines.append((index, heading, wrapped[0]))
                lines += [(index, "", extra) for extra in wrapped[1:]]
            rows = height - 2
            first = next((n for n, line in enumerate(lines) if line[0] == focus), None)
            if first is not None:
                last = max(n for n, line in enumerate(lines) if line[0] == focus)
                if first < offset:
                    offset = first
                elif last >= offset + rows:
                    offset = last - rows + 1
            else:
                offset = max(len(lines) - rows, 0)
            for row, (index, heading, summary) in enumerate(lines[offset: offset + rows]):
                y = top + row
                focused = index == focus
                if focused:
                    self.put(y, left - 1, " " * (width + 1), self.c("focus"))
                    if heading:
                        self.block(y, left - 1, 1, "bar_accent")
                self.put(y, left + 1, heading, self.c("focus" if focused else "muted"))
                self.put(y, left + heading_width, summary, self.c("focus" if focused else "text"),
                         width - heading_width)
            if offset > 0:
                self.put(top, left + width - 3, self.g("more"), self.c("muted"))
            if offset + rows < len(lines):
                self.put(top + rows - 1, left + width - 3, self.g("more"), self.c("muted"))
            self._buttons(top + height - 1, left, [submit], 0 if focus == len(groups) else -1)
            self.screen.refresh()
            pressed = self.key()
            if pressed in ("UP", "BTAB"):
                focus = max(focus - 1, 0)
            elif pressed in ("DOWN", "TAB"):
                focus = min(focus + 1, len(groups))
            elif pressed == "HOME":
                focus = 0
            elif pressed == "END":
                focus = len(groups)
            elif pressed == "ENTER":
                return None if focus == len(groups) else groups[focus][0]
            elif pressed == "ESC":
                raise Back()


class Progress:
    """The apply screen: every task in order, with what is happening now."""

    def __init__(self, screen: UI, title: str, text: str, labels) -> None:
        self.ui, self.title, self.text = screen, title, text
        self.labels = list(labels)
        self.states = ["todo"] * len(self.labels)
        self.details = [""] * len(self.labels)
        self.fraction: float | None = None
        self.current = -1
        self.tick = 0

    def start(self, index: int) -> None:
        self.current, self.fraction = index, None
        self.states[index] = "run"
        self.draw()

    def finish(self, index: int, state: str = "done", detail: str = "") -> None:
        self.states[index], self.details[index] = state, detail
        self.fraction = None
        self.draw()

    def note(self, detail: str, fraction: float | None = None) -> None:
        if 0 <= self.current < len(self.labels):
            self.details[self.current] = detail
        if fraction is not None:
            self.fraction = max(0.0, min(fraction, 1.0))
        self.tick += 1
        self.draw()

    def draw(self) -> None:
        screen = self.ui
        if screen.screen is None:
            return
        top, left, height, width = screen.frame(self.title, self.text, ())
        first = max(0, min(self.current - height // 2, len(self.labels) - height + 2))
        y = top
        for index in range(first, len(self.labels)):
            if y >= top + height:
                break
            state = self.states[index]
            if state == "done":
                mark, mark_role, role = screen.g("done"), "muted", "text"
            elif state == "run":
                mark, mark_role, role = SPINNER[self.tick % len(SPINNER)], "accent", "text"
            elif state == "fail":
                mark, mark_role, role = screen.g("fail"), "accent", "text"
            elif state == "skip":
                mark, mark_role, role = screen.g("todo"), "muted", "muted"
            else:
                mark, mark_role, role = screen.g("todo"), "muted", "muted"
            screen.put(y, left, mark, screen.c(mark_role))
            screen.put(y, left + 2, self.labels[index],
                       screen.c(role) | (curses.A_BOLD if state == "run" else 0))
            y += 1
            detail = self.details[index]
            if state == "run" and (detail or self.fraction is not None):
                if self.fraction is not None:
                    bar = max(min(width - 12, 40), 10)
                    filled = int(bar * self.fraction)
                    screen.block(y, left + 2, filled, "bar_accent")
                    screen.put(y, left + 2 + filled, screen.g("empty") * (bar - filled), screen.c("muted"))
                    screen.put(y, left + 3 + bar, f"{int(self.fraction * 100):3d}%", screen.c("muted"))
                    y += 1
                if detail:
                    screen.put(y, left + 2, detail, screen.c("muted"), width - 2)
                    y += 1
            elif state == "fail" and detail:
                screen.put(y, left + 2, detail, screen.c("accent"), width - 2)
                y += 1
        screen.screen.refresh()


