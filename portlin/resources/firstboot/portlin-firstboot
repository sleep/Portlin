class Cancelled(Exception):
    """The user pressed Cancel or Esc."""


def claim_console(quiet: bool) -> None:
    """Take sole possession of tty1, or hand it back.

    Three separate things write to this terminal during boot and each needs its
    own silencer: the kernel's printk stream, systemd's service status lines, and
    plymouth's splash. Left alone they scribble straight through the wizard's
    dialogs, which looks like a crash rather than a prompt.

    Everything here is best-effort and reversible. Failing to quiet the console
    is a cosmetic problem; failing to restore it would leave the machine
    permanently unable to report anything at boot, which is much worse.
    """
    def attempt(argv: list[str]) -> None:
        """Run a console-wrangling command, and never let it block the wizard.

        Every one of these talks to something that may already be gone, and a
        plymouth command with no daemon to answer it blocks indefinitely --
        hanging the wizard before it draws anything, which presents as a machine
        that simply never finishes booting. None of them matters enough to wait
        on.
        """
        try:
            subprocess.run(argv, capture_output=True, timeout=5)
        except (subprocess.TimeoutExpired, OSError) as exc:
            log(f"console setup: {' '.join(argv)} did not complete ({exc})")

    if quiet:
        # "deactivate", not "quit". Quitting kills the daemon that
        # plymouth-quit-wait is blocking on, deadlocking the boot; deactivating
        # just makes plymouth let go of the terminal, which is all that is
        # actually needed here.
        attempt(["plymouth", "deactivate"])
        # Put tty1 in front of the user. The unit does this too, but a wizard
        # drawing to a console nobody is looking at is the single worst failure
        # mode here -- it looks exactly like a hung boot -- so it is worth
        # asserting from both sides.
        attempt(["chvt", "1"])
    attempt(["setterm", "--msg", "off" if quiet else "on"])
    try:
        # SIGRTMIN+21 disables systemd's console status output, +20 re-enables it.
        os.kill(1, signal.SIGRTMIN + (21 if quiet else 20))
    except (OSError, AttributeError, ValueError):
        log("could not toggle systemd console status")


def log(message: str) -> None:
    try:
        with LOG.open("a") as handle:
            handle.write(message.rstrip() + "\n")
    except OSError:
        pass


def run(argv: list[str], *, check: bool = True, stdin: str | None = None) -> subprocess.CompletedProcess:
    log(f"run: {' '.join(argv)}")
    proc = subprocess.run(argv, input=stdin, capture_output=True, text=True)
    if proc.stderr.strip():
        log(f"  stderr: {proc.stderr.strip()}")
    if check and proc.returncode != 0:
        raise RuntimeError(f"command failed ({proc.returncode}): {' '.join(argv)}\n{proc.stderr}")
    return proc


# --------------------------------------------------------------------------
# whiptail wrappers
# --------------------------------------------------------------------------

def _whiptail(args: list[str], *, capture: bool = False) -> str:
    """Invoke whiptail. Selections come back on stderr, which is whiptail's convention."""
    argv = ["whiptail", "--backtitle", BACKTITLE, *args]
    proc = subprocess.run(argv, stderr=subprocess.PIPE, text=True)
    if proc.returncode == 255:
        raise Cancelled()
    if proc.returncode != 0 and capture:
        raise Cancelled()
    return (proc.stderr or "").strip()


def _box_height(text: str, minimum: int = 12) -> int:
    """Height needed to show ``text`` in full.

    whiptail silently clips whatever does not fit rather than scrolling or
    complaining, so a fixed height quietly swallows the end of any longer
    message. The summary screen lost both its last row and the question the
    buttons were answering, which is a bad thing not to notice.
    """
    lines = text.count("\n") + 1
    return max(minimum, min(lines + 8, 22))


def message(title: str, text: str) -> None:
    _whiptail(["--title", title, "--msgbox", text, str(_box_height(text, 16)), "72"])


def info(title: str, text: str) -> None:
    """A dialog with no button, for work happening right now.

    msgbox would block on Ok and then do the work with the screen already
    dismissed, leaving the user staring at nothing while the disk is resized.
    """
    _whiptail(["--title", title, "--infobox", text, str(_box_height(text)), "72"])


def ask(title: str, text: str, default: str = "") -> str:
    return _whiptail(
        ["--title", title, "--inputbox", text, "12", "72", default],
        capture=True,
    )


def ask_password(title: str, text: str) -> str:
    return _whiptail(["--title", title, "--passwordbox", text, "12", "72"], capture=True)


def choose(title: str, text: str, entries: list[tuple[str, str]], height: int = 20) -> str:
    rows: list[str] = []
    for tag, label in entries:
        rows += [tag, label]
    listsize = min(len(entries), max(height - 8, 4))
    return _whiptail(
        ["--title", title, "--menu", text, str(height), "72", str(listsize), *rows],
        capture=True,
    )


def confirm(title: str, text: str, *, default_yes: bool = True) -> bool:
    args = ["--title", title, "--yesno", text, str(_box_height(text)), "72"]
    if not default_yes:
        args.insert(0, "--defaultno")
    argv = ["whiptail", "--backtitle", BACKTITLE, *args]
    return subprocess.run(argv).returncode == 0


